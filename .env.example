# Copy to .env (ignored by Git); use generated values, never commit actual secrets.
# Generate a URL-safe password: openssl rand -hex 32
POSTGRES_PASSWORD=replace_with_64_hex_characters
# Separate limited runtime DB credential; also generate with openssl rand -hex 32
AIGC_APP_DB_PASSWORD=replace_with_a_different_64_hex_secret
# Generate a separate API token: openssl rand -hex 32
AIGC_API_BEARER_TOKEN=replace_with_64_hex_characters
AIGC_HOST_PORT=8080
