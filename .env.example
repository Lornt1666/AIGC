# Local development only. bootstrap.sh replaces these sample values with random secrets on first run.
POSTGRES_DB=aigc
POSTGRES_USER=aigc
POSTGRES_PASSWORD=replace-this-local-password
AIGC_COMMAND_CENTER_TOKEN=replace-this-local-operator-token
AIGC_PORT=8000
AIGC_MAX_CONCURRENT_RUNS=1
AIGC_STEP_TIMEOUT_SECONDS=120
