ARG PYTHON_BASE_IMAGE=python:3.12.13-slim-bookworm@sha256:4766d8b510c428e595d74b9cc5bbb2fae8e26316fffb4adc89908d79aacd58a2
FROM ${PYTHON_BASE_IMAGE}

ARG RELEASE_SHA=unverified-local-build
ARG SOURCE_CONTEXT_SHA256=unverified-local-build

LABEL org.opencontainers.image.source="https://github.com/Lornt1666/AIGC" \
      org.opencontainers.image.revision="${RELEASE_SHA}" \
      ai.aigc.source-context-sha256="${SOURCE_CONTEXT_SHA256}"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PORT=8080

WORKDIR /app

RUN groupadd --system aigc && useradd --system --gid aigc --home-dir /app aigc

COPY requirements.lock /app/requirements.lock
RUN python -m pip install --no-cache-dir --require-hashes -r /app/requirements.lock && \
    python -m pip check

COPY src /app/src
COPY migrations/003_nexus_provider_runtime_controls.sql /app/migrations/003_nexus_provider_runtime_controls.sql
COPY migrations/004_nexus_persisted_authority.sql /app/migrations/004_nexus_persisted_authority.sql

RUN chown -R aigc:aigc /app
USER aigc

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD python -c "import os,urllib.request; urllib.request.urlopen('http://127.0.0.1:'+os.environ.get('PORT','8080')+'/health', timeout=2).read()"

CMD ["sh", "-c", "uvicorn src.webapp.nexus_runtime_api:app --host 0.0.0.0 --port ${PORT}"]
