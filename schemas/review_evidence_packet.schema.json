{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aigc.local/schemas/review_evidence_packet.schema.json",
  "title": "AIGC Review Evidence Packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "packet_id",
    "schema_version",
    "evidence_subject",
    "quest_id",
    "quest_revision",
    "handoff_id",
    "handoff_revision",
    "reviewer_agent_id",
    "subject_agent_id",
    "verdict",
    "findings",
    "acceptance_criteria_results",
    "evidence_ids",
    "packet_digest",
    "created_at",
    "exact_revision",
    "authority_class",
    "operator_review_required",
    "external_action_performed"
  ],
  "properties": {
    "packet_id": {
      "type": "string",
      "pattern": "^review_[a-f0-9]{24}$"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "evidence_subject": {
      "const": "INTERNAL_HANDOFF_REVIEW"
    },
    "quest_id": {
      "type": "string",
      "pattern": "^quest_[A-Za-z0-9._:-]+$"
    },
    "quest_revision": {
      "type": "integer",
      "minimum": 1
    },
    "handoff_id": {
      "type": "string",
      "pattern": "^handoff_[a-f0-9]{24}$"
    },
    "handoff_revision": {
      "type": "integer",
      "minimum": 1
    },
    "reviewer_agent_id": {
      "type": "string",
      "pattern": "^AIGC-AGENT-[A-Z0-9-]+$"
    },
    "subject_agent_id": {
      "type": "string",
      "pattern": "^AIGC-AGENT-[A-Z0-9-]+$"
    },
    "verdict": {
      "enum": [
        "PASS",
        "REWORK_REQUIRED",
        "BLOCKED"
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "acceptance_criteria_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/criterion_result"
      }
    },
    "evidence_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      }
    },
    "packet_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "exact_revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "authority_class": {
      "const": "ACCOUNTABLE_OPERATOR"
    },
    "operator_review_required": {
      "const": true
    },
    "external_action_performed": {
      "const": false
    }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finding_id",
        "severity",
        "code",
        "message",
        "evidence_ids"
      ],
      "properties": {
        "finding_id": {
          "type": "string",
          "pattern": "^finding_[a-f0-9]{16}$"
        },
        "severity": {
          "enum": [
            "ADVISORY",
            "BLOCKING"
          ]
        },
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "evidence_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        }
      }
    },
    "criterion_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "criterion",
        "status",
        "evidence_ids"
      ],
      "properties": {
        "criterion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "status": {
          "enum": [
            "PASS",
            "FAIL",
            "NOT_EVALUATED"
          ]
        },
        "evidence_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        }
      }
    }
  }
}
