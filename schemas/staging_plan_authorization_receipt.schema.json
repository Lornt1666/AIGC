{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://aigc.local/schemas/staging_plan_authorization_receipt.schema.json","title":"AIGC Staging Plan Authorization Receipt v1","type":"object","additionalProperties":false,"required":["contract_id","contract_version","receipt_id","decision","exact_revision","procurement_pack_digest","issued_at","expires_at","project_reference","allowed_actions","single_use","mutation_authorized","terraform_apply_authorized","operator_review_required","automatic_apply_allowed","provider_action_performed","external_action_performed"],"properties":{"contract_id":{"const":"AIGC-STAGING-PLAN-AUTHORIZATION-RECEIPT-001"},"contract_version":{"const":"1.0.0"},"receipt_id":{"type":"string","pattern":"^SPA-[A-Z0-9][A-Z0-9:-]{7,199}$"},"decision":{"enum":["APPROVED","DENIED"]},"exact_revision":{"type":"string","pattern":"^[a-f0-9]{40}$"},"procurement_pack_digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},"issued_at":{"type":"string","format":"date-time"},"expires_at":{"type":"string","format":"date-time"},"project_reference":{"type":"string","pattern":"^gcp_project://[a-z][a-z0-9-]{4,28}[a-z0-9]$"},"allowed_actions":{"type":"array","uniqueItems":true,"items":{"enum":["READ_PROJECT_METADATA","VALIDATE_REQUIRED_APIS","VALIDATE_EXISTING_RESOURCES","GENERATE_TERRAFORM_PLAN","CALCULATE_TARGET_DIGEST","CALCULATE_PLAN_DIGEST"]}},"single_use":{"const":true},"mutation_authorized":{"const":false},"terraform_apply_authorized":{"const":false},"operator_review_required":{"const":true},"automatic_apply_allowed":{"const":false},"provider_action_performed":{"const":false},"external_action_performed":{"const":false}}}