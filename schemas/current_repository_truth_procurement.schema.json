{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aigc.local/schemas/current_repository_truth_procurement.schema.json",
  "title": "AIGC Current Repository Truth Procurement",
  "type": "object",
  "required": [
    "contract_id",
    "contract_version",
    "observed_at",
    "repository",
    "canonical_sequence",
    "transition_targets",
    "safety_invariants",
    "decision_lineage",
    "procurement_policy",
    "current_summary"
  ],
  "properties": {
    "contract_id": {"type": "string"},
    "contract_version": {"type": "string"},
    "observed_at": {"type": "string"},
    "repository": {
      "type": "object",
      "required": ["full_name", "branch", "pull_request", "head_sha"],
      "properties": {
        "full_name": {"type": "string"},
        "branch": {"type": "string"},
        "pull_request": {"type": "integer"},
        "head_sha": {"type": "string"}
      }
    },
    "canonical_sequence": {
      "type": "object",
      "required": ["path", "contract_id", "binding_mode"],
      "properties": {
        "path": {"type": "string"},
        "contract_id": {"type": "string"},
        "binding_mode": {"enum": ["exact_branch_revision", "rebind_after_main_movement"]}
      }
    },
    "transition_targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "truth_id",
          "order",
          "label",
          "current_value",
          "desired_value",
          "classification",
          "status",
          "accountable_actor",
          "dependencies",
          "required_actions",
          "required_evidence",
          "stop_conditions",
          "external_mutation_required",
          "operator_review_required"
        ],
        "properties": {
          "truth_id": {"type": "string"},
          "order": {"type": "integer"},
          "label": {"type": "string"},
          "current_value": {"type": "boolean"},
          "desired_value": {"enum": [true]},
          "classification": {
            "enum": [
              "account_external_blocker",
              "evidence_transition",
              "repository_admission",
              "internal_implementation",
              "authorized_cloud_transition",
              "operational_canary",
              "approved_connector_transition"
            ]
          },
          "status": {"enum": ["blocked", "planned", "ready", "completed"]},
          "accountable_actor": {"type": "string"},
          "dependencies": {"type": "array", "items": {"type": "string"}},
          "required_actions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "required_evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "stop_conditions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "external_mutation_required": {"type": "boolean"},
          "operator_review_required": {"type": "boolean"},
          "references": {"type": "object"}
        }
      }
    },
    "safety_invariants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "truth_id",
          "label",
          "current_value",
          "required_value",
          "rationale",
          "enforcement_tests"
        ],
        "properties": {
          "truth_id": {"type": "string"},
          "label": {"type": "string"},
          "current_value": {"enum": [false]},
          "required_value": {"enum": [false]},
          "rationale": {"type": "string"},
          "enforcement_tests": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        }
      }
    },
    "decision_lineage": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["decision_id", "decision", "effect"],
        "properties": {
          "decision_id": {"type": "string"},
          "decision": {"type": "string"},
          "effect": {"type": "string"},
          "references": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "procurement_policy": {
      "type": "object",
      "required": [
        "false_is_not_automatically_a_defect",
        "completion_requires_evidence",
        "authority_does_not_substitute_for_evidence",
        "first_incomplete_transition_is_next",
        "no_direct_main_write",
        "no_new_product_train"
      ],
      "properties": {
        "false_is_not_automatically_a_defect": {"enum": [true]},
        "completion_requires_evidence": {"enum": [true]},
        "authority_does_not_substitute_for_evidence": {"enum": [true]},
        "first_incomplete_transition_is_next": {"enum": [true]},
        "no_direct_main_write": {"enum": [true]},
        "no_new_product_train": {"enum": [true]}
      }
    },
    "current_summary": {
      "type": "object",
      "required": [
        "transition_target_count",
        "completed_transition_count",
        "safety_invariant_count",
        "next_transition_id",
        "external_action_performed"
      ],
      "properties": {
        "transition_target_count": {"type": "integer"},
        "completed_transition_count": {"type": "integer"},
        "safety_invariant_count": {"type": "integer"},
        "next_transition_id": {"type": "string"},
        "external_action_performed": {"enum": [false]}
      }
    }
  }
}
