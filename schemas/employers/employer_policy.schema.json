{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aigc.regenexcalibur.invalid/schemas/employers/employer_policy.schema.json",
  "title": "AIGC EmployerPolicy canonical record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "policy_id",
    "employer_id",
    "vault_id",
    "engagement_id",
    "allowed_jurisdictions",
    "prohibited_jurisdictions",
    "cross_border_allowed",
    "allowed_providers",
    "prohibited_providers",
    "allowed_models",
    "prohibited_models",
    "allowed_tools",
    "prohibited_tools",
    "external_api_allowed",
    "open_source_allowed",
    "confidentiality_class",
    "external_training_use_allowed",
    "allowed_data_scopes",
    "cross_employer_retrieval_allowed",
    "cross_employer_prompt_context_allowed",
    "retention_days",
    "deletion_required_after_retention",
    "review_required_for_external_effects",
    "review_required_for_restricted_work",
    "licensed_review_required_when_legally_restricted",
    "minimum_security_level",
    "minimum_privacy_level",
    "independent_verification_required",
    "evidence_required",
    "maximum_cost_cad",
    "maximum_token_budget",
    "maximum_compute_seconds",
    "maximum_task_duration_seconds"
  ],
  "properties": {
    "policy_id": {"type": "string", "minLength": 1},
    "employer_id": {"type": "string", "minLength": 1},
    "vault_id": {"type": "string", "minLength": 1},
    "engagement_id": {"type": "string", "minLength": 1},
    "allowed_jurisdictions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "prohibited_jurisdictions": {"type": "array", "minItems": 0, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "cross_border_allowed": {"type": "boolean"},
    "allowed_providers": {"type": "array", "minItems": 0, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "prohibited_providers": {"type": "array", "minItems": 0, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "allowed_models": {"type": "array", "minItems": 0, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "prohibited_models": {"type": "array", "minItems": 0, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "allowed_tools": {"type": "array", "minItems": 0, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "prohibited_tools": {"type": "array", "minItems": 0, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "external_api_allowed": {"type": "boolean"},
    "open_source_allowed": {"type": "boolean"},
    "confidentiality_class": {"enum": ["PUBLIC", "INTERNAL", "CONFIDENTIAL", "RESTRICTED"]},
    "external_training_use_allowed": {"type": "boolean"},
    "allowed_data_scopes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/vaultDataScope"}},
    "cross_employer_retrieval_allowed": {"const": false},
    "cross_employer_prompt_context_allowed": {"const": false},
    "retention_days": {"type": "integer", "minimum": 0},
    "deletion_required_after_retention": {"type": "boolean"},
    "review_required_for_external_effects": {"type": "boolean"},
    "review_required_for_restricted_work": {"type": "boolean"},
    "licensed_review_required_when_legally_restricted": {"type": "boolean"},
    "minimum_security_level": {"type": "integer", "minimum": 0, "maximum": 3},
    "minimum_privacy_level": {"type": "integer", "minimum": 0, "maximum": 3},
    "independent_verification_required": {"type": "boolean"},
    "evidence_required": {"type": "boolean"},
    "maximum_cost_cad": {"type": "number", "minimum": 0},
    "maximum_token_budget": {"type": "integer", "minimum": 0},
    "maximum_compute_seconds": {"type": "integer", "minimum": 0},
    "maximum_task_duration_seconds": {"type": "integer", "minimum": 1}
  },
  "$defs": {
    "vaultDataScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope_id", "vault_id", "employer_id", "classification", "purpose"],
      "properties": {
        "scope_id": {"type": "string", "minLength": 1},
        "vault_id": {"type": "string", "minLength": 1},
        "employer_id": {"type": "string", "minLength": 1},
        "classification": {"enum": ["PUBLIC", "INTERNAL", "CONFIDENTIAL", "RESTRICTED"]},
        "purpose": {"type": "string", "minLength": 1}
      }
    }
  }
}
