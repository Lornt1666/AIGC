{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aigc.regenexcalibur.invalid/schemas/employers/employer_policy.schema.json",
  "title": "AIGC EmployerPolicy",
  "type": "object",
  "additionalProperties": false,
  "required": ["policy_id", "employer_id", "vault_id", "engagement_id", "allowed_jurisdictions", "prohibited_jurisdictions", "allowed_providers", "prohibited_providers", "allowed_models", "prohibited_models", "allowed_tools", "prohibited_tools", "confidentiality_class", "allowed_data_scopes", "maximum_cost_cad", "maximum_token_budget", "maximum_compute_seconds", "maximum_task_duration_seconds", "minimum_security_level", "minimum_privacy_level", "independent_verification_required", "evidence_required"],
  "properties": {
    "policy_id": {"type": "string", "minLength": 1},
    "employer_id": {"type": "string", "minLength": 1},
    "vault_id": {"type": "string", "minLength": 1},
    "engagement_id": {"type": "string", "minLength": 1},
    "allowed_jurisdictions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "prohibited_jurisdictions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "allowed_providers": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "prohibited_providers": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "allowed_models": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "prohibited_models": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "allowed_tools": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "prohibited_tools": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "confidentiality_class": {"enum": ["PUBLIC", "INTERNAL", "CONFIDENTIAL", "RESTRICTED"]},
    "allowed_data_scopes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "maximum_cost_cad": {"type": "number", "minimum": 0},
    "maximum_token_budget": {"type": "integer", "minimum": 0},
    "maximum_compute_seconds": {"type": "integer", "minimum": 0},
    "maximum_task_duration_seconds": {"type": "integer", "minimum": 1},
    "minimum_security_level": {"type": "integer", "minimum": 0, "maximum": 3},
    "minimum_privacy_level": {"type": "integer", "minimum": 0, "maximum": 3},
    "independent_verification_required": {"type": "boolean"},
    "evidence_required": {"type": "boolean"}
  }
}
