{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://regenexcalibur.local/schemas/gmail_connector_activation.schema.json",
  "title": "Ω Mission OS Gmail Draft-Only Connector Activation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "account_fingerprint", "scope", "environment", "test_canary_verified", "send_capability_present", "emergency_stop_required", "operator_id", "expires_at"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "status": {"const": "ACTIVATED_DRAFT_ONLY"},
    "account_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "scope": {"const": "https://www.googleapis.com/auth/gmail.compose"},
    "environment": {"enum": ["TEST", "PRODUCTION"]},
    "test_canary_verified": {"type": "boolean"},
    "send_capability_present": {"const": false},
    "emergency_stop_required": {"const": true},
    "operator_id": {"type": "string", "minLength": 1},
    "expires_at": {"type": "string", "format": "date-time"},
    "revocation_procedure": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {
      "if": {"properties": {"environment": {"const": "PRODUCTION"}}, "required": ["environment"]},
      "then": {"properties": {"test_canary_verified": {"const": true}}}
    }
  ]
}
