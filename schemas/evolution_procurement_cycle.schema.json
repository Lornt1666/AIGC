{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aigc.local/schemas/evolution_procurement_cycle.schema.json",
  "title": "AIGC Evolution and Procurement Cycle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cycle_id",
    "created_at",
    "source_revision",
    "scope",
    "evidence_strength",
    "external_action_performed",
    "operator_review_required",
    "assessments",
    "prioritized_transformation_backlog",
    "procurement_register",
    "governance_summary",
    "next_run_directive"
  ],
  "properties": {
    "cycle_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_revision": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "scope": {
      "const": "AIGC only"
    },
    "evidence_strength": {
      "type": "string",
      "minLength": 1
    },
    "external_action_performed": {
      "const": false
    },
    "operator_review_required": {
      "const": true
    },
    "assessments": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ontology",
        "taxonomy",
        "methodology",
        "architecture",
        "production_readiness",
        "governance"
      ],
      "properties": {
        "ontology": {
          "$ref": "#/$defs/scoredAssessment"
        },
        "taxonomy": {
          "$ref": "#/$defs/scoredAssessment"
        },
        "methodology": {
          "$ref": "#/$defs/scoredAssessment"
        },
        "architecture": {
          "$ref": "#/$defs/scoredAssessment"
        },
        "production_readiness": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "baseline_score",
            "projected_score_if_cycle_pr_merges",
            "threshold",
            "production_ready",
            "blocking_gaps",
            "highest_priority_blocker",
            "evidence_model"
          ],
          "properties": {
            "baseline_score": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "projected_score_if_cycle_pr_merges": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "threshold": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "production_ready": {
              "const": false
            },
            "blocking_gaps": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "highest_priority_blocker": {
              "type": "string",
              "minLength": 1
            },
            "evidence_model": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "governance": {
          "$ref": "#/$defs/scoredAssessment"
        }
      }
    },
    "prioritized_transformation_backlog": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "procurement_register": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "governance_summary": {
      "type": "object"
    },
    "next_run_directive": {
      "type": "object"
    }
  },
  "$defs": {
    "scoredAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "score",
        "findings"
      ],
      "properties": {
        "status": {
          "type": "string",
          "minLength": 1
        },
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "findings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
