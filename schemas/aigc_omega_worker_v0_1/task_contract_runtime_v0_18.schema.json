{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "1jgm://aigc-omega-worker/v0.18/task-contract",
  "title": "AIGC TaskContract Runtime v0.18",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_id","objective","authorized_scope","resource_budget","permitted_actions","evidence_requirements","postconditions","termination_conditions","retry_max","rollback_enabled","rollback_compensating_action","escalation_policy","owner","policy_reference","expiration"],
  "properties": {
    "contract_id": {"type":"string","minLength":1},
    "objective": {"type":"string","minLength":1},
    "authorized_scope": {"type":"string","minLength":1},
    "resource_budget": {"type":"integer","exclusiveMinimum":0},
    "permitted_actions": {"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
    "evidence_requirements": {"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "postconditions": {"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "termination_conditions": {"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "retry_max": {"type":"integer","minimum":0},
    "rollback_enabled": {"type":"boolean"},
    "rollback_compensating_action": {"type":"string"},
    "escalation_policy": {"type":"string","minLength":1},
    "owner": {"type":"string","minLength":1},
    "policy_reference": {"type":"string","minLength":1},
    "expiration": {"type":"string","minLength":1}
  }
}
