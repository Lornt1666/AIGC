{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AIGC Customer Satisfaction Record",
  "type": "object",
  "required": [
    "record_id",
    "created_at",
    "opportunity_id",
    "phase",
    "chi_score",
    "scores",
    "external_action_performed"
  ],
  "properties": {
    "record_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "opportunity_id": {
      "type": "string"
    },
    "proposal_id": {
      "type": "string"
    },
    "fidelity_review_id": {
      "type": "string"
    },
    "phase": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "measurement_stage": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "employer": {
      "type": "string"
    },
    "source_platform": {
      "type": "string"
    },
    "source_url": {
      "type": "string"
    },
    "chi_score": {
      "type": "integer"
    },
    "scores": {
      "type": "object"
    },
    "confidence": {
      "type": "string"
    },
    "customer_expectation_profile": {
      "type": "object"
    },
    "risk_flags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "improvement_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "approval_required_before_external_action": {
      "type": "boolean"
    },
    "external_action_performed": {
      "type": "boolean"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
