{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://regenexcalibur.invalid/schemas/nexus_deployment_receipt_publication_permit.schema.json",
  "title": "AIGC Nexus Deployment Receipt One-Use Publication Permit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "permit_id",
    "nonce",
    "repository",
    "project_id",
    "project_number",
    "region",
    "resource_prefix",
    "release_sha",
    "release_tree_sha",
    "receipt_sha256",
    "receipt_content_sha256",
    "receipt_content_length",
    "receipt_bucket",
    "object_name",
    "content_type",
    "action_index",
    "action_name",
    "predecessor_action_name",
    "predecessor_action_permit_sha256",
    "maximum_mutations",
    "automatic_retry",
    "consumption_mode",
    "public_traffic",
    "live_model_call",
    "production_activation",
    "signer_principal",
    "executor_principal",
    "kms_key_version",
    "signing_algorithm",
    "public_key_sha256",
    "issued_at",
    "not_before",
    "expires_at",
    "signature_b64"
  ],
  "properties": {
    "schema_version": {"const": "aigc.nexus-deployment-receipt-publication-permit.v1"},
    "permit_id": {"type": "string", "pattern": "^PUB-[A-Z0-9_-]{8,64}$"},
    "nonce": {"$ref": "#/$defs/sha256"},
    "repository": {"const": "Lornt1666/AIGC"},
    "project_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{4,28}[a-z0-9]$"},
    "project_number": {"type": "string", "pattern": "^[0-9]{6,20}$"},
    "region": {"const": "northamerica-northeast1"},
    "resource_prefix": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,18}$"},
    "release_sha": {"$ref": "#/$defs/gitSha"},
    "release_tree_sha": {"$ref": "#/$defs/gitSha"},
    "receipt_sha256": {"$ref": "#/$defs/sha256"},
    "receipt_content_sha256": {"$ref": "#/$defs/sha256"},
    "receipt_content_length": {"type": "integer", "minimum": 1, "maximum": 1048576},
    "receipt_bucket": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{1,61}[a-z0-9]$"
    },
    "object_name": {
      "type": "string",
      "pattern": "^deployment-receipts/[a-f0-9]{40}/[a-f0-9]{64}\\.json$"
    },
    "content_type": {"const": "application/json"},
    "action_index": {"const": 6},
    "action_name": {"const": "deployment_receipt_publish"},
    "predecessor_action_name": {"const": "judge_deploy"},
    "predecessor_action_permit_sha256": {"$ref": "#/$defs/sha256"},
    "maximum_mutations": {"const": 1},
    "automatic_retry": {"const": false},
    "consumption_mode": {"const": "gcs_receipt_upload_if_generation_match_zero"},
    "public_traffic": {"const": false},
    "live_model_call": {"const": false},
    "production_activation": {"const": false},
    "signer_principal": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{4,28}[a-z0-9]@[a-z][a-z0-9-]{4,28}[a-z0-9]\\.iam\\.gserviceaccount\\.com$"
    },
    "executor_principal": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{4,28}[a-z0-9]@[a-z][a-z0-9-]{4,28}[a-z0-9]\\.iam\\.gserviceaccount\\.com$"
    },
    "kms_key_version": {
      "type": "string",
      "pattern": "^projects/[a-z][a-z0-9-]{4,28}[a-z0-9]/locations/northamerica-northeast1/keyRings/[A-Za-z0-9_-]{1,63}/cryptoKeys/[A-Za-z0-9_-]{1,63}/cryptoKeyVersions/[1-9][0-9]*$"
    },
    "signing_algorithm": {"const": "RSA_SIGN_PSS_2048_SHA256"},
    "public_key_sha256": {"$ref": "#/$defs/sha256"},
    "issued_at": {"type": "string", "format": "date-time"},
    "not_before": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "signature_b64": {"type": "string", "minLength": 32, "maxLength": 2048}
  },
  "$defs": {
    "gitSha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
