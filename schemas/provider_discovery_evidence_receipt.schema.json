{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://aigc.local/schemas/provider_discovery_evidence_receipt.schema.json","title":"AIGC Provider Discovery Evidence Receipt v1","type":"object","additionalProperties":false,"$defs":{"hex40":{"type":"string","pattern":"^[a-f0-9]{40}$"},"hex64":{"type":"string","pattern":"^[a-f0-9]{64}$"},"sha256":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"},"project_ref":{"type":"string","pattern":"^gcp_project://[a-z][a-z0-9-]{4,28}[a-z0-9]$"},"secret_ref":{"type":"string","pattern":"^gcp_secret://[a-z][a-z0-9-]{4,28}[a-z0-9]/[a-z][a-z0-9-]{2,254}/[1-9][0-9]*$"},"datetime":{"type":"string","format":"date-time"},"https_origin":{"type":"string","pattern":"^https://[A-Za-z0-9.-]+(?::[0-9]{2,5})?$"},"https_uri":{"type":"string","format":"uri","pattern":"^https://[A-Za-z0-9.-]+(?::[0-9]{2,5})?/[A-Za-z0-9._~!$&'()*+,;=:@%/-]*$"}},"required":["contract_id","contract_version","receipt_id","exact_revision","procurement_pack_digest","discovery_authorization_receipt_id","target_project_reference","collected_at","result","review_status","observed_resources","enabled_api_service_names","service_account_key_counts","identity_platform_configuration_status","state_backend_status","unresolved_requirements","raw_secret_values_present","mutation_performed","secret_value_access_performed","provider_read_performed","external_action_performed"],"properties":{"contract_id":{"const":"AIGC-PROVIDER-DISCOVERY-EVIDENCE-RECEIPT-001"},"contract_version":{"const":"1.0.0"},"receipt_id":{"type":"string","pattern":"^SDE-[A-Z0-9][A-Z0-9:-]{7,199}$"},"exact_revision":{"$ref":"#/$defs/hex40"},"procurement_pack_digest":{"$ref":"#/$defs/hex64"},"discovery_authorization_receipt_id":{"type":"string","pattern":"^SDA-[A-Z0-9][A-Z0-9:-]{7,199}$"},"target_project_reference":{"$ref":"#/$defs/project_ref"},"collected_at":{"$ref":"#/$defs/datetime"},"result":{"enum":["SUCCESS","PARTIAL","FAILED"]},"review_status":{"enum":["PENDING","ACCEPTED","REJECTED"]},