{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aigc.local/schemas/quest.schema.json",
  "title": "AIGC Canonical Quest",
  "description": "Versioned governed work aggregate created from a qualified opportunity candidate. Quest creation starts in PROPOSED and never grants work acceptance or external-action authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "quest_id",
    "source_candidate_id",
    "title",
    "purpose",
    "scope",
    "non_scope",
    "owner_role",
    "authority_class",
    "risk_class",
    "lifecycle_state",
    "lifecycle_contract_id",
    "lifecycle_contract_version",
    "acceptance_criteria",
    "budget",
    "deadline_at",
    "source_snapshot",
    "created_from_candidate_revision",
    "created_at",
    "updated_at",
    "external_action_performed"
  ],
  "properties": {
    "quest_id": {
      "type": "string",
      "pattern": "^quest_[A-Za-z0-9_-]{6,100}$"
    },
    "source_candidate_id": {
      "type": "string",
      "pattern": "^cand_[A-Za-z0-9_-]{6,80}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "purpose": {
      "type": "string",
      "minLength": 1,
      "maxLength": 50000
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "non_scope": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "owner_role": {
      "const": "ACCOUNTABLE_OPERATOR"
    },
    "authority_class": {
      "const": "ACCOUNTABLE_OPERATOR"
    },
    "risk_class": {
      "enum": [
        "unassessed",
        "low",
        "medium",
        "high",
        "restricted"
      ]
    },
    "lifecycle_state": {
      "enum": [
        "DISCOVERED",
        "QUALIFIED",
        "PROPOSED",
        "APPROVAL_REQUIRED",
        "WORK_ACCEPTED",
        "RESEARCHING",
        "PLANNING",
        "EXECUTING_LOCALLY",
        "REVIEW_REQUIRED",
        "REWORK_REQUIRED",
        "ACCEPTED_FOR_DELIVERY",
        "DELIVERED",
        "CLOSED",
        "REJECTED",
        "CANCELLED"
      ]
    },
    "lifecycle_contract_id": {
      "const": "AIGC-JOB-LIFECYCLE-001"
    },
    "lifecycle_contract_version": {
      "const": "1.0.0"
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      }
    },
    "budget": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "min",
            "max",
            "currency"
          ],
          "properties": {
            "min": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "max": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "currency": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[A-Z]{3}$"
            }
          }
        }
      ]
    },
    "deadline_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "source_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "source_name",
        "source_url",
        "posting_title",
        "rights_status",
        "input_digest"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "source_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "source_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "posting_title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "rights_status": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "input_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "created_from_candidate_revision": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "external_action_performed": {
      "const": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "lifecycle_state": {
            "const": "PROPOSED"
          }
        }
      },
      "then": {
        "properties": {
          "external_action_performed": {
            "const": false
          }
        }
      }
    }
  ]
}
