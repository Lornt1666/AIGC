{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aigc.local/schemas/quest.schema.json",
  "title": "AIGC Canonical Quest",
  "description": "Versioned governed work aggregate. Quest creation starts in PROPOSED; work acceptance and delivery acceptance remain separate, receipt-bound decisions.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "quest_id",
    "source_candidate_id",
    "title",
    "purpose",
    "scope",
    "non_scope",
    "owner_role",
    "authority_class",
    "risk_class",
    "lifecycle_state",
    "lifecycle_contract_id",
    "lifecycle_contract_version",
    "acceptance_criteria",
    "budget",
    "deadline_at",
    "source_snapshot",
    "created_from_candidate_revision",
    "approval_request",
    "work_acceptance",
    "terminal_decision",
    "created_at",
    "updated_at",
    "external_action_performed"
  ],
  "properties": {
    "quest_id": {
      "type": "string",
      "pattern": "^quest_[A-Za-z0-9_-]{6,100}$"
    },
    "source_candidate_id": {
      "type": "string",
      "pattern": "^cand_[A-Za-z0-9_-]{6,80}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "purpose": {
      "type": "string",
      "minLength": 1,
      "maxLength": 50000
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "non_scope": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "owner_role": {
      "const": "ACCOUNTABLE_OPERATOR"
    },
    "authority_class": {
      "const": "ACCOUNTABLE_OPERATOR"
    },
    "risk_class": {
      "enum": [
        "unassessed",
        "low",
        "medium",
        "high",
        "restricted"
      ]
    },
    "lifecycle_state": {
      "enum": [
        "DISCOVERED",
        "QUALIFIED",
        "PROPOSED",
        "APPROVAL_REQUIRED",
        "WORK_ACCEPTED",
        "RESEARCHING",
        "PLANNING",
        "EXECUTING_LOCALLY",
        "REVIEW_REQUIRED",
        "REWORK_REQUIRED",
        "ACCEPTED_FOR_DELIVERY",
        "DELIVERED",
        "CLOSED",
        "REJECTED",
        "CANCELLED"
      ]
    },
    "lifecycle_contract_id": {
      "const": "AIGC-JOB-LIFECYCLE-001"
    },
    "lifecycle_contract_version": {
      "const": "1.0.0"
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      }
    },
    "budget": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "min",
            "max",
            "currency"
          ],
          "properties": {
            "min": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "max": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "currency": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[A-Z]{3}$"
            }
          }
        }
      ]
    },
    "deadline_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "source_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "source_name",
        "source_url",
        "posting_title",
        "rights_status",
        "input_digest"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "source_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "source_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "posting_title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "rights_status": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "input_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "created_from_candidate_revision": {
      "type": "integer",
      "minimum": 1
    },
    "approval_request": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "approval_request_id",
            "requested_at",
            "requested_by_role",
            "reason",
            "source_state",
            "target_state",
            "quest_revision",
            "exact_revision",
            "revision_binding_mode",
            "transition_digest",
            "request_digest",
            "required_authorization",
            "status",
            "external_action_performed"
          ],
          "properties": {
            "approval_request_id": {
              "type": "string",
              "pattern": "^approval_[A-Za-z0-9_-]{6,120}$"
            },
            "requested_at": {
              "type": "string",
              "format": "date-time"
            },
            "requested_by_role": {
              "const": "ACCOUNTABLE_OPERATOR"
            },
            "reason": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 4000
            },
            "source_state": {
              "const": "PROPOSED"
            },
            "target_state": {
              "const": "WORK_ACCEPTED"
            },
            "quest_revision": {
              "type": "integer",
              "minimum": 2
            },
            "exact_revision": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            },
            "revision_binding_mode": {
              "enum": [
                "exact_source_revision",
                "derived_local_simulation"
              ]
            },
            "transition_digest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "request_digest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "required_authorization": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "resource_id",
                "action",
                "scopes",
                "purpose",
                "evidence_ids"
              ],
              "properties": {
                "resource_id": {
                  "type": "string",
                  "minLength": 1
                },
                "action": {
                  "const": "accept_work"
                },
                "scopes": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "purpose": {
                  "const": "work_acceptance"
                },
                "evidence_ids": {
                  "type": "array",
                  "minItems": 2,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            "status": {
              "enum": [
                "PENDING",
                "CONSUMED",
                "REJECTED",
                "CANCELLED"
              ]
            },
            "external_action_performed": {
              "const": false
            }
          }
        }
      ]
    },
    "work_acceptance": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "decision",
            "operator_role",
            "reason",
            "accepted_at",
            "approval_request_id",
            "transition_digest",
            "request_digest",
            "authorization_receipt_id",
            "authorization_decision_id",
            "authorization_request_digest",
            "authorization_exact_revision",
            "principal_id",
            "source_state",
            "target_state",
            "external_action_performed"
          ],
          "properties": {
            "decision": {
              "const": "WORK_ACCEPTED"
            },
            "operator_role": {
              "const": "ACCOUNTABLE_OPERATOR"
            },
            "reason": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 4000
            },
            "accepted_at": {
              "type": "string",
              "format": "date-time"
            },
            "approval_request_id": {
              "type": "string",
              "pattern": "^approval_[A-Za-z0-9_-]{6,120}$"
            },
            "transition_digest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "request_digest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "authorization_receipt_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            },
            "authorization_decision_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            },
            "authorization_request_digest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "authorization_exact_revision": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            },
            "principal_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            },
            "source_state": {
              "const": "APPROVAL_REQUIRED"
            },
            "target_state": {
              "const": "WORK_ACCEPTED"
            },
            "external_action_performed": {
              "const": false
            }
          }
        }
      ]
    },
    "terminal_decision": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "decision",
            "operator_role",
            "reason",
            "decided_at",
            "previous_state",
            "request_digest",
            "external_action_performed"
          ],
          "properties": {
            "decision": {
              "enum": [
                "REJECTED",
                "CANCELLED"
              ]
            },
            "operator_role": {
              "const": "ACCOUNTABLE_OPERATOR"
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            },
            "decided_at": {
              "type": "string",
              "format": "date-time"
            },
            "previous_state": {
              "enum": [
                "PROPOSED",
                "APPROVAL_REQUIRED",
                "WORK_ACCEPTED"
              ]
            },
            "request_digest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "external_action_performed": {
              "const": false
            }
          }
        }
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "external_action_performed": {
      "const": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "lifecycle_state": {
            "const": "PROPOSED"
          }
        }
      },
      "then": {
        "properties": {
          "approval_request": {
            "type": "null"
          },
          "work_acceptance": {
            "type": "null"
          },
          "terminal_decision": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "lifecycle_state": {
            "const": "APPROVAL_REQUIRED"
          }
        }
      },
      "then": {
        "properties": {
          "approval_request": {
            "type": "object",
            "properties": {
              "status": {
                "const": "PENDING"
              }
            }
          },
          "work_acceptance": {
            "type": "null"
          },
          "terminal_decision": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "lifecycle_state": {
            "const": "WORK_ACCEPTED"
          }
        }
      },
      "then": {
        "properties": {
          "approval_request": {
            "type": "object",
            "properties": {
              "status": {
                "const": "CONSUMED"
              }
            }
          },
          "work_acceptance": {
            "type": "object"
          },
          "terminal_decision": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "lifecycle_state": {
            "const": "REJECTED"
          }
        }
      },
      "then": {
        "properties": {
          "terminal_decision": {
            "type": "object",
            "properties": {
              "decision": {
                "const": "REJECTED"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "lifecycle_state": {
            "const": "CANCELLED"
          }
        }
      },
      "then": {
        "properties": {
          "terminal_decision": {
            "type": "object",
            "properties": {
              "decision": {
                "const": "CANCELLED"
              }
            }
          }
        }
      }
    }
  ]
}