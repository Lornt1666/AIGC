{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://regenexcalibur.local/schemas/exact_sha_ci_receipt.schema.json",
  "title": "AIGC Exact-SHA CI Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "request_sha256", "requested_target_sha", "observed_checkout_sha",
    "tested_tree_sha", "broker_revision", "validation_contract_sha256", "run_number", "run_id",
    "broker_validation_conclusion", "workflow_conclusion_at_receipt", "step_conclusions",
    "artifact_manifest_sha256", "external_action_performed",
    "production_activation_authorized", "receipt_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.1.0"},
    "request_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "requested_target_sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "observed_checkout_sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "tested_tree_sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "broker_revision": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "validation_contract_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "run_number": {"type": "integer", "minimum": 1},
    "run_id": {"type": "integer", "minimum": 1},
    "broker_validation_conclusion": {"const": "success"},
    "workflow_conclusion_at_receipt": {"const": "pending"},
    "step_conclusions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contracts", "redaction", "procurement_smoke", "provider_discovery", "terraform_inert", "tests", "readiness"],
      "properties": {
        "contracts": {"const": "success"},
        "redaction": {"const": "success"},
        "procurement_smoke": {"const": "success"},
        "provider_discovery": {"const": "success"},
        "terraform_inert": {"const": "success"},
        "tests": {"const": "success"},
        "readiness": {"const": "success"}
      }
    },
    "artifact_manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "external_action_performed": {"const": false},
    "production_activation_authorized": {"const": false},
    "receipt_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
