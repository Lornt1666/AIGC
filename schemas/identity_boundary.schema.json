{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://aigc.local/schemas/identity_boundary.schema.json","title":"AIGC Production Identity Boundary Normalized Context v1","description":"Strict, provider-neutral, minimum-necessary identity context. Raw provider assertions, tokens, credentials, nonce values, and unrestricted claims are prohibited.","type":"object","additionalProperties":false,"required":["contract_id","contract_version","principal_id","provider_class","provider_binding_id","membership_id","tenant_id","project_id","roles","granted_scopes","session_id","session_state","identity_assurance","authentication_assurance","federation_assurance","evidence_maturity","runtime_authority","exact_revision","issued_at","expires_at","evidence_ids","verified","external_action_performed"],"properties":{"contract_id":{"const":"AIGC-PIBC-001"},"contract_version":{"const":"1.0.0"},"principal_id":{"type":"string","minLength":1,"maxLength":160,"pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"},"provider_class":{"enum":["LOCAL_DEVELOPMENT","OIDC","WORKLOAD_IDENTITY"]},"provider_binding_id":{"type":"string","minLength":1,"maxLength":200,"pattern":"^[A-Za-z0-9][A-Za-z0-9._:/-]{0,199}$"},"membership_id":{"type":"string","minLength":1,"maxLength":160,"pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"},"tenant_id":{"type":"string","minLength":1,"maxLength":160,"pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"},"project_id":{"type":"string","minLength":1,"maxLength":160,"pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"},"roles":{"type":"array","minItems":1,"maxItems":100,"uniqueItems":true,"items":{"type":"string","minLength":1,"maxLength":120}},"granted_scopes":{"type":"array","maxItems":200,"uniqueItems":true,"items":{"type":"string","minLength":1,"maxLength":200}},"session_id":{"type":"string","minLength":1,"maxLength":200,"pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{0,199}$"},"session_state":{"const":"ACTIVE"},"identity_assurance":{"enum":["IAL0","IAL1","IAL2","IAL3"]},"authentication_assurance":{"enum":["AAL0","AAL1","AAL2","AAL3"]},"federation_assurance":{"enum":["FAL0","FAL1","FAL2","FAL3"]},"evidence_maturity":{"enum":["EA0_CLAIMED","EA1_SCHEMA_VALID","EA2_SEMANTICALLY_TESTED","EA3_CI_EXECUTED","EA4_STAGING_OBSERVED","EA5_PRODUCTION_OBSERVED"]},"runtime_authority":{"enum":["LOCAL_SIMULATION","PRODUCTION_VERIFIED"]},"exact_revision":{"type":"string","pattern":"^([a-f0-9]{40}|LOCAL_UNVERIFIED)$"},"issued_at":{"type":"string","format":"date-time"},"expires_at":{"type":"string","format":"date-time"},"evidence_ids":{"type":"array","minItems":1,"maxItems":200,"uniqueItems":true,"items":{"type":"string","minLength":1,"maxLength":200}},"verified":{"const":true},"external_action_performed":{"const":false}}}
