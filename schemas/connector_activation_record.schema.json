{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://regenexcalibur.invalid/schemas/connector_activation_record.schema.json",
  "title": "Ω Mission OS Connector Activation Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "activation_id", "connector_id", "connector_version", "environment", "requested_capabilities", "manifest_sha256", "approval_digest", "policy_digest", "dependency_digest", "lifecycle_state", "actor_id", "created_at", "production_activation_authorized", "external_send_authorized", "github_mutation_authorized", "activation_sha256"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "activation_id": {"type": "string", "minLength": 8, "maxLength": 128},
    "connector_id": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{2,63}$"},
    "connector_version": {"type": "string", "minLength": 1, "maxLength": 64},
    "environment": {"enum": ["TEST", "STAGING"]},
    "requested_capabilities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "approval_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "policy_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "dependency_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "lifecycle_state": {"enum": ["READY_FOR_ACTIVATION", "ACTIVATED_TEST", "ACTIVATED_STAGING", "SUSPENDED", "RETIRED"]},
    "actor_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "created_at": {"type": "string", "format": "date-time"},
    "production_activation_authorized": {"const": false},
    "external_send_authorized": {"const": false},
    "github_mutation_authorized": {"const": false},
    "activation_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
