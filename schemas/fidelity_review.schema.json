{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AIGC Fidelity Review",
  "type": "object",
  "required": [
    "review_id",
    "created_at",
    "phase",
    "status",
    "opportunity_id",
    "proposal_id",
    "title",
    "employer",
    "fidelity_score",
    "quality_status",
    "checks",
    "risk_flags",
    "revision_recommendations",
    "approval_required_before_external_action",
    "external_action_performed"
  ],
  "properties": {
    "review_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "phase": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "opportunity_id": {
      "type": "string"
    },
    "proposal_id": {
      "type": "string"
    },
    "dossier_id": {
      "type": "string"
    },
    "team_id": {
      "type": "string"
    },
    "compliance_review_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "employer": {
      "type": "string"
    },
    "source_platform": {
      "type": "string"
    },
    "source_url": {
      "type": "string"
    },
    "readiness_decision": {
      "type": "string"
    },
    "compliance_status": {
      "type": "string"
    },
    "fidelity_score": {
      "type": "integer"
    },
    "quality_status": {
      "type": "string"
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "risk_flags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "revision_recommendations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "approval_required_before_external_action": {
      "type": "boolean"
    },
    "external_action_performed": {
      "type": "boolean"
    }
  },
  "additionalProperties": true
}
