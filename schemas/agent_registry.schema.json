{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aigc.local/schemas/agent_registry.schema.json",
  "title": "AIGC Agent Registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "registry_id",
    "schema_version",
    "updated_at",
    "conductor_agent_id",
    "default_handoff_sequence",
    "required_approval_gates",
    "default_forbidden_actions",
    "default_quality_criteria",
    "agents",
    "external_action_performed"
  ],
  "properties": {
    "registry_id": {
      "const": "AIGC-AGENT-REGISTRY-001"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "conductor_agent_id": {
      "const": "AIGC-AGENT-OMEGA-X"
    },
    "default_handoff_sequence": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^AIGC-AGENT-[A-Z0-9-]+$"
      }
    },
    "required_approval_gates": {
      "$ref": "#/$defs/string_set"
    },
    "default_forbidden_actions": {
      "$ref": "#/$defs/string_set"
    },
    "default_quality_criteria": {
      "$ref": "#/$defs/string_set"
    },
    "agents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/agent"
      }
    },
    "external_action_performed": {
      "const": false
    }
  },
  "$defs": {
    "string_set": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent_id",
        "role",
        "archetype",
        "purpose",
        "allowed_actions",
        "input_artifact_types",
        "output_artifact_types",
        "handoff_targets",
        "approval_required",
        "external_action_allowed",
        "active",
        "orchestration_rank"
      ],
      "properties": {
        "agent_id": {
          "type": "string",
          "pattern": "^AIGC-AGENT-[A-Z0-9-]+$"
        },
        "role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "archetype": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "allowed_actions": {
          "$ref": "#/$defs/string_set"
        },
        "input_artifact_types": {
          "$ref": "#/$defs/string_set"
        },
        "output_artifact_types": {
          "$ref": "#/$defs/string_set"
        },
        "handoff_targets": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^AIGC-AGENT-[A-Z0-9-]+$"
          }
        },
        "approval_required": {
          "const": true
        },
        "external_action_allowed": {
          "const": false
        },
        "active": {
          "type": "boolean"
        },
        "orchestration_rank": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
