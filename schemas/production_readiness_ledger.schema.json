{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ledger_id",
    "version",
    "mode",
    "production_readiness_threshold",
    "status_multipliers",
    "capabilities",
    "truth_controls"
  ],
  "properties": {
    "ledger_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "const": "evidence_backed_completion_measurement"
    },
    "production_readiness_threshold": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "status_multipliers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "complete",
        "implemented_internal",
        "partial",
        "planned",
        "stale",
        "unimplemented",
        "superseded"
      ],
      "properties": {
        "complete": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "implemented_internal": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "partial": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "planned": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "stale": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "unimplemented": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "superseded": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "capability_id",
          "name",
          "dimension",
          "weight",
          "declared_status",
          "required_evidence",
          "blocking_for_production"
        ],
        "properties": {
          "capability_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "dimension": {
            "type": "string",
            "minLength": 1
          },
          "weight": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "declared_status": {
            "type": "string",
            "enum": [
              "complete",
              "implemented_internal",
              "partial",
              "planned",
              "stale",
              "unimplemented",
              "superseded"
            ]
          },
          "required_evidence": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "blocking_for_production": {
            "type": "boolean"
          }
        }
      }
    },
    "truth_controls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "missing_evidence_downgrades_status",
        "completion_claim_requires_all_evidence",
        "production_ready_requires_no_blocking_gaps",
        "operator_review_required",
        "external_action_performed"
      ],
      "properties": {
        "missing_evidence_downgrades_status": {
          "const": true
        },
        "completion_claim_requires_all_evidence": {
          "const": true
        },
        "production_ready_requires_no_blocking_gaps": {
          "const": true
        },
        "operator_review_required": {
          "const": true
        },
        "external_action_performed": {
          "const": false
        }
      }
    }
  }
}
