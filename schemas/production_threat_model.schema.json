{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aigc.local/schemas/production_threat_model.schema.json",
  "title": "AIGC Production Threat Model v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id",
    "contract_version",
    "status",
    "architecture_reference",
    "assets",
    "trust_boundaries",
    "threats",
    "residual_risks",
    "review_requirements",
    "authority",
    "external_action_performed"
  ],
  "properties": {
    "contract_id": {"const": "AIGC-PRODUCTION-THREAT-MODEL-001"},
    "contract_version": {"const": "1.0.0"},
    "status": {"const": "DRAFT_REVIEW_REQUIRED"},
    "architecture_reference": {"const": "config/production_environment_decision.json"},
    "assets": {
      "type": "array",
      "minItems": 7,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,99}$"}
    },
    "trust_boundaries": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["boundary_id", "source", "destination", "data_classes", "default_decision"],
        "properties": {
          "boundary_id": {"type": "string", "pattern": "^TB-[A-Z0-9-]{4,80}$"},
          "source": {"type": "string", "minLength": 1, "maxLength": 120},
          "destination": {"type": "string", "minLength": 1, "maxLength": 120},
          "data_classes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"enum": ["public", "internal", "confidential", "restricted"]}
          },
          "default_decision": {"const": "DENY"}
        }
      }
    },
    "threats": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "threat_id",
          "category",
          "scenario",
          "affected_assets",
          "severity",
          "mitigations",
          "verification_status"
        ],
        "properties": {
          "threat_id": {"type": "string", "pattern": "^THR-[A-Z0-9-]{4,80}$"},
          "category": {"enum": ["spoofing", "tampering", "repudiation", "information_disclosure", "denial_of_service", "elevation_of_privilege", "supply_chain", "privacy"]},
          "scenario": {"type": "string", "minLength": 10, "maxLength": 1000},
          "affected_assets": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1, "maxLength": 100}
          },
          "severity": {"enum": ["low", "medium", "high", "critical"]},
          "mitigations": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 3, "maxLength": 300}
          },
          "verification_status": {"enum": ["IMPLEMENTED_INTERNAL", "STAGING_EVIDENCE_REQUIRED", "INDEPENDENT_REVIEW_REQUIRED"]}
        }
      }
    },
    "residual_risks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["risk_id", "description", "severity", "required_evidence"],
        "properties": {
          "risk_id": {"type": "string", "pattern": "^RSK-[A-Z0-9-]{4,80}$"},
          "description": {"type": "string", "minLength": 10, "maxLength": 1000},
          "severity": {"enum": ["low", "medium", "high", "critical"]},
          "required_evidence": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 3, "maxLength": 300}
          }
        }
      }
    },
    "review_requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accountable_operator_review", "independent_security_review", "staging_abuse_tests", "review_status"],
      "properties": {
        "accountable_operator_review": {"const": true},
        "independent_security_review": {"const": true},
        "staging_abuse_tests": {"const": true},
        "review_status": {"const": "PENDING"}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["defensive_testing_authorized", "third_party_testing_authorized", "production_testing_authorized"],
      "properties": {
        "defensive_testing_authorized": {"const": true},
        "third_party_testing_authorized": {"const": false},
        "production_testing_authorized": {"const": false}
      }
    },
    "external_action_performed": {"const": false}
  }
}
