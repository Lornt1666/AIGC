{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aigc.regenexcalibur.invalid/schemas/colosseum/task_dag.schema.json",
  "title": "AIGC TaskDAG",
  "type": "object",
  "additionalProperties": false,
  "required": ["work_order_id", "tasks", "dependencies"],
  "properties": {
    "work_order_id": {"type": "string", "minLength": 1},
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["task_id", "work_order_id", "objective", "task_type", "required_capabilities", "input_artifact_ids", "expected_output_types", "definition_of_done_id", "estimated_effort_minutes", "parallelizable", "external_effect", "idempotency_required", "human_review_required", "deadline", "priority", "state"],
        "properties": {
          "task_id": {"type": "string", "minLength": 1},
          "work_order_id": {"type": "string", "minLength": 1},
          "objective": {"type": "string", "minLength": 1},
          "task_type": {"type": "string", "minLength": 1},
          "required_capabilities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "input_artifact_ids": {"type": "array", "minItems": 0, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "expected_output_types": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "definition_of_done_id": {"type": "string", "minLength": 1},
          "estimated_effort_minutes": {"type": "integer", "minimum": 1},
          "parallelizable": {"type": "boolean"},
          "external_effect": {"type": "boolean"},
          "idempotency_required": {"type": "boolean"},
          "human_review_required": {"type": "boolean"},
          "deadline": {"type": "string", "format": "date-time"},
          "priority": {"type": "integer"},
          "state": {"enum": ["PLANNED", "READY", "BLOCKED", "EXECUTING", "VERIFYING", "COMPLETE", "FAILED", "CANCELLED", "UNCERTAIN_EXTERNAL_OUTCOME"]}
        },
        "allOf": [
          {
            "if": {"properties": {"external_effect": {"const": true}}},
            "then": {"properties": {"idempotency_required": {"const": true}}}
          }
        ]
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["predecessor_task_id", "successor_task_id"],
        "properties": {
          "predecessor_task_id": {"type": "string", "minLength": 1},
          "successor_task_id": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
