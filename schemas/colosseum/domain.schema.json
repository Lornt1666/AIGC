{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://regenexcalibur.invalid/schemas/colosseum/domain.schema.json",
  "title": "AIGC Colosseum Canonical Domain",
  "type": "object",
  "$defs": {
    "nonEmptyString": {"type": "string", "minLength": 1},
    "confidentialityClass": {"enum": ["PUBLIC", "INTERNAL", "CONFIDENTIAL", "RESTRICTED"]},
    "presenceRequirement": {"enum": ["NONE", "OCCASIONAL", "PERIODIC", "ROUTINE", "DAILY", "UNKNOWN"]},
    "capabilityVerdict": {"enum": ["VERIFIED_CAPABLE", "CAPABLE_WITH_REVIEW", "CAPABLE_WITH_SPECIALIST", "RESEARCH_REQUIRED", "NOT_QUALIFIED", "LEGALLY_RESTRICTED"]},
    "deliverableState": {"enum": ["GENERATED", "VALIDATING", "FAILED_VALIDATION", "REQUIRES_REVISION", "READY_FOR_HUMAN_REVIEW", "READY_FOR_DELIVERY", "DELIVERED", "EMPLOYER_ACCEPTED", "EMPLOYER_REJECTED"]},
    "verificationStatus": {"enum": ["NOT_RUN", "PASS", "PASS_WITH_LIMITATION", "FAIL", "HUMAN_REVIEW_REQUIRED"]},
    "employerVault": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vault_id", "employer_id", "confidentiality_class", "allowed_jurisdictions", "retention_policy_id", "deletion_policy_id", "cross_employer_document_access", "cross_employer_secret_access", "cross_employer_retrieval", "cross_employer_prompt_context", "cross_employer_training_use"],
      "properties": {
        "vault_id": {"$ref": "#/$defs/nonEmptyString"},
        "employer_id": {"$ref": "#/$defs/nonEmptyString"},
        "confidentiality_class": {"$ref": "#/$defs/confidentialityClass"},
        "allowed_jurisdictions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/nonEmptyString"}},
        "retention_policy_id": {"$ref": "#/$defs/nonEmptyString"},
        "deletion_policy_id": {"$ref": "#/$defs/nonEmptyString"},
        "cross_employer_document_access": {"const": false},
        "cross_employer_secret_access": {"const": false},
        "cross_employer_retrieval": {"const": false},
        "cross_employer_prompt_context": {"const": false},
        "cross_employer_training_use": {"const": false}
      }
    },
    "opportunity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["opportunity_id", "source_id", "employer_id", "title", "digitally_executable", "presence_requirement", "legitimacy_status", "capability_requirements", "meeting_expectation"],
      "properties": {
        "opportunity_id": {"$ref": "#/$defs/nonEmptyString"},
        "source_id": {"$ref": "#/$defs/nonEmptyString"},
        "employer_id": {"$ref": "#/$defs/nonEmptyString"},
        "title": {"$ref": "#/$defs/nonEmptyString"},
        "digitally_executable": {"type": "boolean"},
        "presence_requirement": {"$ref": "#/$defs/presenceRequirement"},
        "legitimacy_status": {"$ref": "#/$defs/nonEmptyString"},
        "capability_requirements": {"type": "array", "items": {"$ref": "#/$defs/nonEmptyString"}},
        "meeting_expectation": {"$ref": "#/$defs/nonEmptyString"}
      },
      "allOf": [{"not": {"properties": {"digitally_executable": {"const": true}, "presence_requirement": {"const": "DAILY"}}, "required": ["digitally_executable", "presence_requirement"]}}]
    },
    "engagement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engagement_id", "employer_id", "vault_id", "statement_of_work_id", "acceptance_criteria", "deadline", "authorized"],
      "properties": {
        "engagement_id": {"$ref": "#/$defs/nonEmptyString"},
        "employer_id": {"$ref": "#/$defs/nonEmptyString"},
        "vault_id": {"$ref": "#/$defs/nonEmptyString"},
        "statement_of_work_id": {"$ref": "#/$defs/nonEmptyString"},
        "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonEmptyString"}},
        "deadline": {"type": "string", "format": "date-time"},
        "authorized": {"type": "boolean"}
      }
    },
    "workOrder": {
      "type": "object",
      "additionalProperties": false,
      "required": ["work_order_id", "engagement_id", "objective", "requirement_ids", "acceptance_criteria", "authorized"],
      "properties": {
        "work_order_id": {"$ref": "#/$defs/nonEmptyString"},
        "engagement_id": {"$ref": "#/$defs/nonEmptyString"},
        "objective": {"$ref": "#/$defs/nonEmptyString"},
        "requirement_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonEmptyString"}},
        "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonEmptyString"}},
        "authorized": {"type": "boolean"}
      }
    },
    "agentCell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent_cell_id", "role", "allowed_tools", "allowed_data_scopes", "output_schema_id", "maximum_cost_cad", "maximum_tokens"],
      "properties": {
        "agent_cell_id": {"$ref": "#/$defs/nonEmptyString"},
        "role": {"$ref": "#/$defs/nonEmptyString"},
        "allowed_tools": {"type": "array", "items": {"$ref": "#/$defs/nonEmptyString"}},
        "allowed_data_scopes": {"type": "array", "items": {"$ref": "#/$defs/nonEmptyString"}},
        "output_schema_id": {"$ref": "#/$defs/nonEmptyString"},
        "maximum_cost_cad": {"type": "number", "minimum": 0},
        "maximum_tokens": {"type": "integer", "minimum": 0}
      }
    },
    "swarm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["swarm_id", "engagement_id", "work_order_id", "objective", "agent_cells", "compute_budget_cad", "token_budget", "confidentiality_class", "jurisdiction_policy_id", "verification_policy_id", "emergency_stop_epoch"],
      "properties": {
        "swarm_id": {"$ref": "#/$defs/nonEmptyString"},
        "engagement_id": {"$ref": "#/$defs/nonEmptyString"},
        "work_order_id": {"$ref": "#/$defs/nonEmptyString"},
        "objective": {"$ref": "#/$defs/nonEmptyString"},
        "agent_cells": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/agentCell"}},
        "compute_budget_cad": {"type": "number", "minimum": 0},
        "token_budget": {"type": "integer", "minimum": 0},
        "confidentiality_class": {"$ref": "#/$defs/confidentialityClass"},
        "jurisdiction_policy_id": {"$ref": "#/$defs/nonEmptyString"},
        "verification_policy_id": {"$ref": "#/$defs/nonEmptyString"},
        "emergency_stop_epoch": {"type": "integer", "minimum": 0}
      }
    },
    "deliverable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deliverable_id", "work_order_id", "artifact_ids", "acceptance_criteria", "state"],
      "properties": {
        "deliverable_id": {"$ref": "#/$defs/nonEmptyString"},
        "work_order_id": {"$ref": "#/$defs/nonEmptyString"},
        "artifact_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonEmptyString"}},
        "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonEmptyString"}},
        "state": {"$ref": "#/$defs/deliverableState"}
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verification_id", "deliverable_id", "verifier_identity", "status", "checks", "evidence_refs"],
      "properties": {
        "verification_id": {"$ref": "#/$defs/nonEmptyString"},
        "deliverable_id": {"$ref": "#/$defs/nonEmptyString"},
        "verifier_identity": {"$ref": "#/$defs/nonEmptyString"},
        "status": {"$ref": "#/$defs/verificationStatus"},
        "checks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonEmptyString"}},
        "evidence_refs": {"type": "array", "items": {"$ref": "#/$defs/nonEmptyString"}}
      }
    },
    "capabilityEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability_evidence_id", "discipline", "skill", "verdict", "benchmark_ids", "accepted_deliverable_ids", "validated_attempts", "successful_attempts", "human_review_required", "evidence_refs", "last_verified_at"],
      "properties": {
        "capability_evidence_id": {"$ref": "#/$defs/nonEmptyString"},
        "discipline": {"$ref": "#/$defs/nonEmptyString"},
        "skill": {"$ref": "#/$defs/nonEmptyString"},
        "verdict": {"$ref": "#/$defs/capabilityVerdict"},
        "benchmark_ids": {"type": "array", "items": {"$ref": "#/$defs/nonEmptyString"}},
        "accepted_deliverable_ids": {"type": "array", "items": {"$ref": "#/$defs/nonEmptyString"}},
        "validated_attempts": {"type": "integer", "minimum": 0},
        "successful_attempts": {"type": "integer", "minimum": 0},
        "human_review_required": {"type": "boolean"},
        "evidence_refs": {"type": "array", "items": {"$ref": "#/$defs/nonEmptyString"}},
        "last_verified_at": {"type": "string", "format": "date-time"}
      }
    }
  },
  "properties": {
    "employer_vault": {"$ref": "#/$defs/employerVault"},
    "opportunity": {"$ref": "#/$defs/opportunity"},
    "engagement": {"$ref": "#/$defs/engagement"},
    "work_order": {"$ref": "#/$defs/workOrder"},
    "swarm": {"$ref": "#/$defs/swarm"},
    "deliverable": {"$ref": "#/$defs/deliverable"},
    "verification": {"$ref": "#/$defs/verification"},
    "capability_evidence": {"$ref": "#/$defs/capabilityEvidence"}
  }
}
