{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aigc.regenexcalibur.invalid/schemas/colosseum/swarm_plan.schema.json",
  "title": "AIGC SwarmPlan",
  "type": "object",
  "additionalProperties": false,
  "required": ["plan_id", "work_order_id", "employer_policy_id", "task_order", "assignments", "verification_plan_id", "compute_requirement_ids", "maximum_cost_cad", "maximum_tokens", "execution_authorized"],
  "properties": {
    "plan_id": {"type": "string", "minLength": 1},
    "work_order_id": {"type": "string", "minLength": 1},
    "employer_policy_id": {"type": "string", "minLength": 1},
    "task_order": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "assignments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["task_id", "role_id", "allowed_tools", "allowed_data_scopes", "maximum_cost_cad", "maximum_tokens", "human_review_required", "execution_authorized"],
        "properties": {
          "task_id": {"type": "string", "minLength": 1},
          "role_id": {"type": "string", "minLength": 1},
          "allowed_tools": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "allowed_data_scopes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "maximum_cost_cad": {"type": "number", "minimum": 0},
          "maximum_tokens": {"type": "integer", "minimum": 0},
          "human_review_required": {"type": "boolean"},
          "execution_authorized": {"const": false}
        }
      }
    },
    "verification_plan_id": {"type": "string", "minLength": 1},
    "compute_requirement_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "maximum_cost_cad": {"type": "number", "minimum": 0},
    "maximum_tokens": {"type": "integer", "minimum": 0},
    "execution_authorized": {"const": false}
  }
}
