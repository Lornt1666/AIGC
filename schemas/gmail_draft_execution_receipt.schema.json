{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://regenexcalibur.local/schemas/gmail_draft_execution_receipt.schema.json",
  "title": "Ω Mission OS Gmail Draft Execution Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "result", "provider", "account_fingerprint", "action_type", "destination_sha256", "packet_digest_sha256", "third_stage_receipt_sha256", "emergency_stop_revision", "idempotency_key", "provider_object_id_sha256", "provider_verified", "send_performed", "external_action_performed", "canonical_state_mutated", "previous_receipt_sha256", "execution_receipt_sha256"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "result": {"const": "DRAFT_CREATED_NOT_SENT"},
    "provider": {"const": "GMAIL"},
    "action_type": {"const": "CREATE_DRAFT"},
    "account_fingerprint": {"type": "string", "minLength": 8},
    "destination_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "packet_digest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "third_stage_receipt_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "idempotency_key": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "provider_object_id_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "provider_verified": {"const": true},
    "send_performed": {"const": false},
    "external_action_performed": {"const": true},
    "external_action_type": {"const": "REVERSIBLE_DRAFT_CREATION"},
    "canonical_state_mutated": {"const": false},
    "previous_receipt_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "execution_receipt_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
