{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://aigc.local/schemas/identity_evidence_receipt.schema.json","title":"AIGC Identity Evidence Receipt v1","description":"Immutable, redacted evidence for a PIBC-v1 permit or denial. It never contains raw provider assertions, tokens, credentials, nonce values, or unrestricted claims.","type":"object","additionalProperties":false,"required":["contract_id","contract_version","receipt_id","request_digest","replay_key_digest","result","reason_codes","provider_class","provider_binding_id","assertion_id","principal_id","membership_id","session_id","tenant_id","project_id","identity_assurance","authentication_assurance","federation_assurance","evidence_maturity","runtime_authority","exact_revision","evidence_ids","production_mode","created_at","expires_at","retention_class","operator_review_required","state_changed","external_action_performed"],"properties":{"contract_id":{"const":"AIGC-PIBC-RECEIPT-001"},"contract_version":{"const":"1.0.0"},"receipt_id":{"type":"string","pattern":"^IDR-[A-F0-9]{24}$"},"request_digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},"replay_key_digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},"result":{"enum":["PERMIT","DENY"]},"reason_codes":{"type":"array","maxItems":100,"uniqueItems":true,"items":{"type":"string","pattern":"^[A-Z][A-Z0-9_]{2,79}$"}},"provider_class":{"type":["string","null"],"enum":["LOCAL_DEVELOPMENT","OIDC","WORKLOAD_IDENTITY",null]},"provider_binding_id":{"type":["string","null"],"maxLength":200},"assertion_id":{"type":["string","null"],"maxLength":200},"principal_id":{"type":["string","null"],"maxLength":160},"membership_id":{"type":["string","null"],"maxLength":160},"session_id":{"type":["string","null"],"maxLength":200},"tenant_id":{"type":["string","null"],"maxLength":160},"project_id":{"type":["string","null"],"maxLength":160},"identity_assurance":{"type":["string","null"],"enum":["IAL0","IAL1","IAL2","IAL3",null]},"authentication_assurance":{"type":["string","null"],"enum":["AAL0","AAL1","AAL2","AAL3",null]},"federation_assurance":{"type":["string","null"],"enum":["FAL0","FAL1","FAL2","FAL3",null]},"evidence_maturity":{"type":["string","null"],"enum":["EA0_CLAIMED","EA1_SCHEMA_VALID","EA2_SEMANTICALLY_TESTED","EA3_CI_EXECUTED","EA4_STAGING_OBSERVED","EA5_PRODUCTION_OBSERVED",null]},"runtime_authority":{"type":["string","null"],"enum":["LOCAL_SIMULATION","PRODUCTION_VERIFIED",null]},"exact_revision":{"type":"string","minLength":1,"maxLength":80},"evidence_ids":{"type":"array","maxItems":200,"uniqueItems":true,"items":{"type":"string","minLength":1,"maxLength":200}},"production_mode":{"type":"boolean"},"created_at":{"type":"string","format":"date-time"},"expires_at":{"type":["string","null"],"format":"date-time"},"retention_class":{"type":"string","minLength":1,"maxLength":120,"pattern":"^[A-Z][A-Z0-9_]{2,119}$"},"operator_review_required":{"const":true},"state_changed":{"const":false},"external_action_performed":{"const":false}},"allOf":[{"if":{"properties":{"result":{"const":"PERMIT"}}},"then":{"properties":{"reason_codes":{"maxItems":0},"principal_id":{"type":"string"},"membership_id":{"type":"string"},"session_id":{"type":"string"},"tenant_id":{"type":"string"},"project_id":{"type":"string"},"provider_class":{"type":"string"},"provider_binding_id":{"type":"string"},"assertion_id":{"type":"string"},"identity_assurance":{"type":"string"},"authentication_assurance":{"type":"string"},"federation_assurance":{"type":"string"},"evidence_maturity":{"type":"string"},"runtime_authority":{"type":"string"}}},"else":{"properties":{"reason_codes":{"minItems":1}}}}]}
