{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://regenexcalibur.invalid/schemas/quebec_resource_manifest.schema.json",
  "title": "AIGC Québec Resource Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "provider",
    "project_id",
    "project_number",
    "region",
    "resource_prefix",
    "resources",
    "control_plane_resources",
    "authorization_bindings",
    "cross_region_replication",
    "public_resources",
    "production_resources",
    "service_account_keys",
    "strict_quebec_data_residency_verified"
  ],
  "properties": {
    "schema_version": {"const": "aigc.quebec-resource-manifest.v1"},
    "provider": {"const": "google_cloud"},
    "project_id": {"type": "string", "minLength": 1},
    "project_number": {"type": "string", "minLength": 1},
    "region": {"const": "northamerica-northeast1"},
    "resource_prefix": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,18}$"},
    "resources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["kind", "name", "location"],
        "properties": {
          "kind": {"type": "string"},
          "name": {"type": "string"},
          "location": {"enum": ["northamerica-northeast1", "NORTHAMERICA-NORTHEAST1"]}
        }
      }
    },
    "control_plane_resources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "name", "location", "classification", "customer_content", "residency_status"],
        "properties": {
          "kind": {"type": "string"},
          "name": {"type": "string"},
          "location": {"const": "global"},
          "classification": {"const": "CONTROL_PLANE_METADATA"},
          "customer_content": {"const": false},
          "residency_status": {"const": "VERIFIED_WITH_LIMITATION"}
        }
      }
    },
    "authorization_bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resources", "service_accounts", "exact_secret_version_refs"],
      "properties": {
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "required": ["artifact_registry_repository", "operator_service", "judge_service", "cloud_sql_instance", "database_name", "evidence_bucket", "judge_bucket", "receipt_bucket", "build_source_bucket", "log_bucket", "kms_key_ring"],
          "properties": {
            "artifact_registry_repository": {"type": "string"},
            "operator_service": {"type": "string"},
            "judge_service": {"type": "string"},
            "cloud_sql_instance": {"type": "string"},
            "database_name": {"type": "string"},
            "evidence_bucket": {"type": "string"},
            "judge_bucket": {"type": "string"},
            "receipt_bucket": {"type": "string"},
            "build_source_bucket": {"type": "string"},
            "log_bucket": {"type": "string"},
            "kms_key_ring": {"type": "string"}
          }
        },
        "service_accounts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["deployer", "cloud_build", "operator", "canary_gemini", "canary_openai", "canary_provisioner", "canary_binder", "canary_executor", "canary_publisher", "judge", "security_review", "authority_signer"],
          "properties": {
            "deployer": {"type": "string"},
            "cloud_build": {"type": "string"},
            "operator": {"type": "string"},
            "canary_gemini": {"type": "string"},
            "canary_openai": {"type": "string"},
            "canary_provisioner": {"type": "string"},
            "canary_binder": {"type": "string"},
            "canary_executor": {"type": "string"},
            "canary_publisher": {"type": "string"},
            "judge": {"type": "string"},
            "security_review": {"type": "string"},
            "authority_signer": {"type": "string"}
          }
        },
        "exact_secret_version_refs": {
          "type": "object",
          "oneOf": [
            {"maxProperties": 0},
            {
              "additionalProperties": false,
              "required": ["runtime_control_dsn", "operator_token", "operator_binding_key", "runtime_admin_token", "runtime_admin_binding_key", "judge_token", "judge_binding_key"],
              "properties": {
                "runtime_control_dsn": {"type": "string"},
                "operator_token": {"type": "string"},
                "operator_binding_key": {"type": "string"},
                "runtime_admin_token": {"type": "string"},
                "runtime_admin_binding_key": {"type": "string"},
                "judge_token": {"type": "string"},
                "judge_binding_key": {"type": "string"}
              }
            }
          ]
        }
      }
    },
    "cross_region_replication": {"const": false},
    "public_resources": {"const": false},
    "production_resources": {"const": false},
    "service_account_keys": {"const": false},
    "strict_quebec_data_residency_verified": {"const": false}
  }
}
