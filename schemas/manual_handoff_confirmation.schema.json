{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AIGC Manual Handoff Confirmation",
  "type": "object",
  "required": [
    "confirmation_id",
    "confirmation_type",
    "status",
    "execution_id",
    "authorization_id",
    "action_id",
    "proposal_id",
    "confirmed_at",
    "confirmed_by",
    "operator",
    "confirmation_reference",
    "confirmation_reference_hash",
    "phase5_exact_acceptance_verified",
    "authorization_was_unexpired_at_confirmation",
    "aigc_performed_external_action",
    "external_action_performed",
    "phase7_handoff_ready"
  ],
  "properties": {
    "confirmation_id": {"type": "string"},
    "confirmation_type": {"type": "string", "enum": ["operator_manual_handoff_completion"]},
    "status": {"type": "string", "enum": ["confirmed"]},
    "execution_id": {"type": "string"},
    "authorization_id": {"type": "string"},
    "action_id": {"type": "string"},
    "proposal_id": {"type": "string"},
    "confirmed_at": {"type": "string"},
    "confirmed_by": {"type": "string", "enum": ["human_operator"]},
    "operator": {"type": "string"},
    "confirmation_reference": {"type": "string"},
    "confirmation_reference_hash": {"type": "string"},
    "phase5_exact_acceptance_verified": {"type": "boolean"},
    "authorization_was_unexpired_at_confirmation": {"type": "boolean"},
    "aigc_performed_external_action": {"type": "boolean"},
    "external_action_performed": {"type": "boolean"},
    "phase7_handoff_ready": {"type": "boolean"}
  },
  "additionalProperties": false
}
