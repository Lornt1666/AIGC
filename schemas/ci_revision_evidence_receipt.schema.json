{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aigc.local/schemas/ci_revision_evidence_receipt.schema.json",
  "title": "AIGC CI Immutable Revision Evidence Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "created_at",
    "event_name",
    "expected_revision",
    "actual_revision",
    "verified",
    "evidence_class",
    "operator_review_required",
    "external_action_performed"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "receipt_id": {
      "type": "string",
      "pattern": "^AIGC-CI-REVISION-[A-F0-9]{16}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "event_name": {
      "type": "string",
      "enum": [
        "push",
        "pull_request",
        "workflow_dispatch",
        "unknown"
      ]
    },
    "expected_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "actual_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "verified": {
      "type": "boolean"
    },
    "evidence_class": {
      "const": "immutable_checked_out_revision"
    },
    "operator_review_required": {
      "const": true
    },
    "external_action_performed": {
      "const": false
    }
  }
}
