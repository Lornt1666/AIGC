{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://aigc.local/schemas/production_release_manifest.schema.json","title":"AIGC Production Release Manifest v1","type":"object","additionalProperties":false,"required":["contract_id","contract_version","release_id","environment","exact_revision","readiness_truth_digest","expected_blocking_gaps","release_artifact","evidence_receipts","operator_decision","operator_approval_receipt_id","created_at","expires_at","external_action_performed"],"properties":{"contract_id":{"const":"AIGC-PRODUCTION-RELEASE-MANIFEST-001"},"contract_version":{"const":"1.0.0"},"release_id":{"type":"string","pattern":"^REL-[A-Z0-9][A-Z0-9-]{7,119}$"},"environment":{"const":"production"},"exact_revision":{"type":"string","pattern":"^[a-f0-9]{40}$"},"readiness_truth_digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},"expected_blocking_gaps":{"type":"array","maxItems":0,"items":{"type":"string"}},"release_artifact":{"type":"object","additionalProperties":false,"required":["kind","reference","digest","immutable"],"properties":{"kind":{"enum":["container_image","source_archive","signed_bundle"]},"reference":{"type":"string","minLength":1,"maxLength":1000},"digest":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"},"immutable":{"const":true}}},"evidence_receipts":{"type":"object","additionalProperties":false,"required":["ci","security","privacy","database_restore","rollback","monitoring","incident_response"],"properties":{"ci":{"$ref":"#/$defs/receiptArray"},"security":{"$ref":"#/$defs/receiptArray"},"privacy":{"$ref":"#/$defs/receiptArray"},"database_restore":{"$ref":"#/$defs/receiptArray"},"rollback":{"$ref":"#/$defs/receiptArray"},"monitoring":{"$ref":"#/$defs/receiptArray"},"incident_response":{"$ref":"#/$defs/receiptArray"}}},"operator_decision":{"enum":["PENDING","APPROVED","DENIED"]},"operator_approval_receipt_id":{"type":["string","null"],"pattern":"^OPR-[A-Z0-9][A-Z0-9:-]{7,199}$"},"created_at":{"type":"string","format":"date-time"},"expires_at":{"type":"string","format":"date-time"},"external_action_performed":{"const":false}},"$defs":{"receiptArray":{"type":"array","minItems":1,"maxItems":100,"uniqueItems":true,"items":{"type":"string","minLength":1,"maxLength":300}}},"allOf":[{"if":{"properties":{"operator_decision":{"const":"APPROVED"}}},"then":{"properties":{"operator_approval_receipt_id":{"type":"string"}}},"else":{"properties":{"operator_approval_receipt_id":{"type":["string","null"]}}}}]}
