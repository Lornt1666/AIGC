{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Traceable data-quality finding with explicit severity, lifecycle, blocking status, ownership, and remediation evidence.",
  "properties": {
    "affected_entity": {
      "additionalProperties": false,
      "properties": {
        "entity_id": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "entity_type": {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "entity_type",
        "entity_id"
      ],
      "type": "object"
    },
    "blocking": {
      "type": "boolean"
    },
    "confidence": {
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
      "type": "string"
    },
    "evidence_references": {
      "items": {
        "maxLength": 512,
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "evidence_state": {
      "enum": [
        "PASS",
        "FAIL",
        "INSUFFICIENT_EVIDENCE",
        "STALE",
        "UNAVAILABLE",
        "NOT_APPLICABLE"
      ]
    },
    "exact_repository_revision": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "finding_id": {
      "pattern": "^DQF-[A-Z0-9-]{8,64}$",
      "type": "string"
    },
    "owner_role": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "remediation_condition": {
      "maxLength": 2000,
      "minLength": 1,
      "type": "string"
    },
    "rule_id": {
      "pattern": "^DQR-[A-Z0-9-]{3,64}$",
      "type": "string"
    },
    "sensitive_payload_included": {
      "const": false
    },
    "severity": {
      "enum": [
        "INFO",
        "LOW",
        "MEDIUM",
        "HIGH",
        "BLOCKER"
      ]
    },
    "source_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "status": {
      "enum": [
        "OPEN",
        "REMEDIATED",
        "VERIFIED",
        "ACCEPTED_RISK",
        "NOT_APPLICABLE"
      ]
    },
    "verification_condition": {
      "maxLength": 2000,
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "finding_id",
    "rule_id",
    "severity",
    "confidence",
    "status",
    "affected_entity",
    "evidence_references",
    "exact_repository_revision",
    "source_sha256",
    "owner_role",
    "remediation_condition",
    "verification_condition",
    "blocking",
    "evidence_state",
    "sensitive_payload_included"
  ],
  "title": "AIGC Analytics Data-Quality Finding",
  "type": "object"
}
