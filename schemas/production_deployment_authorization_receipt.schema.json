{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://aigc.local/schemas/production_deployment_authorization_receipt.schema.json","title":"AIGC Production Deployment Authorization Receipt v1","type":"object","additionalProperties":false,"required":["contract_id","contract_version","receipt_id","exact_revision","identifier_packet_digest","decision","reason_codes","approved_by_role","approved_by_name","issued_at","expires_at","release_id","release_candidate_digest","readiness_truth_digest","release_artifact_digest","production_project_reference","deployment_workload_identity_reference","domain_reference","database_reference","remote_state_reference","production_release_gate_receipt_id","production_release_gate_result","scope","single_use","operator_review_required","automatic_apply_allowed","staging_identity_authorized","external_action_performed"],"properties":{"contract_id":{"const":"AIGC-PRODUCTION-DEPLOYMENT-AUTHORIZATION-RECEIPT-001"},"contract_version":{"const":"1.0.0"},"receipt_id":{"type":"string","pattern":"^PDA-[A-Z0-9][A-Z0-9:-]{7,199}$"},"exact_revision":{"type":"string","pattern":"^[a-f0-9]{40}$"},"identifier_packet_digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},"decision":{"enum":["APPROVED","DENIED"]},"reason_codes":{"type":"array","maxItems":100,"uniqueItems":true,"items":{"type":"string","pattern":"^[A-Z][A-Z0-9_]{2,99}$"}},"approved_by_role":{"const":"ACCOUNTABLE_OPERATOR"},"approved_by_name":{"const":"Justice Gray Maciocha"},"issued_at":{"type":"string","format":"date-time"},"expires_at":{"type":"string","format":"date-time"},"release_id":{"type":"string","pattern":"^REL-[A-Z0-9][A-Z0-9-]{7,119}$"},"release_candidate_digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},"readiness_truth_digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},"release_artifact_digest":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"},"production_project_reference":{"type":"string","pattern":"^gcp_project://[a-z][a-z0-9-]{4,28}[a-z0-9]$"},"deplo