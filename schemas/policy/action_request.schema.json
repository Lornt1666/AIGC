{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aigc.local/schemas/policy/action_request.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_id",
    "actor_reference",
    "repository",
    "exact_repository_revision",
    "execution_surface",
    "requested_capability",
    "requested_authority",
    "action_class",
    "target_resource",
    "policy_version",
    "policy_bundle_digest",
    "emergency_stop_epoch",
    "evidence_references",
    "idempotency_key",
    "issued_at",
    "expires_at",
    "privacy_classification"
  ],
  "properties": {
    "request_id": {"type": "string"},
    "actor_reference": {"type": "object"},
    "repository": {"type": "string"},
    "exact_repository_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "execution_surface": {"type": "string"},
    "requested_capability": {"type": "string"},
    "requested_authority": {"type": "string"},
    "action_class": {"type": "string"},
    "target_resource": {"type": "string"},
    "approval_reference": {"type": ["object", "null"]},
    "policy_version": {"type": "string"},
    "policy_bundle_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "emergency_stop_epoch": {"type": "integer", "minimum": 0},
    "evidence_references": {"type": "array", "items": {"type": "string"}},
    "idempotency_key": {"type": "string"},
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "privacy_classification": {"enum": ["PUBLIC", "INTERNAL", "CONFIDENTIAL", "RESTRICTED"]}
  }
}
