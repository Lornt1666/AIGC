{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aigc.local/schemas/policy/policy_bundle.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["bundle_id", "version", "authority_class", "constitutional_authority", "default_decision", "rules", "bundle_sha256"],
  "properties": {
    "bundle_id": {"const": "AIGC-OMEGA-POLICY-BUNDLE-001"},
    "version": {"type": "string"},
    "authority_class": {"const": "policy"},
    "constitutional_authority": {"const": false},
    "default_decision": {"const": "DENY"},
    "rules": {"type": "array", "items": {"$ref": "policy_rule.schema.json"}},
    "bundle_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
