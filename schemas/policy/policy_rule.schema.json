{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aigc.local/schemas/policy/policy_rule.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["rule_id", "version", "effect", "action_classes", "reason_code", "priority", "active"],
  "properties": {
    "rule_id": {"type": "string", "pattern": "^PEL-[A-Z0-9-]+$"},
    "version": {"type": "string"},
    "effect": {"enum": ["DENY", "ALLOW_WITH_APPROVAL", "ALLOW"]},
    "action_classes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "reason_code": {"type": "string"},
    "priority": {"type": "integer", "minimum": 1, "maximum": 1000},
    "active": {"type": "boolean"},
    "constraints": {"type": "object"}
  }
}
