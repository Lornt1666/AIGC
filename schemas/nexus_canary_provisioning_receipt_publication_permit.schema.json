{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://regenexcalibur.invalid/schemas/nexus_canary_provisioning_receipt_publication_permit.schema.json",
  "title": "AIGC Canary Provisioning Receipt One-Use Publication Permit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "permit_id", "nonce", "receipt_kind",
    "receipt_schema_version", "repository", "project_id", "project_number",
    "region", "resource_prefix", "provider_id", "job_name", "execution_name",
    "release_sha", "release_tree_sha", "immutable_image_uri", "receipt_sha256",
    "receipt_content_sha256", "receipt_content_length", "receipt_bucket",
    "object_name", "content_type", "predecessor_kind", "predecessor_sha256",
    "governed_permit_schema_version", "governed_permit_id",
    "governed_permit_sha256", "authority_attestation_sha256",
    "maximum_mutations", "automatic_retry", "consumption_mode", "public_traffic",
    "live_model_call", "production_activation", "signer_principal",
    "publisher_principal", "source_principal", "kms_key_version", "signing_algorithm",
    "public_key_sha256", "issued_at", "not_before", "expires_at", "signature_b64"
  ],
  "properties": {
    "schema_version": {"const": "aigc.nexus-canary-provisioning-receipt-publication-permit.v1"},
    "permit_id": {"type": "string", "pattern": "^CPUB-P-[A-Z0-9_-]{8,56}$"},
    "nonce": {"$ref": "#/$defs/sha256"},
    "receipt_kind": {"const": "canary_job_provisioning"},
    "receipt_schema_version": {"const": "aigc.nexus-canary-job-provisioning-receipt.v1"},
    "repository": {"const": "Lornt1666/AIGC"},
    "project_id": {"$ref": "#/$defs/projectId"},
    "project_number": {"type": "string", "pattern": "^[0-9]{6,20}$"},
    "region": {"const": "northamerica-northeast1"},
    "resource_prefix": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,18}$"},
    "provider_id": {"$ref": "#/$defs/providerId"},
    "job_name": {"$ref": "#/$defs/jobName"},
    "execution_name": {"type": "null"},
    "release_sha": {"$ref": "#/$defs/gitSha"},
    "release_tree_sha": {"$ref": "#/$defs/gitSha"},
    "immutable_image_uri": {"$ref": "#/$defs/immutableImage"},
    "receipt_sha256": {"$ref": "#/$defs/sha256"},
    "receipt_content_sha256": {"$ref": "#/$defs/sha256"},
    "receipt_content_length": {"type": "integer", "minimum": 1, "maximum": 1048576},
    "receipt_bucket": {"$ref": "#/$defs/bucket"},
    "object_name": {
      "type": "string",
      "pattern": "^canary-provisioning-receipts/[a-f0-9]{40}/(google_vertex_gemini|openai_responses)/[a-z](?:[a-z0-9-]{0,61}[a-z0-9])?/[a-f0-9]{64}\\.json$"
    },
    "content_type": {"const": "application/json"},
    "predecessor_kind": {"const": "canary_deployment_receipt"},
    "predecessor_sha256": {"$ref": "#/$defs/sha256"},
    "governed_permit_schema_version": {"const": "aigc.nexus-canary-job-provisioning-permit.v1"},
    "governed_permit_id": {"type": "string", "pattern": "^CJP-[A-Z0-9_-]{8,64}$"},
    "governed_permit_sha256": {"$ref": "#/$defs/sha256"},
    "authority_attestation_sha256": {"type": "null"},
    "maximum_mutations": {"const": 1},
    "automatic_retry": {"const": false},
    "consumption_mode": {"const": "gcs_media_upload_if_generation_match_zero"},
    "public_traffic": {"const": false},
    "live_model_call": {"const": false},
    "production_activation": {"const": false},
    "signer_principal": {"$ref": "#/$defs/serviceAccount"},
    "publisher_principal": {"$ref": "#/$defs/serviceAccount"},
    "source_principal": {"$ref": "#/$defs/serviceAccount"},
    "kms_key_version": {"$ref": "#/$defs/kmsKeyVersion"},
    "signing_algorithm": {"const": "RSA_SIGN_PSS_2048_SHA256"},
    "public_key_sha256": {"$ref": "#/$defs/sha256"},
    "issued_at": {"type": "string", "format": "date-time"},
    "not_before": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "signature_b64": {"type": "string", "minLength": 32, "maxLength": 2048}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "gitSha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "projectId": {"type": "string", "pattern": "^[a-z][a-z0-9-]{4,28}[a-z0-9]$"},
    "providerId": {"enum": ["google_vertex_gemini", "openai_responses"]},
    "jobName": {"type": "string", "pattern": "^[a-z](?:[a-z0-9-]{0,61}[a-z0-9])?$"},
    "bucket": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,61}[a-z0-9]$"},
    "serviceAccount": {"type": "string", "pattern": "^[a-z][a-z0-9-]{4,28}[a-z0-9]@[a-z][a-z0-9-]{4,28}[a-z0-9]\\.iam\\.gserviceaccount\\.com$"},
    "immutableImage": {"type": "string", "pattern": "^[a-z0-9.-]+-docker\\.pkg\\.dev/[a-z0-9._/-]+@sha256:[a-f0-9]{64}$"},
    "kmsKeyVersion": {"type": "string", "pattern": "^projects/[a-z][a-z0-9-]{4,28}[a-z0-9]/locations/northamerica-northeast1/keyRings/[A-Za-z0-9_-]{1,63}/cryptoKeys/[A-Za-z0-9_-]{1,63}/cryptoKeyVersions/1$"}
  }
}
