{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://regenexcalibur.invalid/schemas/quebec_cloud_authorization.schema.json",
  "title": "AIGC Québec Cloud Authorization",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "environment", "provider", "repository", "project_id", "project_number", "billing_account_id", "billing_account_currency", "region", "region_name", "release_sha", "release_tree_sha", "resource_manifest_sha256", "model", "task_type", "data_classification", "rpo_minutes", "rto_hours", "costs", "resources", "service_accounts", "exact_secret_version_refs", "reviews", "authority", "codex_cloud_region_verified_canada", "local_laptop_required_for_runtime", "single_physical_server_dependency"],
  "properties": {
    "schema_version": {"const": "aigc.quebec-cloud-authorization.v1"},
    "environment": {"const": "STAGING"},
    "provider": {"const": "google_cloud"},
    "repository": {"const": "Lornt1666/AIGC"},
    "project_id": {"type": "string"},
    "project_number": {"type": "string"},
    "billing_account_id": {"type": "string"},
    "billing_account_currency": {"const": "CAD"},
    "region": {"const": "northamerica-northeast1"},
    "region_name": {"const": "Montréal, Québec, Canada"},
    "release_sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "release_tree_sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "resource_manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "model": {"type": "string", "minLength": 3},
    "task_type": {"enum": ["repository_only", "canadian_staging_plan", "canadian_staging_execution"]},
    "data_classification": {"const": "SANITIZED_NON_PERSONAL"},
    "rpo_minutes": {"type": "integer", "minimum": 1, "maximum": 60},
    "rto_hours": {"type": "integer", "minimum": 1, "maximum": 24},
    "costs": {"type": "object"},
    "resources": {"type": "object"},
    "service_accounts": {"type": "object"},
    "exact_secret_version_refs": {"type": "object"},
    "reviews": {"type": "object"},
    "authority": {"type": "object"},
    "codex_cloud_region_verified_canada": {"const": false},
    "local_laptop_required_for_runtime": {"const": false},
    "single_physical_server_dependency": {"const": false}
  }
}
