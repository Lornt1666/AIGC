{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://regenexcalibur.invalid/schemas/quebec_cloud_authorization.schema.json",
  "title": "AIGC Québec Cloud Authorization",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "environment", "provider", "repository", "project_id", "project_number", "billing_account_id", "billing_account_currency", "region", "region_name", "resource_prefix", "release_sha", "release_tree_sha", "resource_manifest_sha256", "authorization_inventory_sha256", "ci_admission_sha256", "model", "task_type", "data_classification", "rpo_minutes", "rto_hours", "costs", "resources", "service_accounts", "exact_secret_version_refs", "supply_chain", "reviews", "authority", "codex_cloud_region_verified_canada", "local_laptop_required_for_runtime", "single_physical_server_dependency"],
  "properties": {
    "schema_version": {"const": "aigc.quebec-cloud-authorization.v1"},
    "environment": {"const": "STAGING"},
    "provider": {"const": "google_cloud"},
    "repository": {"const": "Lornt1666/AIGC"},
    "project_id": {"type": "string"},
    "project_number": {"type": "string"},
    "billing_account_id": {"type": "string"},
    "billing_account_currency": {"const": "CAD"},
    "region": {"const": "northamerica-northeast1"},
    "region_name": {"const": "Montréal, Québec, Canada"},
    "resource_prefix": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,18}$"},
    "release_sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "release_tree_sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "resource_manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "authorization_inventory_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "ci_admission_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "model": {"type": "string", "minLength": 3},
    "task_type": {"enum": ["repository_only", "canadian_staging_plan", "canadian_staging_execution"]},
    "data_classification": {"const": "SANITIZED_NON_PERSONAL"},
    "rpo_minutes": {"type": "integer", "minimum": 1, "maximum": 60},
    "rto_hours": {"type": "integer", "minimum": 1, "maximum": 24},
    "costs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["currency", "estimated_one_time", "estimated_monthly", "maximum_monthly_ceiling", "budget_is_hard_cap"],
      "properties": {
        "currency": {"const": "CAD"},
        "estimated_one_time": {"type": ["number", "null"], "minimum": 0},
        "estimated_monthly": {"type": ["number", "null"], "minimum": 0},
        "maximum_monthly_ceiling": {"type": "number", "exclusiveMinimum": 0, "maximum": 200},
        "budget_is_hard_cap": {"const": false}
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_registry_repository", "operator_service", "judge_service", "cloud_sql_instance", "database_name", "evidence_bucket", "judge_bucket", "receipt_bucket", "build_source_bucket", "log_bucket", "kms_key_ring"],
      "properties": {
        "artifact_registry_repository": {"type": "string", "minLength": 1},
        "operator_service": {"type": "string", "minLength": 1},
        "judge_service": {"type": "string", "minLength": 1},
        "cloud_sql_instance": {"type": "string", "minLength": 1},
        "database_name": {"type": "string", "minLength": 1},
        "evidence_bucket": {"type": "string", "minLength": 1},
        "judge_bucket": {"type": "string", "minLength": 1},
        "receipt_bucket": {"type": "string", "minLength": 1},
        "build_source_bucket": {"type": "string", "minLength": 1},
        "log_bucket": {"type": "string", "minLength": 1},
        "kms_key_ring": {"type": "string", "minLength": 1}
      }
    },
    "service_accounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deployer", "cloud_build", "operator", "canary_gemini", "canary_openai", "canary_provisioner", "canary_binder", "canary_executor", "canary_publisher", "judge", "security_review", "authority_signer"],
      "properties": {
        "deployer": {"type": "string", "pattern": "^[a-z][a-z0-9-]{4,28}[a-z0-9]@[a-z][a-z0-9-]{4,28}[a-z0-9]\\.iam\\.gserviceaccount\\.com$"},
        "cloud_build": {"type": "string", "pattern": "^[a-z][a-z0-9-]{4,28}[a-z0-9]@[a-z][a-z0-9-]{4,28}[a-z0-9]\\.iam\\.gserviceaccount\\.com$"},
        "operator": {"type": "string", "pattern": "^[a-z][a-z0-9-]{4,28}[a-z0-9]@[a-z][a-z0-9-]{4,28}[a-z0-9]\\.iam\\.gserviceaccount\\.com$"},
        "canary_gemini": {"type": "string", "pattern": "^[a-z][a-z0-9-]{4,28}[a-z0-9]@[a-z][a-z0-9-]{4,28}[a-z0-9]\\.iam\\.gserviceaccount\\.com$"},
        "canary_openai": {"type": "string", "pattern": "^[a-z][a-z0-9-]{4,28}[a-z0-9]@[a-z][a-z0-9-]{4,28}[a-z0-9]\\.iam\\.gserviceaccount\\.com$"},
        "canary_provisioner": {"type": "string", "pattern": "^[a-z][a-z0-9-]{4,28}[a-z0-9]@[a-z][a-z0-9-]{4,28}[a-z0-9]\\.iam\\.gserviceaccount\\.com$"},
        "canary_binder": {"type": "string", "pattern": "^[a-z][a-z0-9-]{4,28}[a-z0-9]@[a-z][a-z0-9-]{4,28}[a-z0-9]\\.iam\\.gserviceaccount\\.com$"},
        "canary_executor": {"type": "string", "pattern": "^[a-z][a-z0-9-]{4,28}[a-z0-9]@[a-z][a-z0-9-]{4,28}[a-z0-9]\\.iam\\.gserviceaccount\\.com$"},
        "canary_publisher": {"type": "string", "pattern": "^[a-z][a-z0-9-]{4,28}[a-z0-9]@[a-z][a-z0-9-]{4,28}[a-z0-9]\\.iam\\.gserviceaccount\\.com$"},
        "judge": {"type": "string", "pattern": "^[a-z][a-z0-9-]{4,28}[a-z0-9]@[a-z][a-z0-9-]{4,28}[a-z0-9]\\.iam\\.gserviceaccount\\.com$"},
        "security_review": {"type": "string", "pattern": "^[a-z][a-z0-9-]{4,28}[a-z0-9]@[a-z][a-z0-9-]{4,28}[a-z0-9]\\.iam\\.gserviceaccount\\.com$"},
        "authority_signer": {"type": "string", "pattern": "^[a-z][a-z0-9-]{4,28}[a-z0-9]@[a-z][a-z0-9-]{4,28}[a-z0-9]\\.iam\\.gserviceaccount\\.com$"}
      }
    },
    "exact_secret_version_refs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime_control_dsn", "operator_token", "operator_binding_key", "runtime_admin_token", "runtime_admin_binding_key", "judge_token", "judge_binding_key"],
      "properties": {
        "runtime_control_dsn": {"$ref": "#/$defs/regionalSecretVersion"},
        "operator_token": {"$ref": "#/$defs/regionalSecretVersion"},
        "operator_binding_key": {"$ref": "#/$defs/regionalSecretVersion"},
        "runtime_admin_token": {"$ref": "#/$defs/regionalSecretVersion"},
        "runtime_admin_binding_key": {"$ref": "#/$defs/regionalSecretVersion"},
        "judge_token": {"$ref": "#/$defs/regionalSecretVersion"},
        "judge_binding_key": {"$ref": "#/$defs/regionalSecretVersion"}
      }
    },
    "supply_chain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["docker_builder_image", "python_base_image", "sbom_generator_image"],
      "properties": {
        "docker_builder_image": {"$ref": "#/$defs/immutableContainerImage"},
        "python_base_image": {"$ref": "#/$defs/immutableContainerImage"},
        "sbom_generator_image": {
          "type": "string",
          "pattern": "^(docker\\.io/)?anchore/syft@sha256:[a-f0-9]{64}$"
        }
      }
    },
    "reviews": {
      "type": "object",
      "required": ["cloud_run_montreal", "cloud_sql_montreal", "cloud_storage_montreal", "artifact_registry_montreal", "regional_secret_manager_montreal", "cloud_kms_montreal", "cloud_logging_montreal", "cloud_build_montreal", "gemini_model_montreal", "gemini_ml_processing_commitment_reviewed", "regional_endpoints_reviewed", "global_control_plane_metadata_reviewed", "legacy_github_credentials_reviewed_and_revoked_or_proven_inactive", "iam_least_privilege_reviewed", "no_service_account_keys_reviewed", "network_egress_reviewed", "backup_location_reviewed", "privacy_impact_assessment_completed", "cross_border_assessment_completed", "retention_and_deletion_reviewed", "incident_and_recovery_reviewed", "pricing_quote_reviewed"],
      "propertyNames": {"enum": ["cloud_run_montreal", "cloud_sql_montreal", "cloud_storage_montreal", "artifact_registry_montreal", "regional_secret_manager_montreal", "cloud_kms_montreal", "cloud_logging_montreal", "cloud_build_montreal", "gemini_model_montreal", "gemini_ml_processing_commitment_reviewed", "regional_endpoints_reviewed", "global_control_plane_metadata_reviewed", "legacy_github_credentials_reviewed_and_revoked_or_proven_inactive", "iam_least_privilege_reviewed", "no_service_account_keys_reviewed", "network_egress_reviewed", "backup_location_reviewed", "privacy_impact_assessment_completed", "cross_border_assessment_completed", "retention_and_deletion_reviewed", "incident_and_recovery_reviewed", "pricing_quote_reviewed"]},
      "additionalProperties": {"type": "boolean"}
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["configuration_reviewed", "resource_creation_authorized", "staging_deployment_authorized", "production_activation_authorized", "public_access_authorized", "live_model_call_authorized", "judge_publication_authorized", "devpost_submission_authorized", "gmail_send_authorized", "external_business_action_authorized", "financial_action_authorized", "cross_region_replication_authorized", "service_account_key_creation_authorized", "authorized_by", "authorized_at", "expires_at", "approval_phrase"],
      "properties": {
        "configuration_reviewed": {"type": "boolean"},
        "resource_creation_authorized": {"type": "boolean"},
        "staging_deployment_authorized": {"type": "boolean"},
        "production_activation_authorized": {"const": false},
        "public_access_authorized": {"const": false},
        "live_model_call_authorized": {"const": false},
        "judge_publication_authorized": {"const": false},
        "devpost_submission_authorized": {"const": false},
        "gmail_send_authorized": {"const": false},
        "external_business_action_authorized": {"const": false},
        "financial_action_authorized": {"const": false},
        "cross_region_replication_authorized": {"const": false},
        "service_account_key_creation_authorized": {"const": false},
        "authorized_by": {"type": "string"},
        "authorized_at": {"type": ["string", "null"]},
        "expires_at": {"type": ["string", "null"]},
        "approval_phrase": {"type": "string"}
      }
    },
    "codex_cloud_region_verified_canada": {"const": false},
    "local_laptop_required_for_runtime": {"const": false},
    "single_physical_server_dependency": {"const": false}
  },
  "$defs": {
    "immutableContainerImage": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*@sha256:[a-f0-9]{64}$"
    },
    "regionalSecretVersion": {
      "type": "string",
      "pattern": "^projects/[a-z][a-z0-9-]{4,28}[a-z0-9]/locations/northamerica-northeast1/secrets/[A-Za-z0-9_-]{1,255}/versions/[1-9][0-9]*$"
    }
  }
}
