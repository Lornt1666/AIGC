{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AIGC Secret Manifest",
  "type": "object",
  "required": [
    "project",
    "operator",
    "provider",
    "rules",
    "secrets"
  ],
  "properties": {
    "project": {
      "type": "string"
    },
    "operator": {
      "type": "string"
    },
    "provider": {
      "type": "string",
      "enum": [
        "google_cloud_secret_manager"
      ]
    },
    "store_raw_values": {
      "type": "boolean"
    },
    "rules": {
      "type": "object",
      "required": [
        "store_raw_secret_values_in_repo",
        "log_secret_values",
        "print_secret_values"
      ]
    },
    "secrets": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
