{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aigc.local/schemas/connector_action_approval.schema.json",
  "title": "AIGC Connector Action Approval v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id",
    "contract_version",
    "approval_id",
    "request_id",
    "request_digest",
    "exact_revision",
    "connector_id",
    "operation_id",
    "destination",
    "approval_scope",
    "decision",
    "approved_by_role",
    "reason",
    "issued_at",
    "expires_at",
    "external_action_performed"
  ],
  "properties": {
    "contract_id": {"const": "AIGC-CONNECTOR-ACTION-APPROVAL-001"},
    "contract_version": {"const": "1.0.0"},
    "approval_id": {"type": "string", "pattern": "^CAP-[A-F0-9]{24}$"},
    "request_id": {"type": "string", "pattern": "^CAR-[A-F0-9]{24}$"},
    "request_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "exact_revision": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "connector_id": {"enum": ["github", "google_drive", "gmail"]},
    "operation_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,79}$"},
    "destination": {"type": "string", "minLength": 1, "maxLength": 500},
    "approval_scope": {"type": "string", "minLength": 1, "maxLength": 120},
    "decision": {"enum": ["APPROVED", "DENIED"]},
    "approved_by_role": {"const": "ACCOUNTABLE_OPERATOR"},
    "reason": {"type": "string", "minLength": 1, "maxLength": 4000},
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "external_action_performed": {"const": false}
  }
}
