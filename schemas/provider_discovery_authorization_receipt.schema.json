{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://aigc.local/schemas/provider_discovery_authorization_receipt.schema.json","title":"AIGC Provider Discovery Authorization Receipt v1","type":"object","additionalProperties":false,"$defs":{"hex40":{"type":"string","pattern":"^[a-f0-9]{40}$"},"hex64":{"type":"string","pattern":"^[a-f0-9]{64}$"},"sha256":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"},"project_ref":{"type":"string","pattern":"^gcp_project://[a-z][a-z0-9-]{4,28}[a-z0-9]$"},"secret_ref":{"type":"string","pattern":"^gcp_secret://[a-z][a-z0-9-]{4,28}[a-z0-9]/[a-z][a-z0-9-]{2,254}/[1-9][0-9]*$"},"datetime":{"type":"string","format":"date-time"},"https_origin":{"type":"string","pattern":"^https://[A-Za-z0-9.-]+(?::[0-9]{2,5})?$"},"https_uri":{"type":"string","format":"uri","pattern":"^https://[A-Za-z0-9.-]+(?::[0-9]{2,5})?/[A-Za-z0-9._~!$&'()*+,;=:@%/-]*$"}},"required":["contract_id","contract_version","receipt_id","decision","reason_codes","approved_by_role","approved_by_name","exact_revision","procurement_pack_digest","phase","target_project_reference","allowed_actions","issued_at","expires_at","single_use","mutation_authorized","secret_value_access_authorized","operator_review_required","automatic_apply_allowed","provider_action_performed","external_action_performed"],"properties":{"contract_id":{"const":"AIGC-PROVIDER-DISCOVERY-AUTHORIZATION-RECEIPT-001"},"contract_version":{"const":"1.0.0"},"receipt_id":{"type":"string","pattern":"^SDA-[A-Z0-9][A-Z0-9:-]{7,199}$"},"decision":{"enum":["APPROVED","DENIED"]},"exact_revision":{"$ref":"#/$defs/hex40"},"procurement_pack_digest":{"$ref":"#/$defs/hex64"},"phase":{"const":"PROVIDER_DISCOVERY"},"target_project_reference":{"$ref":"#/$defs/project_ref"},"allowed_actions":{"type":"array","minItems":6,"maxItems":6,"uniqueItems":true,"items":{"enum":["READ_PROJECT_METADATA","READ_ENABLED_APIS","READ_EXISTING_IAM","READ_SERVICE_ACCOUNT_KEY_COUNTS","READ_STATE_BACKEND_METADATA","READ_IDENTITY_PLA