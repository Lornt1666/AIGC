{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://regenexcalibur.invalid/schemas/aigc_autopoietic_cycle_receipt.schema.json",
  "title": "AIGC Autopoietic Cycle Receipt V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "run_id",
    "phase",
    "terminal_status",
    "reason",
    "exact_repository_revision",
    "objective_sha256",
    "telemetry_sha256",
    "parent_state_sha256",
    "resulting_state_sha256",
    "previous_receipt_sha256",
    "proposed",
    "approved_for_shadow",
    "executed_in_shadow",
    "verified",
    "promoted_to_shadow",
    "rolled_back",
    "operator_action_required",
    "canonical_state_mutated",
    "external_action_performed",
    "network_calls_performed",
    "provider_calls_performed",
    "processes_spawned",
    "filesystem_writes_performed",
    "secrets_accessed",
    "logical_shadow_mutations",
    "resource_use",
    "events",
    "receipt_sha256"
  ],
  "properties": {
    "schema_version": {"const": "aigc.autopoietic-cycle-receipt.v1"},
    "receipt_id": {"type": "string", "pattern": "^ECO-RCPT-[A-Z0-9_-]{6,80}$"},
    "run_id": {"type": "string", "pattern": "^ECO-RUN-[A-Z0-9_-]{6,80}$"},
    "phase": {
      "enum": [
        "CREATED",
        "SENSED",
        "FORMULATED",
        "SYNTHESIZED",
        "VERIFIED",
        "AWAITING_OPERATOR",
        "INSTANTIATED_SHADOW",
        "PROMOTED_SHADOW",
        "ROLLED_BACK",
        "BLOCKED",
        "FAILED",
        "NO_CHANGE_REQUIRED"
      ]
    },
    "terminal_status": {"enum": ["PASS", "BLOCKED", "FAILED", "AWAITING_OPERATOR", "ROLLED_BACK"]},
    "reason": {"type": "string", "minLength": 3},
    "exact_repository_revision": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "objective_sha256": {"$ref": "#/$defs/sha256"},
    "telemetry_sha256": {"$ref": "#/$defs/sha256"},
    "parent_state_sha256": {"$ref": "#/$defs/sha256"},
    "resulting_state_sha256": {"$ref": "#/$defs/sha256"},
    "candidate_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "verification_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "previous_receipt_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "proposed": {"type": "boolean"},
    "approved_for_shadow": {"type": "boolean"},
    "executed_in_shadow": {"type": "boolean"},
    "verified": {"type": "boolean"},
    "promoted_to_shadow": {"type": "boolean"},
    "rolled_back": {"type": "boolean"},
    "operator_action_required": {"type": "boolean"},
    "canonical_state_mutated": {"const": false},
    "external_action_performed": {"const": false},
    "network_calls_performed": {"const": 0},
    "provider_calls_performed": {"const": 0},
    "processes_spawned": {"const": 0},
    "filesystem_writes_performed": {"const": 0},
    "secrets_accessed": {"const": 0},
    "logical_shadow_mutations": {"type": "integer", "minimum": 0},
    "resource_use": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operations", "compute_units", "peak_memory_mb", "output_bytes"],
      "properties": {
        "operations": {"type": "integer", "minimum": 0},
        "compute_units": {"type": "integer", "minimum": 0},
        "peak_memory_mb": {"type": "integer", "minimum": 0},
        "output_bytes": {"type": "integer", "minimum": 0}
      }
    },
    "events": {"type": "array", "items": {"type": "string"}, "maxItems": 128},
    "receipt_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
