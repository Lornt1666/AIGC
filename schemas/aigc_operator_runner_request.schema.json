{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://regenexcalibur.local/schemas/aigc_operator_runner_request.schema.json",
  "title": "RegenExcalibur AIGC ForgeRunner Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "repository",
    "target_sha",
    "expected_tree_sha",
    "trusted_base_sha",
    "broker_revision",
    "contract_path",
    "contract_sha256",
    "requested_stages",
    "approved_by",
    "approved_at",
    "expires_at",
    "human_execution_approved",
    "network_policy",
    "external_action_authorized",
    "production_activation_authorized",
    "provider_call_authorized",
    "secret_access_authorized"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "request_id": {"type": "string", "pattern": "^FORGE-[A-Z0-9-]{12,80}$"},
    "repository": {"const": "Lornt1666/AIGC"},
    "target_sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "expected_tree_sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "trusted_base_sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "broker_revision": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "contract_path": {"const": "config/aigc_operator_runner_contract.v1.json"},
    "contract_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "requested_stages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$"}
    },
    "approved_by": {"const": "RegenExcalibur / 1JGM"},
    "approved_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "human_execution_approved": {"const": true},
    "network_policy": {"const": "process_environment_guard"},
    "external_action_authorized": {"const": false},
    "production_activation_authorized": {"const": false},
    "provider_call_authorized": {"const": false},
    "secret_access_authorized": {"const": false}
  }
}
