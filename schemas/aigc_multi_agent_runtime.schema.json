{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aigc.local/schemas/aigc_multi_agent_runtime.schema.json",
  "title": "AIGC Multi-Agent Runtime Schema v1",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "metadata",
    "runtime",
    "contracts",
    "agents",
    "orchestration_flow",
    "release_gates",
    "output_format"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "kind": {
      "const": "AIGCMultiAgentRuntime"
    },
    "metadata": {
      "type": "object",
      "required": [
        "name",
        "owner",
        "status",
        "source_of_truth"
      ],
      "properties": {
        "name": {
          "const": "aigc-multi-agent-runtime"
        },
        "owner": {
          "const": "AIGC"
        },
        "status": {
          "enum": [
            "proposed",
            "validated",
            "approved"
          ]
        },
        "source_of_truth": {
          "type": "object",
          "required": [
            "policies",
            "approvals",
            "artifacts",
            "runtime_status"
          ]
        }
      }
    },
    "runtime": {
      "type": "object",
      "required": [
        "id",
        "mode",
        "execution_state",
        "scheduling",
        "defaults",
        "integrity_rules",
        "budgets",
        "state"
      ],
      "properties": {
        "id": {
          "const": "ultimate_orchestration_layer"
        },
        "mode": {
          "const": "plan_delegate_integrate"
        },
        "execution_state": {
          "enum": [
            "design_only",
            "validated",
            "authorized"
          ]
        },
        "scheduling": {
          "type": "object",
          "required": [
            "deterministic_tie_breaker",
            "allow_parallel_agents",
            "allow_sequential_agents",
            "require_declared_dependencies",
            "reject_cycles",
            "retry_side_effecting_work_automatically"
          ]
        },
        "defaults": {
          "type": "object",
          "required": [
            "external_side_effects_enabled",
            "agent_execution_enabled",
            "cloud_provisioning_enabled",
            "public_ingress_enabled",
            "business_cycle_enabled",
            "human_approval_required_for_release",
            "independent_verification_required",
            "fail_closed_on_unknown_state"
          ],
          "properties": {
            "external_side_effects_enabled": {
              "const": false
            },
            "agent_execution_enabled": {
              "const": false
            },
            "cloud_provisioning_enabled": {
              "const": false
            },
            "public_ingress_enabled": {
              "const": false
            },
            "business_cycle_enabled": {
              "const": false
            },
            "human_approval_required_for_release": {
              "const": true
            },
            "independent_verification_required": {
              "const": true
            },
            "fail_closed_on_unknown_state": {
              "const": true
            }
          }
        },
        "integrity_rules": {
          "type": "array",
          "minItems": 8,
          "uniqueItems": true
        },
        "budgets": {
          "type": "object",
          "required": [
            "max_parallel_tasks",
            "max_task_attempts",
            "max_wall_clock_seconds",
            "max_cost_cad",
            "max_tokens_per_agent"
          ],
          "properties": {
            "max_parallel_tasks": {
              "type": "integer",
              "minimum": 1,
              "maximum": 32
            },
            "max_task_attempts": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            "max_wall_clock_seconds": {
              "type": "integer",
              "minimum": 1
            },
            "max_cost_cad": {
              "type": "number",
              "minimum": 0
            },
            "max_tokens_per_agent": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "state": {
          "type": "object",
          "required": [
            "required_fields",
            "persistence",
            "local_state_allowed_for",
            "unknown_state_handling"
          ],
          "properties": {
            "required_fields": {
              "type": "array",
              "minItems": 5,
              "uniqueItems": true
            },
            "persistence": {
              "const": "authoritative_store_required_for_production"
            },
            "unknown_state_handling": {
              "const": "block_and_require_versioned_reconciliation"
            }
          }
        }
      }
    },
    "contracts": {
      "type": "object",
      "required": [
        "task_input",
        "agent_output",
        "artifact",
        "approval"
      ],
      "properties": {
        "task_input": {
          "type": "object",
          "required": [
            "required"
          ]
        },
        "agent_output": {
          "type": "object",
          "required": [
            "required",
            "statuses",
            "complete_requires"
          ]
        },
        "artifact": {
          "type": "object",
          "required": [
            "required",
            "mutable_overwrite_allowed"
          ],
          "properties": {
            "mutable_overwrite_allowed": {
              "const": false
            }
          }
        },
        "approval": {
          "type": "object",
          "required": [
            "required",
            "decisions",
            "stale_or_missing_evidence"
          ],
          "properties": {
            "decisions": {
              "type": "array",
              "contains": {
                "const": "approve"
              },
              "minItems": 3
            },
            "stale_or_missing_evidence": {
              "const": "reject"
            }
          }
        }
      }
    },
    "agents": {
      "type": "object",
      "required": [
        "planner",
        "coder",
        "reviewer",
        "security",
        "infra",
        "ops_deploy",
        "orchestrator"
      ],
      "properties": {
        "planner": {
          "type": "object",
          "required": [
            "id",
            "role",
            "type",
            "capabilities",
            "tools",
            "inputs",
            "outputs",
            "prompt"
          ],
          "properties": {
            "id": {
              "const": "planner"
            },
            "capabilities": {
              "type": "array",
              "minItems": 1
            },
            "tools": {
              "type": "array"
            },
            "inputs": {
              "type": "array",
              "minItems": 1
            },
            "outputs": {
              "type": "array",
              "minItems": 1
            },
            "prompt": {
              "type": "string",
              "minLength": 100
            }
          }
        },
        "coder": {
          "type": "object",
          "required": [
            "id",
            "role",
            "type",
            "capabilities",
            "tools",
            "inputs",
            "outputs",
            "prompt"
          ],
          "properties": {
            "id": {
              "const": "coder"
            },
            "capabilities": {
              "type": "array",
              "minItems": 1
            },
            "tools": {
              "type": "array"
            },
            "inputs": {
              "type": "array",
              "minItems": 1
            },
            "outputs": {
              "type": "array",
              "minItems": 1
            },
            "prompt": {
              "type": "string",
              "minLength": 100
            }
          }
        },
        "reviewer": {
          "type": "object",
          "required": [
            "id",
            "role",
            "type",
            "capabilities",
            "tools",
            "inputs",
            "outputs",
            "prompt"
          ],
          "properties": {
            "id": {
              "const": "reviewer"
            },
            "capabilities": {
              "type": "array",
              "minItems": 1
            },
            "tools": {
              "type": "array"
            },
            "inputs": {
              "type": "array",
              "minItems": 1
            },
            "outputs": {
              "type": "array",
              "minItems": 1
            },
            "prompt": {
              "type": "string",
              "minLength": 100
            }
          }
        },
        "security": {
          "type": "object",
          "required": [
            "id",
            "role",
            "type",
            "capabilities",
            "tools",
            "inputs",
            "outputs",
            "prompt"
          ],
          "properties": {
            "id": {
              "const": "security"
            },
            "capabilities": {
              "type": "array",
              "minItems": 1
            },
            "tools": {
              "type": "array"
            },
            "inputs": {
              "type": "array",
              "minItems": 1
            },
            "outputs": {
              "type": "array",
              "minItems": 1
            },
            "prompt": {
              "type": "string",
              "minLength": 100
            }
          }
        },
        "infra": {
          "type": "object",
          "required": [
            "id",
            "role",
            "type",
            "capabilities",
            "tools",
            "inputs",
            "outputs",
            "prompt"
          ],
          "properties": {
            "id": {
              "const": "infra"
            },
            "capabilities": {
              "type": "array",
              "minItems": 1
            },
            "tools": {
              "type": "array"
            },
            "inputs": {
              "type": "array",
              "minItems": 1
            },
            "outputs": {
              "type": "array",
              "minItems": 1
            },
            "prompt": {
              "type": "string",
              "minLength": 100
            }
          }
        },
        "ops_deploy": {
          "type": "object",
          "required": [
            "id",
            "role",
            "type",
            "capabilities",
            "tools",
            "inputs",
            "outputs",
            "prompt"
          ],
          "properties": {
            "id": {
              "const": "ops_deploy"
            },
            "capabilities": {
              "type": "array",
              "minItems": 1
            },
            "tools": {
              "type": "array"
            },
            "inputs": {
              "type": "array",
              "minItems": 1
            },
            "outputs": {
              "type": "array",
              "minItems": 1
            },
            "prompt": {
              "type": "string",
              "minLength": 100
            }
          }
        },
        "orchestrator": {
          "type": "object",
          "required": [
            "id",
            "role",
            "type",
            "capabilities",
            "tools",
            "inputs",
            "outputs",
            "prompt"
          ],
          "properties": {
            "id": {
              "const": "orchestrator"
            },
            "capabilities": {
              "type": "array",
              "minItems": 1
            },
            "tools": {
              "type": "array"
            },
            "inputs": {
              "type": "array",
              "minItems": 1
            },
            "outputs": {
              "type": "array",
              "minItems": 1
            },
            "prompt": {
              "type": "string",
              "minLength": 100
            }
          }
        }
      }
    },
    "orchestration_flow": {
      "type": "object",
      "required": [
        "id",
        "nodes",
        "edges",
        "join_policy",
        "terminal_states"
      ],
      "properties": {
        "nodes": {
          "type": "array",
          "minItems": 7,
          "uniqueItems": true
        },
        "edges": {
          "type": "array",
          "minItems": 7
        },
        "join_policy": {
          "type": "object",
          "required": [
            "orchestrator_requires",
            "failed_or_missing_agent_output",
            "mismatched_source_revision"
          ]
        },
        "terminal_states": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true
        }
      }
    },
    "release_gates": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "required": [
          "id",
          "requires"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "requires": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    },
    "output_format": {
      "type": "object",
      "required": [
        "fields",
        "status_vocabulary",
        "constraints"
      ],
      "properties": {
        "fields": {
          "type": "array",
          "minItems": 5,
          "uniqueItems": true
        },
        "status_vocabulary": {
          "type": "array",
          "contains": {
            "const": "BLOCKED"
          },
          "minItems": 4
        },
        "constraints": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true
        }
      }
    }
  }
}
