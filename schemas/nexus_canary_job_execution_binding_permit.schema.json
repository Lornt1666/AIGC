{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://regenexcalibur.invalid/schemas/nexus_canary_job_execution_binding_permit.schema.json",
  "title": "AIGC Canary Exact-Job Executor Binding Permit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "permit_id", "nonce", "repository", "project_id",
    "project_number", "region", "release_sha", "provider_id", "job_name",
    "target", "binder_principal", "executor_principal", "receipt_bucket",
    "provisioning_receipt_sha256", "role", "member", "condition_title",
    "condition_expression", "maximum_mutations", "automatic_retry",
    "consumption_mode", "project_wide_binding", "run_with_overrides_authorized",
    "kms_key_version", "signing_algorithm", "public_key_sha256", "issued_at",
    "not_before", "expires_at", "binding_expires_at", "signature_b64"
  ],
  "properties": {
    "schema_version": {"const": "aigc.nexus-canary-job-execution-binding-permit.v1"},
    "permit_id": {"type": "string", "pattern": "^CJB-[A-Z0-9_-]{8,64}$"},
    "nonce": {"$ref": "#/$defs/sha256"},
    "repository": {"const": "Lornt1666/AIGC"},
    "project_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{4,28}[a-z0-9]$"},
    "project_number": {"type": "string", "pattern": "^[0-9]{6,20}$"},
    "region": {"const": "northamerica-northeast1"},
    "release_sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "provider_id": {"enum": ["google_vertex_gemini", "openai_responses"]},
    "job_name": {"type": "string", "pattern": "^[a-z](?:[a-z0-9-]{0,61}[a-z0-9])?$"},
    "target": {"type": "string", "pattern": "^projects/[a-z][a-z0-9-]{4,28}[a-z0-9]/locations/northamerica-northeast1/jobs/[a-z](?:[a-z0-9-]{0,61}[a-z0-9])?$"},
    "binder_principal": {"$ref": "#/$defs/serviceAccount"},
    "executor_principal": {"$ref": "#/$defs/serviceAccount"},
    "receipt_bucket": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,61}[a-z0-9]$"},
    "provisioning_receipt_sha256": {"$ref": "#/$defs/sha256"},
    "role": {"const": "roles/run.invoker"},
    "member": {"type": "string", "pattern": "^serviceAccount:[a-z][a-z0-9-]{4,28}[a-z0-9]@[a-z][a-z0-9-]{4,28}[a-z0-9]\\.iam\\.gserviceaccount\\.com$"},
    "condition_title": {"type": "string", "pattern": "^aigc_canary_[a-z0-9_]{8,64}$"},
    "condition_expression": {"type": "string", "minLength": 30, "maxLength": 500},
    "maximum_mutations": {"const": 1},
    "automatic_retry": {"const": false},
    "consumption_mode": {"const": "gcs_if_generation_match_zero"},
    "project_wide_binding": {"const": false},
    "run_with_overrides_authorized": {"const": false},
    "kms_key_version": {"type": "string", "pattern": "^projects/[a-z][a-z0-9-]{4,28}[a-z0-9]/locations/northamerica-northeast1/keyRings/[A-Za-z0-9_-]{1,63}/cryptoKeys/[A-Za-z0-9_-]{1,63}/cryptoKeyVersions/[1-9][0-9]*$"},
    "signing_algorithm": {"const": "RSA_SIGN_PSS_2048_SHA256"},
    "public_key_sha256": {"$ref": "#/$defs/sha256"},
    "issued_at": {"type": "string", "format": "date-time"},
    "not_before": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "binding_expires_at": {"type": "string", "format": "date-time"},
    "signature_b64": {"type": "string", "minLength": 32, "maxLength": 2048}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "serviceAccount": {"type": "string", "pattern": "^[a-z][a-z0-9-]{4,28}[a-z0-9]@[a-z][a-z0-9-]{4,28}[a-z0-9]\\.iam\\.gserviceaccount\\.com$"}
  }
}
