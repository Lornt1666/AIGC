{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://aigc.local/schemas/production_release_operator_approval.schema.json","title":"AIGC Production Release Operator Approval v1","type":"object","additionalProperties":false,"required":["contract_id","contract_version","receipt_id","release_id","exact_revision","release_candidate_digest","decision","approved_by_role","reason","issued_at","expires_at","production_deployment_authorized","external_action_performed"],"properties":{"contract_id":{"const":"AIGC-PRODUCTION-RELEASE-OPERATOR-APPROVAL-001"},"contract_version":{"const":"1.0.0"},"receipt_id":{"type":"string","pattern":"^OPR-[A-Z0-9][A-Z0-9:-]{7,199}$"},"release_id":{"type":"string","pattern":"^REL-[A-Z0-9][A-Z0-9-]{7,119}$"},"exact_revision":{"type":"string","pattern":"^[a-f0-9]{40}$"},"release_candidate_digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},"decision":{"enum":["APPROVED","DENIED"]},"approved_by_role":{"const":"ACCOUNTABLE_OPERATOR"},"reason":{"type":"string","minLength":1,"maxLength":4000},"issued_at":{"type":"string","format":"date-time"},"expires_at":{"type":"string","format":"date-time"},"production_deployment_authorized":{"type":"boolean"},"external_action_performed":{"const":false}},"allOf":[{"if":{"properties":{"decision":{"const":"APPROVED"}}},"then":{"properties":{"production_deployment_authorized":{"const":true}}},"else":{"properties":{"production_deployment_authorized":{"const":false}}}}]}
