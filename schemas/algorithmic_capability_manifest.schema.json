{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AIGC Algorithmic Capability Manifest",
  "type": "object",
  "required": [
    "manifest_id",
    "status",
    "capability_count",
    "methodology_lenses",
    "capabilities",
    "forbidden_uses",
    "approval_boundary",
    "external_action_performed"
  ],
  "properties": {
    "manifest_id": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "capability_count": {
      "type": "integer"
    },
    "methodology_lenses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "capability_id",
          "name",
          "applies_to",
          "algorithm_family",
          "methodology_lenses",
          "ontology_targets",
          "input_contracts",
          "output_contracts",
          "allowed_uses",
          "forbidden_uses",
          "risk_controls",
          "tests_required",
          "requires_human_review",
          "external_action_allowed"
        ],
        "properties": {
          "capability_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "applies_to": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "algorithm_family": {
            "type": "string"
          },
          "methodology_lenses": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "ontology_targets": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "input_contracts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "output_contracts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "allowed_uses": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "forbidden_uses": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "risk_controls": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tests_required": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "requires_human_review": {
            "type": "boolean"
          },
          "external_action_allowed": {
            "type": "boolean"
          }
        },
        "additionalProperties": true
      }
    },
    "forbidden_uses": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "approval_boundary": {
      "type": "object"
    },
    "external_action_performed": {
      "type": "boolean"
    }
  },
  "additionalProperties": true
}
