{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aigc.justicegray.com/schemas/aigc_procurement_agent_catalog.schema.json",
  "title": "AIGC Procurement Sandbox Agent Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["catalog_version", "catalog_id", "human_summary", "seed_ref", "agent_count", "shared_assertions", "agents"],
  "properties": {
    "catalog_version": {"type": "string"},
    "catalog_id": {"type": "string"},
    "human_summary": {"type": "string"},
    "seed_ref": {"const": "config/procurement/edge_compute_seed.v1.json"},
    "agent_count": {"const": 13},
    "shared_assertions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["implementation_status", "model_evidence_status", "dataset_evidence_status", "effect_ceiling", "external_action_authorized", "external_action_performed"],
      "properties": {
        "implementation_status": {"const": "DESIGN_ONLY"},
        "model_evidence_status": {"const": "UNVERIFIED"},
        "dataset_evidence_status": {"const": "UNVERIFIED"},
        "effect_ceiling": {"const": "LOCAL_SIMULATION_ONLY"},
        "external_action_authorized": {"const": false},
        "external_action_performed": {"const": false}
      }
    },
    "agents": {
      "type": "array",
      "minItems": 13,
      "maxItems": 13,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["agent_id", "agent_type", "version", "model_family", "model_size_claim", "input", "output", "compute_profile", "latency_slo", "requested_capabilities", "safety_filters", "training_data_refs", "default_params"],
        "properties": {
          "agent_id": {"type": "string", "pattern": "^[a-z_]+\\.v[0-9]+$"},
          "agent_type": {"type": "string"},
          "version": {"type": "string"},
          "model_family": {"type": "string"},
          "model_size_claim": {"type": "string", "pattern": "unverified$"},
          "input": {"type": "object"},
          "output": {"type": "object"},
          "compute_profile": {"type": "object"},
          "latency_slo": {"type": "object", "required": ["p95_ms"]},
          "requested_capabilities": {"type": "array", "items": {"type": "string"}},
          "safety_filters": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "training_data_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["ref", "status"],
              "properties": {"ref": {"type": "string"}, "status": {"const": "UNVERIFIED"}}
            }
          },
          "default_params": {"type": "object"}
        }
      }
    }
  }
}
