{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://aigc.local/schemas/staging_identity_apply_authorization_receipt.schema.json",
  "title":"AIGC Staging Identity Apply Authorization Receipt v1",
  "type":"object","additionalProperties":false,
  "required":["contract_id","contract_version","receipt_id","exact_revision","procurement_pack_digest","plan_evidence_receipt_id","plan_evidence_digest","plan_artifact_digest","decision","reason_codes","approved_by_role","approved_by_name","issued_at","expires_at","phase","target_project_reference","planned_resources","planned_iam_delta","authorized_origins","authorized_redirect_uris","secret_references","scope","rollback_instructions","single_use","operator_review_required","automatic_apply_allowed","provider_action_performed","terraform_apply_performed","external_action_performed"],
  "properties":{
    "contract_id":{"const":"AIGC-STAGING-IDENTITY-APPLY-AUTHORIZATION-RECEIPT-001"},"contract_version":{"const":"1.0.0"},"receipt_id":{"type":"string","pattern":"^SIAPPLY-[A-Z0-9][A-Z0-9:-]{7,199}$"},"exact_revision":{"type":"string","pattern":"^[a-f0-9]{40}$"},"procurement_pack_digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},"plan_evidence_receipt_id":{"type":"string","pattern":"^SIPLANEV-[A-Z0-9][A-Z0-9:-]{7,199}$"},"plan_evidence_digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},"plan_artifact_digest":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"},
    "decision":{"enum":["APPROVED","DENIED"]},"reason_codes":{"type":"array","maxItems":100,"uniqueItems":true,"items":{"type":"string","pattern":"^[A-Z][A-Z0-9_]{2,99}$"}},"approved_by_role":{"const":"ACCOUNTABLE_OPERATOR"},"approved_by_name":{"const":"Justice Gray Maciocha"},"issued_at":{"type":"string","format":"date-time"},"expires_at":{"type":"string","format":"date-time"},"phase":{"enum":["STATE_BACKEND_BOOTSTRAP","STAGING_IDENTITY_CONFIGURATION"]},"target_project_reference":{"$ref":"#/$defs/project_reference"},
    "planned_resources":{"type":"array","minItems":1,"maxItems":200,"uniqueItems":true,"items":{"type":"string","pattern":"^[A-Za-z0-9._:/@-]{3,500}$"}},
    "planned_iam_delta":{"type":"array","maxItems":200,"items":{"type":"object","additionalProperties":false,"required":["action","role","principal_reference","resource_reference"],"properties":{"action":{"enum":["ADD","REMOVE"]},"role":{"type":"string","pattern":"^roles/[A-Za-z0-9_.]+$"},"principal_reference":{"type":"string","pattern":"^[A-Za-z0-9._:/@-]{3,500}$"},"resource_reference":{"type":"string","pattern":"^[A-Za-z0-9._:/@-]{3,500}$"}}}},
    "authorized_origins":{"type":"array","maxItems":20,"uniqueItems":true,"items":{"$ref":"#/$defs/origin"}},"authorized_redirect_uris":{"type":"array","maxItems":20,"uniqueItems":true,"items":{"$ref":"#/$defs/redirect"}},"secret_references":{"type":"array","maxItems":20,"uniqueItems":true,"items":{"anyOf":[{"$ref":"#/$defs/session_secret_reference"},{"$ref":"#/$defs/oauth_secret_reference"}]}},
    "scope":{"type":"object","additionalProperties":false,"required":["state_backend_bootstrap_authorized","identity_platform_configuration_authorized","workload_identity_configuration_authorized","oauth_provider_configuration_authorized","secret_container_creation_authorized","secret_version_creation_authorized","secret_value_access_authorized","test_subject_onboarding_authorized","staging_sign_in_authorized","production_identity_activation_authorized","production_deployment_authorized"],"properties":{"state_backend_bootstrap_authorized":{"type":"boolean"},"identity_platform_configuration_authorized":{"type":"boolean"},"workload_identity_configuration_authorized":{"type":"boolean"},"oauth_provider_configuration_authorized":{"type":"boolean"},"secret_container_creation_authorized":{"type":"boolean"},"secret_version_creation_authorized":{"type":"boolean"},"secret_value_access_authorized":{"type":"boolean"},"test_subject_onboarding_authorized":{"type":"boolean"},"staging_sign_in_authorized":{"type":"boolean"},"production_identity_activation_authorized":{"const":false},"production_deployment_authorized":{"const":false}}},
    "rollback_instructions":{"type":"string","minLength":20,"maxLength":4000},"single_use":{"const":true},"operator_review_required":{"const":true},"automatic_apply_allowed":{"const":false},"provider_action_performed":{"const":false},"terraform_apply_performed":{"const":false},"external_action_performed":{"const":false}
  },
  "allOf":[
    {"if":{"required":["decision"],"properties":{"decision":{"const":"APPROVED"}}},"then":{"properties":{"reason_codes":{"maxItems":0}}},"else":{"properties":{"reason_codes":{"minItems":1},"scope":{"properties":{"state_backend_bootstrap_authorized":{"const":false},"identity_platform_configuration_authorized":{"const":false},"workload_identity_configuration_authorized":{"const":false},"oauth_provider_configuration_authorized":{"const":false},"secret_container_creation_authorized":{"const":false},"secret_version_creation_authorized":{"const":false},"secret_value_access_authorized":{"const":false},"test_subject_onboarding_authorized":{"const":false},"staging_sign_in_authorized":{"const":false}}}}}},
    {"if":{"required":["phase","decision"],"properties":{"phase":{"const":"STATE_BACKEND_BOOTSTRAP"},"decision":{"const":"APPROVED"}}},"then":{"properties":{"scope":{"properties":{"state_backend_bootstrap_authorized":{"const":true},"identity_platform_configuration_authorized":{"const":false},"workload_identity_configuration_authorized":{"const":false},"oauth_provider_configuration_authorized":{"const":false},"secret_container_creation_authorized":{"const":false},"secret_version_creation_authorized":{"const":false},"secret_value_access_authorized":{"const":false},"test_subject_onboarding_authorized":{"const":false},"staging_sign_in_authorized":{"const":false}}}}}},
    {"if":{"required":["phase","decision"],"properties":{"phase":{"const":"STAGING_IDENTITY_CONFIGURATION"},"decision":{"const":"APPROVED"}}},"then":{"properties":{"scope":{"properties":{"state_backend_bootstrap_authorized":{"const":false}},"anyOf":[{"properties":{"identity_platform_configuration_authorized":{"const":true}}},{"properties":{"workload_identity_configuration_authorized":{"const":true}}},{"properties":{"oauth_provider_configuration_authorized":{"const":true}}},{"properties":{"secret_container_creation_authorized":{"const":true}}},{"properties":{"secret_version_creation_authorized":{"const":true}}},{"properties":{"secret_value_access_authorized":{"const":true}}},{"properties":{"test_subject_onboarding_authorized":{"const":true}}},{"properties":{"staging_sign_in_authorized":{"const":true}}}]}}}}
  ],
  "$defs":{"project_reference":{"type":"string","pattern":"^gcp_project://[a-z][a-z0-9-]{4,28}[a-z0-9]$"},"origin":{"type":"string","pattern":"^https://[A-Za-z0-9.-]+(?::[0-9]{2,5})?$"},"redirect":{"type":"string","format":"uri","pattern":"^https://[A-Za-z0-9.-]+(?::[0-9]{2,5})?/[A-Za-z0-9._~!$&'()*+,;=:@%/-]*$"},"session_secret_reference":{"type":"string","pattern":"^gcp_secret://[a-z][a-z0-9-]{4,28}[a-z0-9]/aigc-session-pepper/[1-9][0-9]*$"},"oauth_secret_reference":{"type":"string","pattern":"^gcp_secret://[a-z][a-z0-9-]{4,28}[a-z0-9]/aigc-google-oauth-client-secret/[1-9][0-9]*$"}}
}
