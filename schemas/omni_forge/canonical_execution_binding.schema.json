{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://regenexcalibur.invalid/schemas/omni_forge/canonical_execution_binding.schema.json",
  "title": "OMNI-FORGE Canonical AIGC Execution Binding Metadata",
  "description": "Deterministic identifier binding from the OMNI-FORGE execution substrate to the canonical AIGC Digital Work Colosseum domain.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "binding_schema_version",
    "employer_id",
    "employer_vault_id",
    "engagement_id",
    "work_order_id",
    "task_id",
    "agent_cell_id",
    "swarm_id",
    "deliverable_id",
    "verification_id",
    "capability_evidence_id",
    "compute_requirement_id",
    "output_schema_id",
    "repository_sha",
    "repository_tree_sha",
    "idempotency_key_digest"
  ],
  "properties": {
    "binding_schema_version": {"const": "1.0.0"},
    "employer_id": {"type": "string", "minLength": 1},
    "employer_vault_id": {"type": "string", "minLength": 1},
    "engagement_id": {"type": "string", "minLength": 1},
    "work_order_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "agent_cell_id": {"type": "string", "minLength": 1},
    "swarm_id": {"type": "string", "minLength": 1},
    "deliverable_id": {"type": "string", "minLength": 1},
    "verification_id": {"type": "string", "minLength": 1},
    "capability_evidence_id": {"type": "string", "minLength": 1},
    "compute_requirement_id": {"type": "string", "minLength": 1},
    "output_schema_id": {"type": "string", "minLength": 1},
    "repository_sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "repository_tree_sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "idempotency_key_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
