{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AIGC Sub-Agent Team Plan",
  "type": "object",
  "required": [
    "team_id",
    "created_at",
    "phase",
    "status",
    "opportunity_id",
    "proposal_id",
    "title",
    "employer",
    "team_members",
    "approval_required_before_external_action",
    "external_action_performed"
  ],
  "properties": {
    "team_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "phase": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "opportunity_id": {
      "type": "string"
    },
    "proposal_id": {
      "type": "string"
    },
    "dossier_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "employer": {
      "type": "string"
    },
    "source_platform": {
      "type": "string"
    },
    "source_url": {
      "type": "string"
    },
    "readiness_decision": {
      "type": "string"
    },
    "taxonomy": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "team_members": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "handoff_sequence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "required_approval_gates": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "forbidden_team_behaviors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "quality_bar": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "approval_required_before_external_action": {
      "type": "boolean"
    },
    "external_action_performed": {
      "type": "boolean"
    }
  },
  "additionalProperties": true
}
