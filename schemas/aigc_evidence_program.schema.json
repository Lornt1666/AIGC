{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aigc.local/schemas/aigc_evidence_program.schema.json",
  "title": "AIGC Evidence Program",
  "type": "object",
  "required": ["schema_version", "program_id", "evidence_scope", "registry_sha256", "legacy_readiness", "receipt_resolved_readiness", "coverage", "gates", "program_sha256", "production_ready", "authority_granted", "external_action_performed"],
  "properties": {
    "schema_version": {"const": "aigc.evidence-program.v1"},
    "program_id": {"const": "AIGC-EVIDENCE-PROGRAM-V1"},
    "evidence_scope": {"const": "LOCAL_LEDGER_AND_EXTERNAL_REQUESTS_NO_EXTERNAL_EXECUTION"},
    "registry_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "program_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "production_ready": {"const": false},
    "authority_granted": {"const": false},
    "external_action_performed": {"const": false},
    "legacy_readiness": {"type": "object"},
    "receipt_resolved_readiness": {
      "type": "object",
      "required": ["applicable_required_checks", "verified_required_checks", "verified_applicable_ratio"],
      "properties": {
        "applicable_required_checks": {"type": "integer", "minimum": 0},
        "verified_required_checks": {"type": "integer", "minimum": 0},
        "verified_applicable_ratio": {"type": "number", "minimum": 0, "maximum": 1}
      },
      "additionalProperties": false
    },
    "coverage": {"type": "object"},
    "gates": {
      "type": "array",
      "items": {"$ref": "#/$defs/gate"}
    }
  },
  "$defs": {
    "gate": {
      "type": "object",
      "required": ["gate_id", "category", "subject_id", "requirement", "required_for_v1", "counts_toward_readiness", "status", "receipt_resolved", "acceptance_criteria", "narrative", "request_packet_id"],
      "properties": {
        "gate_id": {"type": "string", "minLength": 3},
        "category": {"enum": ["prerequisite", "subsystem", "surface", "connector", "authority"]},
        "subject_id": {"type": "string", "minLength": 1},
        "requirement": {"type": "string", "minLength": 1},
        "required_for_v1": {"type": "boolean"},
        "counts_toward_readiness": {"type": "boolean"},
        "status": {"enum": ["VERIFIED_LOCAL", "VERIFIED_EXTERNAL", "BLOCKED_EXTERNAL", "DEFERRED_NOT_REQUIRED", "ASSERTED_CONFIG_ONLY", "UNVERIFIED", "UNRESOLVED_RECEIPT"]},
        "receipt_ref": {"type": ["string", "null"]},
        "receipt_resolved": {"type": "boolean"},
        "artifact": {"type": ["object", "null"]},
        "acceptance_criteria": {"type": "array", "minItems": 2, "items": {"type": "string"}},
        "narrative": {"type": "string", "minLength": 10},
        "request_packet_id": {"type": ["string", "null"]}
      }
    }
  }
}
