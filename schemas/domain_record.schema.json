{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AIGC Domain Record",
  "type": "object",
  "required": [
    "domain_id",
    "name",
    "status"
  ],
  "properties": {
    "domain_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "risk_level": {
      "type": "string"
    },
    "allowed_sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "forbidden_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
