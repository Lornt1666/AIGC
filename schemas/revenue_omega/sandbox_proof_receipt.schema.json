{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aigc:revenue-omega:sandbox-proof-receipt:v1",
  "title": "AIGC Revenue-Ω Sandbox Proof Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "agreement_hash",
    "jurisdiction_decision_hash",
    "placement_hash",
    "billing_decision_hash",
    "calculation_hash",
    "invoice_hash",
    "invoice_document_hash",
    "email_receipt_hash",
    "payment_session_receipt_hash",
    "payment_receipt_hash",
    "issuance_ledger_hash",
    "settlement_ledger_hash",
    "final_invoice_state",
    "total",
    "currency",
    "network_call_performed",
    "real_money_moved",
    "external_action_performed",
    "proof_hash"
  ],
  "properties": {
    "status": {"const": "SANDBOX_SETTLED"},
    "agreement_hash": {"$ref": "#/$defs/hash"},
    "jurisdiction_decision_hash": {"$ref": "#/$defs/hash"},
    "placement_hash": {"$ref": "#/$defs/hash"},
    "billing_decision_hash": {"$ref": "#/$defs/hash"},
    "calculation_hash": {"$ref": "#/$defs/hash"},
    "invoice_hash": {"$ref": "#/$defs/hash"},
    "invoice_document_hash": {"$ref": "#/$defs/hash"},
    "email_receipt_hash": {"$ref": "#/$defs/hash"},
    "payment_session_receipt_hash": {"$ref": "#/$defs/hash"},
    "payment_receipt_hash": {"$ref": "#/$defs/hash"},
    "issuance_ledger_hash": {"$ref": "#/$defs/hash"},
    "settlement_ledger_hash": {"$ref": "#/$defs/hash"},
    "final_invoice_state": {"const": "SETTLED"},
    "total": {"type": "string", "pattern": "^[0-9]+\\.[0-9]{2}$"},
    "currency": {"const": "CAD"},
    "network_call_performed": {"const": false},
    "real_money_moved": {"const": false},
    "external_action_performed": {"const": false},
    "proof_hash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
