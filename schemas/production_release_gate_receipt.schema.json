{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://aigc.local/schemas/production_release_gate_receipt.schema.json","title":"AIGC Production Release Gate Receipt v1","type":"object","additionalProperties":false,"required":["contract_id","contract_version","gate_receipt_id","release_id","exact_revision","result","reason_codes","actual_readiness_score","required_readiness_score","actual_blocking_gaps","manifest_digest","release_candidate_digest","readiness_truth_digest","release_artifact_digest","operator_approval_receipt_id","deployment_authorized","evaluated_at","external_action_performed"],"properties":{"contract_id":{"const":"AIGC-PRODUCTION-RELEASE-GATE-RECEIPT-001"},"contract_version":{"const":"1.0.0"},"gate_receipt_id":{"type":"string","pattern":"^PRG-[A-F0-9]{24}$"},"release_id":{"type":"string","pattern":"^REL-[A-Z0-9][A-Z0-9-]{7,119}$"},"exact_revision":{"type":"string","minLength":1,"maxLength":80},"result":{"enum":["PERMIT","DENY"]},"reason_codes":{"type":"array","maxItems":100,"uniqueItems":true,"items":{"type":"string","pattern":"^[A-Z][A-Z0-9_]{2,99}$"}},"actual_readiness_score":{"type":"number","minimum":0,"maximum":100},"required_readiness_score":{"type":"number","minimum":90,"maximum":100},"actual_blocking_gaps":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1,"maxLength":200}},"manifest_digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},"release_candidate_digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},"readiness_truth_digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},"release_artifact_digest":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"},"operator_approval_receipt_id":{"type":["string","null"],"maxLength":200},"deployment_authorized":{"type":"boolean"},"evaluated_at":{"type":"string","format":"date-time"},"external_action_performed":{"const":false}},"allOf":[{"if":{"properties":{"result":{"const":"PERMIT"}}},"then":{"properties":{"reason_codes":{"maxItems":0},"actual_blocking_gaps":{"maxItems":0},"deployment_authorized":{"const":true},"operator_approval_receipt_id":{"type":"string"}}},"else":{"properties":{"reason_codes":{"minItems":1},"deployment_authorized":{"const":false}}}}]}
