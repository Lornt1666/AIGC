{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aigc.local/schemas/save_credential_broker_packet.schema.json",
  "title": "AIGC Save Credential Broker Packet",
  "type": "object",
  "required": [
    "phase",
    "generated_at",
    "status",
    "flow",
    "approved_vault_targets",
    "broker_popup_fields",
    "credential_reference_inspector",
    "safety_result",
    "summary"
  ],
  "properties": {
    "phase": {"type": "string", "enum": ["save_credential_broker_procurement"]},
    "generated_at": {"type": "string"},
    "status": {"type": "string", "enum": ["completed_save_credential_broker_procurement"]},
    "purpose": {"type": "string"},
    "flow": {"type": "array", "items": {"type": "string"}},
    "approved_vault_targets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "payload_storage_location", "aigc_artifact_payload_storage_allowed"],
        "properties": {
          "id": {"type": "string"},
          "label": {"type": "string"},
          "purpose": {"type": "string"},
          "allowed_for_cloud_workflows": {"type": "boolean"},
          "allowed_for_local_development": {"type": "boolean"},
          "payload_storage_location": {"type": "string"},
          "aigc_artifact_payload_storage_allowed": {"type": "boolean", "enum": [false]}
        },
        "additionalProperties": true
      }
    },
    "broker_popup_fields": {"type": "array", "items": {"type": "string"}},
    "credential_reference_inspector": {
      "type": "object",
      "required": ["shortcut", "label", "allowed_display", "payload_display_allowed", "plaintext_viewer_allowed"],
      "properties": {
        "shortcut": {"type": "string"},
        "label": {"type": "string"},
        "allowed_display": {"type": "array", "items": {"type": "string"}},
        "payload_display_allowed": {"type": "boolean", "enum": [false]},
        "plaintext_viewer_allowed": {"type": "boolean", "enum": [false]}
      },
      "additionalProperties": true
    },
    "audit_events": {"type": "array", "items": {"type": "string"}},
    "safety_result": {
      "type": "object",
      "required": [
        "payload_written_to_repo",
        "payload_written_to_artifacts",
        "payload_written_to_logs",
        "payload_displayed_in_ui",
        "proceed_requires_reference_presence",
        "nothing_silently_submits"
      ],
      "properties": {
        "payload_written_to_repo": {"type": "boolean", "enum": [false]},
        "payload_written_to_artifacts": {"type": "boolean", "enum": [false]},
        "payload_written_to_logs": {"type": "boolean", "enum": [false]},
        "payload_displayed_in_ui": {"type": "boolean", "enum": [false]},
        "proceed_requires_reference_presence": {"type": "boolean", "enum": [true]},
        "nothing_silently_submits": {"type": "boolean", "enum": [true]}
      },
      "additionalProperties": true
    },
    "summary": {
      "type": "object",
      "properties": {
        "vault_targets": {"type": "integer"},
        "flow_steps": {"type": "integer"},
        "audit_event_types": {"type": "integer"},
        "payload_written_to_repo": {"type": "boolean", "enum": [false]},
        "payload_written_to_artifacts": {"type": "boolean", "enum": [false]},
        "payload_written_to_logs": {"type": "boolean", "enum": [false]},
        "payload_displayed_in_ui": {"type": "boolean", "enum": [false]},
        "external_action_performed": {"type": "boolean", "enum": [false]},
        "nothing_silently_submits": {"type": "boolean", "enum": [true]}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
