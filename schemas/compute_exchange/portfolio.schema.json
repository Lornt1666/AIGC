{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://regenexcalibur.invalid/schemas/compute_exchange/portfolio.schema.json",
  "title": "AIGC Compute Exchange Portfolio",
  "type": "object",
  "additionalProperties": false,
  "required": ["portfolio", "prediction"],
  "properties": {
    "portfolio": {"$ref": "#/$defs/executionPortfolio"},
    "prediction": {"$ref": "#/$defs/portfolioPrediction"},
    "observations": {"type": "array", "items": {"$ref": "#/$defs/computePerformanceObservation"}},
    "outcome": {"$ref": "#/$defs/portfolioOutcome"}
  },
  "$defs": {
    "nonEmptyString": {"type": "string", "minLength": 1},
    "resourceType": {"enum": ["LOCAL_CPU", "LOCAL_GPU", "APPLE_NEURAL_ENGINE", "CORE_ML", "METAL", "CLOUD_CPU", "CLOUD_GPU", "SERVERLESS", "BATCH", "AI_MODEL", "THIRD_PARTY_API", "DETERMINISTIC_TOOL"]},
    "computeAdmission": {"enum": ["ADMISSIBLE", "NOT_ADMISSIBLE", "REQUIRES_HUMAN_REVIEW"]},
    "confidentialityClass": {"enum": ["PUBLIC", "INTERNAL", "CONFIDENTIAL", "RESTRICTED"]},
    "computeRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirement_id", "workload_class", "minimum_quality", "minimum_reliability", "minimum_availability", "minimum_security_level", "minimum_privacy_level", "maximum_latency_ms", "maximum_cost_cad", "confidentiality_class", "allowed_jurisdictions", "license_must_allow_commercial_use"],
      "properties": {
        "requirement_id": {"$ref": "#/$defs/nonEmptyString"},
        "workload_class": {"$ref": "#/$defs/nonEmptyString"},
        "minimum_quality": {"type": "number", "minimum": 0, "maximum": 1},
        "minimum_reliability": {"type": "number", "minimum": 0, "maximum": 1},
        "minimum_availability": {"type": "number", "minimum": 0, "maximum": 1},
        "minimum_security_level": {"type": "integer", "minimum": 0, "maximum": 3},
        "minimum_privacy_level": {"type": "integer", "minimum": 0, "maximum": 3},
        "maximum_latency_ms": {"type": "integer", "minimum": 0},
        "maximum_cost_cad": {"type": "number", "minimum": 0},
        "confidentiality_class": {"$ref": "#/$defs/confidentialityClass"},
        "allowed_jurisdictions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/nonEmptyString"}},
        "allowed_providers": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/nonEmptyString"}},
        "prohibited_providers": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/nonEmptyString"}},
        "required_capabilities": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/nonEmptyString"}},
        "license_must_allow_commercial_use": {"type": "boolean"}
      }
    },
    "computeCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "provider", "resource_type", "model_or_runtime", "region", "jurisdiction", "confidentiality_capability", "security_level", "privacy_level", "encryption", "estimated_cost_cad", "estimated_latency_ms", "predicted_quality", "predicted_reliability", "availability", "commercial_use_allowed", "benchmark_evidence_refs", "capabilities", "admission", "rejection_reasons"],
      "properties": {
        "candidate_id": {"$ref": "#/$defs/nonEmptyString"},
        "provider": {"$ref": "#/$defs/nonEmptyString"},
        "resource_type": {"$ref": "#/$defs/resourceType"},
        "model_or_runtime": {"$ref": "#/$defs/nonEmptyString"},
        "region": {"$ref": "#/$defs/nonEmptyString"},
        "jurisdiction": {"$ref": "#/$defs/nonEmptyString"},
        "confidentiality_capability": {"$ref": "#/$defs/confidentialityClass"},
        "security_level": {"type": "integer", "minimum": 0, "maximum": 3},
        "privacy_level": {"type": "integer", "minimum": 0, "maximum": 3},
        "encryption": {"$ref": "#/$defs/nonEmptyString"},
        "estimated_cost_cad": {"type": "number", "minimum": 0},
        "estimated_latency_ms": {"type": "integer", "minimum": 0},
        "predicted_quality": {"type": "number", "minimum": 0, "maximum": 1},
        "predicted_reliability": {"type": "number", "minimum": 0, "maximum": 1},
        "availability": {"type": "number", "minimum": 0, "maximum": 1},
        "commercial_use_allowed": {"type": "boolean"},
        "benchmark_evidence_refs": {"type": "array", "items": {"$ref": "#/$defs/nonEmptyString"}},
        "capabilities": {"type": "array", "items": {"$ref": "#/$defs/nonEmptyString"}},
        "admission": {"$ref": "#/$defs/computeAdmission"},
        "rejection_reasons": {"type": "array", "items": {"$ref": "#/$defs/nonEmptyString"}}
      },
      "allOf": [
        {"if": {"properties": {"admission": {"const": "NOT_ADMISSIBLE"}}, "required": ["admission"]}, "then": {"properties": {"rejection_reasons": {"minItems": 1}}}},
        {"if": {"properties": {"admission": {"const": "ADMISSIBLE"}}, "required": ["admission"]}, "then": {"properties": {"rejection_reasons": {"maxItems": 0}, "benchmark_evidence_refs": {"minItems": 1}}}}
      ]
    },
    "executionPortfolio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["portfolio_id", "work_order_id", "requirement_ids", "candidate_ids", "stage_order", "fallback_candidate_ids", "employer_policy_id", "verification_route_id", "predicted_total_cost_cad", "admitted"],
      "properties": {
        "portfolio_id": {"$ref": "#/$defs/nonEmptyString"},
        "work_order_id": {"$ref": "#/$defs/nonEmptyString"},
        "requirement_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/nonEmptyString"}},
        "candidate_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/nonEmptyString"}},
        "stage_order": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonEmptyString"}},
        "fallback_candidate_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/nonEmptyString"}},
        "employer_policy_id": {"$ref": "#/$defs/nonEmptyString"},
        "verification_route_id": {"$ref": "#/$defs/nonEmptyString"},
        "predicted_total_cost_cad": {"type": "number", "minimum": 0},
        "admitted": {"type": "boolean"}
      }
    },
    "portfolioPrediction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prediction_id", "portfolio_id", "predicted_quality", "predicted_acceptance_probability", "predicted_completion_probability", "predicted_verification_pass_probability", "predicted_deadline_confidence", "predicted_cost_cad", "predicted_latency_ms", "assumptions"],
      "properties": {
        "prediction_id": {"$ref": "#/$defs/nonEmptyString"},
        "portfolio_id": {"$ref": "#/$defs/nonEmptyString"},
        "predicted_quality": {"type": "number", "minimum": 0, "maximum": 1},
        "predicted_acceptance_probability": {"type": "number", "minimum": 0, "maximum": 1},
        "predicted_completion_probability": {"type": "number", "minimum": 0, "maximum": 1},
        "predicted_verification_pass_probability": {"type": "number", "minimum": 0, "maximum": 1},
        "predicted_deadline_confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "predicted_cost_cad": {"type": "number", "minimum": 0},
        "predicted_latency_ms": {"type": "integer", "minimum": 0},
        "predicted_token_usage": {"type": ["integer", "null"], "minimum": 0},
        "predicted_cpu_seconds": {"type": ["integer", "null"], "minimum": 0},
        "predicted_gpu_seconds": {"type": ["integer", "null"], "minimum": 0},
        "assumptions": {"type": "array", "items": {"$ref": "#/$defs/nonEmptyString"}}
      }
    },
    "computePerformanceObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observation_id", "portfolio_id", "candidate_id", "observed_at", "evidence_refs"],
      "properties": {
        "observation_id": {"$ref": "#/$defs/nonEmptyString"},
        "portfolio_id": {"$ref": "#/$defs/nonEmptyString"},
        "candidate_id": {"$ref": "#/$defs/nonEmptyString"},
        "observed_at": {"type": "string", "format": "date-time"},
        "actual_cost_cad": {"type": ["number", "null"], "minimum": 0},
        "actual_latency_ms": {"type": ["integer", "null"], "minimum": 0},
        "actual_quality": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "actual_token_usage": {"type": ["integer", "null"], "minimum": 0},
        "actual_cpu_seconds": {"type": ["integer", "null"], "minimum": 0},
        "actual_gpu_seconds": {"type": ["integer", "null"], "minimum": 0},
        "verification_passed": {"type": ["boolean", "null"]},
        "jurisdiction_receipt_ref": {"type": ["string", "null"]},
        "evidence_refs": {"type": "array", "items": {"$ref": "#/$defs/nonEmptyString"}}
      }
    },
    "portfolioOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome_id", "portfolio_id", "delivered", "verification_passed", "employer_accepted", "revision_count", "actual_total_cost_cad", "deadline_met", "observed_quality", "security_incident", "privacy_incident", "confidentiality_incident", "evidence_refs"],
      "properties": {
        "outcome_id": {"$ref": "#/$defs/nonEmptyString"},
        "portfolio_id": {"$ref": "#/$defs/nonEmptyString"},
        "delivered": {"type": "boolean"},
        "verification_passed": {"type": "boolean"},
        "employer_accepted": {"type": ["boolean", "null"]},
        "revision_count": {"type": "integer", "minimum": 0},
        "actual_total_cost_cad": {"type": ["number", "null"], "minimum": 0},
        "deadline_met": {"type": ["boolean", "null"]},
        "observed_quality": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "security_incident": {"type": "boolean"},
        "privacy_incident": {"type": "boolean"},
        "confidentiality_incident": {"type": "boolean"},
        "evidence_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonEmptyString"}}
      }
    }
  }
}
