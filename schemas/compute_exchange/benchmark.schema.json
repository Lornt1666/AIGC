{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://regenexcalibur.invalid/schemas/compute_exchange/benchmark.schema.json",
  "title": "AIGC Compute Benchmark",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "benchmark_id",
    "workload_class",
    "provider",
    "resource_identity",
    "resource_version",
    "environment_id",
    "jurisdiction",
    "fixture_digest",
    "measured_quality",
    "verification_passed",
    "latency_ms_p50",
    "latency_ms_p95",
    "observed_cost_cad",
    "sample_count",
    "measured_at",
    "evidence_refs"
  ],
  "properties": {
    "benchmark_id": {"type": "string", "minLength": 1},
    "workload_class": {"type": "string", "minLength": 1},
    "provider": {"type": "string", "minLength": 1},
    "resource_identity": {"type": "string", "minLength": 1},
    "resource_version": {"type": "string", "minLength": 1},
    "environment_id": {"type": "string", "minLength": 1},
    "jurisdiction": {"type": "string", "minLength": 1},
    "fixture_digest": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "measured_quality": {"type": "number", "minimum": 0, "maximum": 1},
    "verification_passed": {"type": "boolean"},
    "latency_ms_p50": {"type": "integer", "minimum": 0},
    "latency_ms_p95": {"type": "integer", "minimum": 0},
    "observed_cost_cad": {"type": ["number", "null"], "minimum": 0},
    "sample_count": {"type": "integer", "minimum": 1},
    "measured_at": {"type": "string", "format": "date-time"},
    "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}
