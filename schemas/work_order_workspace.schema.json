{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AIGC Work Order Workspace",
  "type": "object",
  "required": [
    "workspace_id",
    "tenant_id",
    "work_order_id",
    "correlation_id",
    "created_at",
    "data_classification",
    "budget_limits",
    "approval_state",
    "artifact_roots",
    "allowed_reference_ids",
    "external_action_performed"
  ],
  "properties": {
    "workspace_id": {
      "type": "string"
    },
    "tenant_id": {
      "type": "string"
    },
    "work_order_id": {
      "type": "string"
    },
    "correlation_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "data_classification": {
      "type": "string"
    },
    "budget_limits": {
      "type": "object"
    },
    "approval_state": {
      "type": "string"
    },
    "artifact_roots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "allowed_reference_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "external_action_performed": {
      "type": "boolean"
    }
  },
  "additionalProperties": true
}
