{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aigc:schema:employer-sandbox-receipt:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mode",
    "pack_id",
    "pack_version",
    "pack_status",
    "capability_id",
    "required_supervision",
    "scenario",
    "disposition",
    "reason",
    "terminal_status",
    "first_blocker",
    "zero_egress",
    "credentials_accessed",
    "provider_calls_performed",
    "external_actions_performed",
    "authority_granted",
    "external_action_performed",
    "receipt_id",
    "receipt_sha256"
  ],
  "properties": {
    "schema_version": {"const": "aigc.employer-sandbox-receipt.v1"},
    "mode": {"const": "sandbox"},
    "pack_id": {"type": "string", "pattern": "^OCC-[A-Z0-9_]+$"},
    "pack_version": {"type": "string", "minLength": 1},
    "pack_status": {"type": "string", "minLength": 1},
    "capability_id": {"type": "string", "pattern": "^CAP-[A-Z0-9_]+$"},
    "required_supervision": {"type": "string", "minLength": 1},
    "scenario": {"enum": ["NORMAL_TASK", "PROMPT_INJECTION", "EXTERNAL_ACTION_REQUEST", "REGULATED_SCOPE_REQUEST"]},
    "disposition": {"enum": ["LOCAL_DRAFT_REQUIRES_HUMAN_REVIEW", "DENIED_BY_SANDBOX_POLICY"]},
    "reason": {"type": "string", "minLength": 1},
    "terminal_status": {"enum": ["PASS", "BLOCKED"]},
    "first_blocker": {"type": ["string", "null"]},
    "zero_egress": {"const": true},
    "credentials_accessed": {"const": false},
    "provider_calls_performed": {"const": 0},
    "external_actions_performed": {"const": 0},
    "authority_granted": {"const": false},
    "external_action_performed": {"const": false},
    "receipt_id": {"type": "string", "pattern": "^SBX-[A-F0-9]{24}$"},
    "receipt_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
