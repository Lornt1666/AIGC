{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aigc.local/schemas/connector_action_request.schema.json",
  "title": "AIGC Connector Action Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id",
    "contract_version",
    "request_id",
    "exact_revision",
    "connector_id",
    "operation_id",
    "destination",
    "idempotency_key",
    "payload_digest",
    "request_digest",
    "mode",
    "consequence",
    "approval_scope",
    "dry_run_completed",
    "created_at",
    "external_action_performed"
  ],
  "properties": {
    "contract_id": {"const": "AIGC-CONNECTOR-ACTION-REQUEST-001"},
    "contract_version": {"const": "1.0.0"},
    "request_id": {"type": "string", "pattern": "^CAR-[A-F0-9]{24}$"},
    "exact_revision": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "connector_id": {"enum": ["github", "google_drive", "gmail"]},
    "operation_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,79}$"},
    "destination": {"type": "string", "minLength": 1, "maxLength": 500},
    "idempotency_key": {"type": "string", "minLength": 8, "maxLength": 200},
    "payload_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "request_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "mode": {"enum": ["read", "write"]},
    "consequence": {"enum": ["read_only", "draft_only", "external_write"]},
    "approval_scope": {"type": ["string", "null"], "maxLength": 120},
    "dry_run_completed": {"const": true},
    "created_at": {"type": "string", "format": "date-time"},
    "external_action_performed": {"const": false}
  }
}
