{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aigc.example/schemas/aigc_deep_research_policy.schema.json",
  "title": "AIGC Deep Research Procurement Policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "policy_id", "schema_version", "status", "stages", "source_ladder",
    "minimum_primary_sources", "minimum_independent_domains",
    "material_claim_citation_coverage_minimum", "unsupported_material_claims_maximum",
    "unresolved_material_conflicts_maximum", "require_disconfirming_search",
    "require_prompt_injection_screening", "require_source_provenance",
    "provider_contracts", "provider_dispatch_enabled", "grants_execution_authority",
    "external_publication_enabled"
  ],
  "properties": {
    "policy_id": {"type": "string", "pattern": "^RESEARCH-POLICY-[A-Z0-9_-]{4,64}$"},
    "schema_version": {"const": "aigc.deep-research-procurement.v1"},
    "status": {"const": "DRAFT"},
    "stages": {
      "const": ["DEFINE", "SOURCE", "RETRIEVE", "SCREEN", "EXTRACT", "TRIANGULATE", "CHALLENGE", "SYNTHESIZE", "VERIFY", "PACKAGE"]
    },
    "source_ladder": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"$ref": "#/$defs/source_tier"}},
    "minimum_primary_sources": {"type": "integer", "minimum": 2, "maximum": 100},
    "minimum_independent_domains": {"type": "integer", "minimum": 2, "maximum": 100},
    "material_claim_citation_coverage_minimum": {"type": "number", "minimum": 0, "maximum": 1},
    "unsupported_material_claims_maximum": {"type": "integer", "minimum": 0},
    "unresolved_material_conflicts_maximum": {"type": "integer", "minimum": 0},
    "require_disconfirming_search": {"const": true},
    "require_prompt_injection_screening": {"const": true},
    "require_source_provenance": {"const": true},
    "provider_contracts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/provider"}},
    "provider_dispatch_enabled": {"const": false},
    "grants_execution_authority": {"const": false},
    "external_publication_enabled": {"const": false}
  },
  "$defs": {
    "source_tier": {
      "type": "object", "additionalProperties": false,
      "required": ["rank", "source_class", "minimum", "purpose"],
      "properties": {
        "rank": {"type": "integer", "minimum": 1, "maximum": 20},
        "source_class": {"enum": ["PRIMARY_OFFICIAL", "PRIMARY_EMPIRICAL", "EMPLOYER_INTERNAL", "SECONDARY_SYNTHESIS", "DISCOVERY_ONLY"]},
        "minimum": {"type": "integer", "minimum": 0, "maximum": 100},
        "purpose": {"type": "string", "minLength": 1}
      }
    },
    "provider": {
      "type": "object", "additionalProperties": false,
      "required": ["provider", "documentation_url", "interface", "model_selection", "data_source_requirement", "execution_status"],
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "documentation_url": {"type": "string", "pattern": "^https://"},
        "interface": {"type": "string", "minLength": 1},
        "model_selection": {"const": "REVALIDATE_CURRENT_SUPPORTED_MODEL"},
        "data_source_requirement": {"type": "string", "minLength": 1},
        "execution_status": {"const": "BLOCKED_EXTERNAL"}
      }
    }
  }
}
