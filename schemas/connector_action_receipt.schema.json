{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aigc.local/schemas/connector_action_receipt.schema.json",
  "title": "AIGC Connector Action Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id",
    "contract_version",
    "receipt_id",
    "request_id",
    "request_digest",
    "exact_revision",
    "connector_id",
    "operation_id",
    "destination",
    "idempotency_key_digest",
    "result",
    "reason_codes",
    "approval_id",
    "secret_access_receipt",
    "adapter_result_digest",
    "created_at",
    "external_action_performed"
  ],
  "properties": {
    "contract_id": {"const": "AIGC-CONNECTOR-ACTION-RECEIPT-001"},
    "contract_version": {"const": "1.0.0"},
    "receipt_id": {"type": "string", "pattern": "^COR-[A-F0-9]{24}$"},
    "request_id": {"type": "string", "pattern": "^CAR-[A-F0-9]{24}$"},
    "request_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "exact_revision": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "connector_id": {"enum": ["github", "google_drive", "gmail"]},
    "operation_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,79}$"},
    "destination": {"type": "string", "minLength": 1, "maxLength": 500},
    "idempotency_key_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "result": {"enum": ["PERMIT", "DENY", "COMPLETED", "FAILED"]},
    "reason_codes": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,99}$"}
    },
    "approval_id": {"type": ["string", "null"], "maxLength": 100},
    "secret_access_receipt": {"type": ["object", "null"]},
    "adapter_result_digest": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "external_action_performed": {"type": "boolean"}
  },
  "allOf": [
    {
      "if": {"properties": {"result": {"enum": ["DENY", "FAILED"]}}},
      "then": {"properties": {"reason_codes": {"minItems": 1}}}
    },
    {
      "if": {"properties": {"result": {"const": "COMPLETED"}}},
      "then": {
        "properties": {
          "reason_codes": {"maxItems": 0},
          "secret_access_receipt": {"type": "object"},
          "adapter_result_digest": {"type": "string"}
        }
      }
    }
  ]
}
