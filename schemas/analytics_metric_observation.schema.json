{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Deterministic metric observation bound to an exact definition, repository revision, reporting window, and source digests.",
  "properties": {
    "canonical_state_mutated": {
      "const": false
    },
    "claim_classification": {
      "enum": [
        "STRUCTURAL",
        "OUTCOME",
        "PRODUCTION_PROOF"
      ]
    },
    "computed_value": {
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
      "type": "string"
    },
    "denominator": {
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
      "type": "string"
    },
    "deterministic_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "dimensions": {
      "additionalProperties": {
        "maxLength": 128,
        "minLength": 1,
        "type": "string"
      },
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]{0,63}$"
      },
      "type": "object"
    },
    "evidence_basis": {
      "enum": [
        "STRUCTURAL_ONLY",
        "OBSERVED_RUNTIME",
        "GOVERNED_OUTCOME"
      ]
    },
    "evidence_state": {
      "enum": [
        "PASS",
        "FAIL",
        "INSUFFICIENT_EVIDENCE",
        "STALE",
        "UNAVAILABLE",
        "NOT_APPLICABLE"
      ]
    },
    "exact_repository_revision": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "external_action_performed": {
      "const": false
    },
    "freshness_state": {
      "enum": [
        "FRESH",
        "STALE",
        "UNAVAILABLE",
        "NOT_APPLICABLE"
      ]
    },
    "metric_catalog_version": {
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "type": "string"
    },
    "metric_id": {
      "pattern": "^AIGC-METRIC-[A-Z0-9-]{2,48}$",
      "type": "string"
    },
    "metric_version": {
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "type": "string"
    },
    "numerator": {
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
      "type": "string"
    },
    "observation_id": {
      "pattern": "^OBS-[A-Z0-9-]{8,64}$",
      "type": "string"
    },
    "reporting_window": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "format": "date-time",
          "type": "string"
        },
        "start": {
          "format": "date-time",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "type": "object"
    },
    "source_digests": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "source_lineage": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "evidence_reference": {
            "maxLength": 512,
            "minLength": 1,
            "type": "string"
          },
          "lineage_id": {
            "pattern": "^LINEAGE-[A-Z0-9-]{8,64}$",
            "type": "string"
          },
          "source_identifier": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "source_sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "source_system": {
            "pattern": "^[A-Z][A-Z0-9_]{2,63}$",
            "type": "string"
          }
        },
        "required": [
          "lineage_id",
          "source_system",
          "source_identifier",
          "source_sha256",
          "evidence_reference"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "unit": {
      "enum": [
        "PERCENT",
        "COUNT",
        "SECONDS",
        "RATIO",
        "BASIS_POINTS"
      ]
    }
  },
  "required": [
    "observation_id",
    "metric_id",
    "metric_version",
    "exact_repository_revision",
    "metric_catalog_version",
    "reporting_window",
    "numerator",
    "denominator",
    "computed_value",
    "unit",
    "dimensions",
    "source_lineage",
    "source_digests",
    "evidence_state",
    "freshness_state",
    "evidence_basis",
    "claim_classification",
    "deterministic_sha256",
    "external_action_performed",
    "canonical_state_mutated"
  ],
  "title": "AIGC Analytics Metric Observation",
  "type": "object"
}
