{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://regenexcalibur.invalid/schemas/nexus_canary_job_provisioning_permit.schema.json",
  "title": "AIGC Nexus Canary Job One-Mutation Provisioning Permit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "permit_id",
    "nonce",
    "repository",
    "project_id",
    "project_number",
    "region",
    "release_sha",
    "provider_id",
    "job_name",
    "target",
    "immutable_image_uri",
    "reserved_usage_units",
    "maximum_input_units",
    "maximum_output_units",
    "request_timeout_seconds",
    "runtime_service_account",
    "provisioner_principal",
    "executor_principal",
    "signer_principal",
    "receipt_bucket",
    "procurement_sha256",
    "deployment_sha256",
    "plan_sha256",
    "governance_decision_sha256",
    "execution_permit_sha256",
    "authority_attestation_sha256",
    "authority_environment_sha256",
    "job_spec_sha256",
    "maximum_mutations",
    "automatic_retry",
    "consumption_mode",
    "job_execution_authorized",
    "live_model_call_authorized",
    "production_activation",
    "kms_key_version",
    "signing_algorithm",
    "public_key_sha256",
    "issued_at",
    "not_before",
    "expires_at",
    "signature_b64"
  ],
  "properties": {
    "schema_version": {"const": "aigc.nexus-canary-job-provisioning-permit.v1"},
    "permit_id": {"type": "string", "pattern": "^CJP-[A-Z0-9_-]{8,64}$"},
    "nonce": {"$ref": "#/$defs/sha256"},
    "repository": {"const": "Lornt1666/AIGC"},
    "project_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{4,28}[a-z0-9]$"},
    "project_number": {"type": "string", "pattern": "^[0-9]{6,20}$"},
    "region": {"const": "northamerica-northeast1"},
    "release_sha": {"$ref": "#/$defs/gitSha"},
    "provider_id": {"enum": ["google_vertex_gemini", "openai_responses"]},
    "job_name": {
      "type": "string",
      "pattern": "^[a-z](?:[a-z0-9-]{0,61}[a-z0-9])?$"
    },
    "target": {
      "type": "string",
      "pattern": "^projects/[a-z][a-z0-9-]{4,28}[a-z0-9]/locations/northamerica-northeast1/jobs/[a-z](?:[a-z0-9-]{0,61}[a-z0-9])?$"
    },
    "immutable_image_uri": {
      "type": "string",
      "pattern": "^[a-z0-9.-]+-docker\\.pkg\\.dev/[a-z0-9._/-]+@sha256:[a-f0-9]{64}$"
    },
    "reserved_usage_units": {"type": "integer", "minimum": 1, "maximum": 4096},
    "maximum_input_units": {"type": "integer", "minimum": 1, "maximum": 4096},
    "maximum_output_units": {"type": "integer", "minimum": 1, "maximum": 4096},
    "request_timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 120},
    "runtime_service_account": {"$ref": "#/$defs/serviceAccount"},
    "provisioner_principal": {"$ref": "#/$defs/serviceAccount"},
    "executor_principal": {"$ref": "#/$defs/serviceAccount"},
    "signer_principal": {"$ref": "#/$defs/serviceAccount"},
    "receipt_bucket": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{1,61}[a-z0-9]$"
    },
    "procurement_sha256": {"$ref": "#/$defs/sha256"},
    "deployment_sha256": {"$ref": "#/$defs/sha256"},
    "plan_sha256": {"$ref": "#/$defs/sha256"},
    "governance_decision_sha256": {"$ref": "#/$defs/sha256"},
    "execution_permit_sha256": {"$ref": "#/$defs/sha256"},
    "authority_attestation_sha256": {"$ref": "#/$defs/sha256"},
    "authority_environment_sha256": {"$ref": "#/$defs/sha256"},
    "job_spec_sha256": {"$ref": "#/$defs/sha256"},
    "maximum_mutations": {"const": 1},
    "automatic_retry": {"const": false},
    "consumption_mode": {"const": "gcs_if_generation_match_zero"},
    "job_execution_authorized": {"const": false},
    "live_model_call_authorized": {"const": false},
    "production_activation": {"const": false},
    "kms_key_version": {
      "type": "string",
      "pattern": "^projects/[a-z][a-z0-9-]{4,28}[a-z0-9]/locations/northamerica-northeast1/keyRings/[A-Za-z0-9_-]{1,63}/cryptoKeys/[A-Za-z0-9_-]{1,63}/cryptoKeyVersions/[1-9][0-9]*$"
    },
    "signing_algorithm": {"const": "RSA_SIGN_PSS_2048_SHA256"},
    "public_key_sha256": {"$ref": "#/$defs/sha256"},
    "issued_at": {"type": "string", "format": "date-time"},
    "not_before": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "signature_b64": {"type": "string", "minLength": 32, "maxLength": 2048}
  },
  "$defs": {
    "gitSha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "serviceAccount": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{4,28}[a-z0-9]@[a-z][a-z0-9-]{4,28}[a-z0-9]\\.iam\\.gserviceaccount\\.com$"
    }
  }
}
