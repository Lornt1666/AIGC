{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AIGC Public Research Procurement Catalog",
  "type": "object",
  "required": [
    "catalog_id",
    "created_at",
    "status",
    "research_scope",
    "sources",
    "procured_layers",
    "forbidden_procurement_targets",
    "procurement_boundary",
    "external_action_performed"
  ],
  "properties": {
    "catalog_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "research_scope": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "source_id",
          "title",
          "source_type",
          "url",
          "freshness",
          "credibility_score",
          "applicability_score",
          "safe_borrow",
          "avoid"
        ],
        "properties": {
          "source_id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "source_type": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "freshness": {
            "type": "string"
          },
          "credibility_score": {
            "type": "integer"
          },
          "applicability_score": {
            "type": "integer"
          },
          "safe_borrow": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "avoid": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "procured_layers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "layer_id",
          "name",
          "status",
          "priority",
          "source_ids",
          "missing_reason",
          "procurement_action",
          "acceptance_tests",
          "risk_controls",
          "forbidden_targets_blocked",
          "human_review_required",
          "external_action_performed"
        ],
        "properties": {
          "layer_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "priority": {
            "type": "string"
          },
          "source_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "missing_reason": {
            "type": "string"
          },
          "procurement_action": {
            "type": "string"
          },
          "acceptance_tests": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "risk_controls": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "forbidden_targets_blocked": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "human_review_required": {
            "type": "boolean"
          },
          "external_action_performed": {
            "type": "boolean"
          }
        },
        "additionalProperties": true
      }
    },
    "forbidden_procurement_targets": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "procurement_boundary": {
      "type": "object"
    },
    "external_action_performed": {
      "type": "boolean"
    }
  },
  "additionalProperties": true
}
