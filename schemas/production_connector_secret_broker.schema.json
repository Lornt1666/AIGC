{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aigc.local/schemas/production_connector_secret_broker.schema.json",
  "title": "AIGC Production Connector and Secret Broker Baseline v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id",
    "contract_version",
    "status",
    "environment_decision_path",
    "secret_manager",
    "connector_policy",
    "connectors",
    "operational_evidence",
    "authority",
    "external_action_performed"
  ],
  "properties": {
    "contract_id": {"const": "AIGC-PRODUCTION-CONNECTOR-SECRET-BROKER-001"},
    "contract_version": {"const": "1.0.0"},
    "status": {"const": "IMPLEMENTED_INTERNAL_PENDING_STAGING_EVIDENCE"},
    "environment_decision_path": {"const": "config/production_environment_decision.json"},
    "secret_manager": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "project_id",
        "reference_scheme",
        "replication_strategy",
        "approved_locations",
        "workload_identity_required",
        "raw_values_in_repository",
        "raw_values_in_logs",
        "raw_values_in_receipts",
        "access_audit_required",
        "rotation_required"
      ],
      "properties": {
        "provider": {"const": "google_secret_manager"},
        "project_id": {"type": "null"},
        "reference_scheme": {"const": "gcp_secret"},
        "replication_strategy": {"const": "user_managed_canada"},
        "approved_locations": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {"enum": ["northamerica-northeast1", "northamerica-northeast2"]}
        },
        "workload_identity_required": {"const": true},
        "raw_values_in_repository": {"const": false},
        "raw_values_in_logs": {"const": false},
        "raw_values_in_receipts": {"const": false},
        "access_audit_required": {"const": true},
        "rotation_required": {"const": true}
      }
    },
    "connector_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "official_api_required",
        "scraping_allowed",
        "credential_automation_allowed",
        "destination_allowlist_required",
        "idempotency_required",
        "dry_run_required_before_write",
        "human_approval_for_consequential_actions",
        "approval_ttl_seconds",
        "payload_persistence",
        "production_default"
      ],
      "properties": {
        "official_api_required": {"const": true},
        "scraping_allowed": {"const": false},
        "credential_automation_allowed": {"const": false},
        "destination_allowlist_required": {"const": true},
        "idempotency_required": {"const": true},
        "dry_run_required_before_write": {"const": true},
        "human_approval_for_consequential_actions": {"const": true},
        "approval_ttl_seconds": {"const": 900},
        "payload_persistence": {"const": "DIGEST_ONLY"},
        "production_default": {"const": "DENY"}
      }
    },
    "connectors": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"$ref": "#/$defs/connector"}
    },
    "operational_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "secret_manager_project_configured",
        "workload_identity_observed",
        "secret_access_audit_observed",
        "rotation_observed",
        "github_staging_receipt",
        "google_drive_staging_receipt",
        "gmail_staging_receipt",
        "duplicate_prevention_passed",
        "revocation_passed",
        "redaction_review_passed"
      ],
      "properties": {
        "secret_manager_project_configured": {"const": false},
        "workload_identity_observed": {"const": false},
        "secret_access_audit_observed": {"const": false},
        "rotation_observed": {"const": false},
        "github_staging_receipt": {"const": false},
        "google_drive_staging_receipt": {"const": false},
        "gmail_staging_receipt": {"const": false},
        "duplicate_prevention_passed": {"const": false},
        "revocation_passed": {"const": false},
        "redaction_review_passed": {"const": false}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "internal_framework_implementation_authorized",
        "offline_adapter_testing_authorized",
        "secret_access_authorized",
        "oauth_authorization_authorized",
        "staging_read_authorized",
        "staging_write_authorized",
        "production_connector_activation_authorized",
        "production_external_action_authorized"
      ],
      "properties": {
        "internal_framework_implementation_authorized": {"const": true},
        "offline_adapter_testing_authorized": {"const": true},
        "secret_access_authorized": {"const": false},
        "oauth_authorization_authorized": {"const": false},
        "staging_read_authorized": {"const": false},
        "staging_write_authorized": {"const": false},
        "production_connector_activation_authorized": {"const": false},
        "production_external_action_authorized": {"const": false}
      }
    },
    "external_action_performed": {"const": false}
  },
  "$defs": {
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation_id", "mode", "consequence", "approval_scope"],
      "properties": {
        "operation_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,79}$"},
        "mode": {"enum": ["read", "write"]},
        "consequence": {"enum": ["read_only", "draft_only", "external_write"]},
        "approval_scope": {"type": ["string", "null"], "maxLength": 120}
      }
    },
    "connector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "connector_id",
        "platform",
        "official_api",
        "enabled",
        "authentication",
        "secret_reference",
        "destination_allowlist",
        "operations",
        "staging_evidence_status",
        "terms_review_status"
      ],
      "properties": {
        "connector_id": {"enum": ["github", "google_drive", "gmail"]},
        "platform": {"enum": ["GitHub", "Google Drive", "Gmail"]},
        "official_api": {"const": true},
        "enabled": {"const": false},
        "authentication": {"enum": ["github_app", "oauth2"]},
        "secret_reference": {"type": "string", "pattern": "^gcp_secret://TBD_PROJECT/[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$"},
        "destination_allowlist": {"type": "array", "maxItems": 0, "items": {"type": "string"}},
        "operations": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/operation"}},
        "staging_evidence_status": {"const": "NOT_STARTED"},
        "terms_review_status": {"const": "REQUIRED"}
      }
    }
  }
}
