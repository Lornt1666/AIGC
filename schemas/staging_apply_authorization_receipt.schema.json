{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://aigc.local/schemas/staging_apply_authorization_receipt.schema.json","title":"AIGC Staging Apply Authorization Receipt v1","type":"object","additionalProperties":false,"required":["contract_id","contract_version","receipt_id","decision","exact_revision","procurement_pack_digest","plan_artifact_digest","issued_at","expires_at","project_reference","resource_manifest_digest","iam_delta_digest","origin_redirect_digest","secret_reference_digest","rollback_instructions_digest","single_use","operator_review_required","automatic_apply_allowed","provider_action_performed","terraform_apply_performed","external_action_performed"],"properties":{"contract_id":{"const":"AIGC-STAGING-APPLY-AUTHORIZATION-RECEIPT-001"},"contract_version":{"const":"1.0.0"},"receipt_id":{"type":"string","pattern":"^SAA-[A-Z0-9][A-Z0-9:-]{7,199}$"},"decision":{"enum":["APPROVED","DENIED"]},"exact_revision":{"type":"string","pattern":"^[a-f0-9]{40}$"},"procurement_pack_digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},"plan_artifact_digest":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"},"issued_at":{"type":"string","format":"date-time"},"expires_at":{"type":"string","format":"date-time"},"project_reference":{"type":"string","pattern":"^gcp_project://[a-z][a-z0-9-]{4,28}[a-z0-9]$"},"resource_manifest_digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},"iam_delta_digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},"origin_redirect_digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},"secret_reference_digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},"rollback_instructions_digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},"single_use":{"const":true},"operator_review_required":{"const":true},"automatic_apply_allowed":{"const":false},"provider_action_performed":{"const":false},"terraform_apply_performed":{"const":false},"external_action_performed":{"const":false}}}