{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://aigc.local/schemas/evidence_provenance_envelope.schema.json","title":"AIGC Minimal Evidence Provenance Envelope v1","type":"object","additionalProperties":false,"required":["contract_id","contract_version","node_id","node_type","artifact_digest","repository_revision","created_at","predecessor_ids","authorization_receipt_id","evidence_receipt_id","operator_approval_reference","ci_run_id","rollback_reference","external_action_performed"],"properties":{"contract_id":{"const":"AIGC-EVIDENCE-PROVENANCE-ENVELOPE-001"},"contract_version":{"const":"1.0.0"},"node_id":{"type":"string","pattern":"^PROV-[A-F0-9]{24}$"},"node_type":{"enum":["PROVIDER_DISCOVERY_SIMULATION","TARGET_SPECIFICATION_SUBMISSION","COMMAND_PLAN"]},"artifact_digest":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"},"repository_revision":{"type":"string","pattern":"^[a-f0-9]{40}$"},"created_at":{"type":"string","format":"date-time"},"predecessor_ids":{"type":"array","uniqueItems":true,"items":{"type":"string","pattern":"^PROV-[A-F0-9]{24}$"}},"authorization_receipt_id":{"type":"null"},"evidence_receipt_id":{"type":"null"},"operator_approval_reference":{"type":"null"},"ci_run_id":{"type":["string","null"],"pattern":"^[A-Za-z0-9._:-]{1,200}$"},"rollback_reference":{"type":"string","minLength":1,"maxLength":500},"external_action_performed":{"const":false}}}
