{
  "phase": "save_credential_broker_procurement",
  "display_name": "Save Credential Broker Procurement",
  "purpose": "Persist the controlled credential-saving flow for AIGC WorkForge Desktop so credentials are saved only to approved vault targets while AIGC records references, metadata, and audit receipts.",
  "flow": [
    "operator_clicks_save_credential",
    "app_opens_controlled_broker_popup",
    "operator_chooses_vault_target",
    "app_displays_reference_name_and_purpose",
    "operator_enters_value_only_into_vault_entry_surface",
    "app_receives_success_or_failure_metadata_only",
    "app_writes_audit_receipt",
    "app_refreshes_reference_status"
  ],
  "approved_vault_targets": [
    {
      "id": "google_secret_manager",
      "label": "Google Secret Manager",
      "purpose": "Preferred cloud/workflow vault for AIGC references.",
      "allowed_for_cloud_workflows": true,
      "allowed_for_local_development": true,
      "payload_storage_location": "google_secret_manager_only",
      "aigc_artifact_payload_storage_allowed": false
    },
    {
      "id": "os_protected_local_storage_dev_only",
      "label": "OS-protected local storage for development only",
      "purpose": "Local operator convenience for development; not for CI, artifacts, or cloud workflow execution.",
      "allowed_for_cloud_workflows": false,
      "allowed_for_local_development": true,
      "payload_storage_location": "operating_system_protected_storage",
      "aigc_artifact_payload_storage_allowed": false,
      "flags": ["local_only", "not_for_ci", "not_for_artifacts", "not_for_repo"]
    },
    {
      "id": "future_approved_password_manager_connector",
      "label": "Future approved password-manager connector",
      "purpose": "Reserved future integration path after separate review and connector approval.",
      "allowed_for_cloud_workflows": false,
      "allowed_for_local_development": false,
      "payload_storage_location": "approved_external_vault_only",
      "aigc_artifact_payload_storage_allowed": false,
      "requires_future_review": true
    },
    {
      "id": "cancel_and_mark_missing",
      "label": "Cancel and mark missing",
      "purpose": "Abort credential save and mark the reference missing until the operator saves it later.",
      "allowed_for_cloud_workflows": false,
      "allowed_for_local_development": true,
      "payload_storage_location": "none",
      "aigc_artifact_payload_storage_allowed": false
    }
  ],
  "broker_popup_fields": [
    "destination_vault",
    "reference_name",
    "reference_uri",
    "purpose",
    "required_before_stage",
    "scope_requested",
    "rotation_policy",
    "audit_event_to_be_written",
    "repository_and_artifact_payload_warning"
  ],
  "credential_reference_inspector": {
    "shortcut": "Ctrl+N",
    "label": "Credential Reference Inspector",
    "allowed_display": [
      "reference_uri",
      "vault_target",
      "presence_status",
      "version_status",
      "rotation_status",
      "last_checked_time",
      "last_audit_receipt",
      "source_of_truth",
      "missing_warning"
    ],
    "payload_display_allowed": false,
    "plaintext_viewer_allowed": false
  },
  "audit_events": [
    "save_credential_broker_opened",
    "vault_target_selected",
    "vault_save_started",
    "vault_save_completed",
    "vault_save_failed",
    "reference_status_refreshed",
    "proceed_blocked_missing_reference"
  ],
  "outputs": {
    "packet": "data/save_credential_broker/aigc_save_credential_broker_packet.json",
    "report": "reports/save_credential_broker_report.md",
    "audit": "data/audit/aigc_save_credential_broker_audit.jsonl"
  },
  "safety_result": {
    "payload_written_to_repo": false,
    "payload_written_to_artifacts": false,
    "payload_written_to_logs": false,
    "payload_displayed_in_ui": false,
    "proceed_requires_reference_presence": true,
    "nothing_silently_submits": true
  }
}
