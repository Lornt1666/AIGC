{
  "project": "AIGC - Artificial Intelligence Gladiator Colosseum",
  "operator": "Justice Gray Maciocha",
  "provider": "google_cloud_secret_manager",
  "store_raw_values": false,
  "manifest_role": "repo_secret_reference_map_only",
  "rules": {
    "store_raw_secret_values_on_external_drive": false,
    "store_raw_secret_values_in_repo": false,
    "log_secret_values": false,
    "print_secret_values": false,
    "include_secret_values_in_prompts": false,
    "include_secret_values_in_employer_packets": false,
    "secret_values_runtime_only": true
  },
  "kms_policy": {
    "provider": "google_cloud_kms",
    "purpose": "cryptographic_encryption_keys_only",
    "not_for_general_password_or_api_secret_storage": true
  },
  "service_account_key_policy": {
    "avoid_long_lived_downloaded_keys": true,
    "store_service_account_key_json_in_repo": false,
    "store_service_account_key_json_on_external_drive": false,
    "store_service_account_key_json_in_secret_manager": false,
    "preferred_authentication": "google_managed_identity_or_user_application_default_credentials"
  },
  "secrets": {
    "OPENAI_API_KEY": {
      "resource": "projects/YOUR_PROJECT_ID/secrets/aigc-openai-api-key/versions/latest",
      "purpose": "LLM access for approved AIGC operations",
      "risk_level": "high",
      "allowed_phases": [
        "phase3_ology_assessment",
        "phase4_proposal_drafting",
        "phase8_evolution_loop"
      ],
      "allowed_agents": [
        "Omega-X Orchestrator",
        "Ultra-Secrets Agent",
        "Secret Broker"
      ],
      "approval_required": true,
      "cache_policy": "memory_only",
      "log_value": false,
      "store_raw_value_on_external_drive": false
    },
    "GITHUB_TOKEN": {
      "resource": "projects/YOUR_PROJECT_ID/secrets/aigc-github-token/versions/latest",
      "purpose": "Approved GitHub API actions after scoped authorization",
      "risk_level": "high",
      "allowed_phases": [
        "phase2_opportunity_radar",
        "phase6_controlled_execution"
      ],
      "allowed_agents": [
        "GitHub Connector",
        "Controlled Execution Engine",
        "Ultra-Secrets Agent",
        "Secret Broker"
      ],
      "approval_required": true,
      "cache_policy": "memory_only",
      "log_value": false,
      "store_raw_value_on_external_drive": false
    },
    "ADZUNA_API_KEY": {
      "resource": "projects/YOUR_PROJECT_ID/secrets/aigc-adzuna-api-key/versions/latest",
      "purpose": "Read-only job discovery API access",
      "risk_level": "medium",
      "allowed_phases": [
        "phase2_opportunity_radar"
      ],
      "allowed_agents": [
        "Omni-Research Agent",
        "Ultra-Secrets Agent",
        "Secret Broker"
      ],
      "approval_required": false,
      "cache_policy": "memory_only",
      "log_value": false,
      "store_raw_value_on_external_drive": false
    },
    "FAKE_TEST_SECRET": {
      "resource": "projects/LOCAL_FAKE_PROJECT/secrets/aigc-fake-test-secret/versions/latest",
      "purpose": "Fake secret used for local Phase 11 broker and redaction tests only",
      "risk_level": "test_only",
      "allowed_phases": [
        "phase11_security_vault"
      ],
      "allowed_agents": [
        "Ultra-Secrets Agent",
        "Secret Broker"
      ],
      "approval_required": false,
      "cache_policy": "memory_only",
      "log_value": false,
      "store_raw_value_on_external_drive": false
    }
  }
}
