{
  "schema_version": "aigc.gemini-secret-access-manifest.v1",
  "required_chain": [
    "Omega-X Orchestrator",
    "Ultra-Secrets Agent",
    "Secret Broker",
    "Google Cloud Secret Manager"
  ],
  "audit_sink": "cloud_logging_metadata_only",
  "bindings": [
    {
      "purpose": "gemini-runtime-control-dsn",
      "reference_env": "AIGC_GEMINI_CONTROL_DSN_SECRET_REF"
    },
    {
      "purpose": "gemini-operator-authentication",
      "reference_env": "AIGC_OPERATOR_TOKEN_SECRET_REF"
    },
    {
      "purpose": "gemini-operator-principal-binding",
      "reference_env": "AIGC_OPERATOR_BINDING_KEY_SECRET_REF"
    },
    {
      "purpose": "gemini-runtime-admin-authentication",
      "reference_env": "AIGC_RUNTIME_ADMIN_TOKEN_SECRET_REF"
    },
    {
      "purpose": "gemini-runtime-admin-principal-binding",
      "reference_env": "AIGC_RUNTIME_ADMIN_BINDING_KEY_SECRET_REF"
    },
    {
      "purpose": "gemini-judge-authentication",
      "reference_env": "AIGC_JUDGE_TOKEN_SECRET_REF"
    },
    {
      "purpose": "gemini-judge-principal-binding",
      "reference_env": "AIGC_JUDGE_BINDING_KEY_SECRET_REF"
    }
  ]
}
