{
  "schema_version": "aigc.alpha-domain-profiles.v1",
  "profiles": {
    "GENERAL": {
      "description": "General request analysis, composition, and verification.",
      "operations": [
        {
          "operation_id": "ALPHA-OP-VALIDATE_REQUEST",
          "function_name": "aigc.validate_request",
          "parameters": {},
          "expected_outputs": {"intent_frame": "object"},
          "priority": 0
        },
        {
          "operation_id": "ALPHA-OP-COMPOSE_RESPONSE",
          "function_name": "aigc.compose_response",
          "parameters": {},
          "expected_outputs": {"candidate_artifact": "object"},
