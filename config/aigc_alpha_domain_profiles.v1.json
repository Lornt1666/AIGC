          "expected_outputs": {"fulfillment_manifest": "object"},
          "depends_on": ["ALPHA-OP-CONTRACT001"],
          "priority": 50
        },
        {
          "operation_id": "ALPHA-OP-PAYMENT001",
          "function_name": "aigc.blueprint.procurement.finance",
          "parameters": {"payment_terms": ["Net30", "Net45", "Net60"], "automatic_transfer": false, "fx_hedge_execution": false},
          "expected_outputs": {"finance_control_manifest": "object"},
          "depends_on": ["ALPHA-OP-FULFILL001"],
          "priority": 60
        },
        {
          "operation_id": "ALPHA-OP-EVALUATE001",
          "function_name": "aigc.blueprint.procurement.evaluation",
          "parameters": {"metrics": ["cycle_time", "tco_delta", "supplier_sla", "policy_violations", "mttr"]},
          "expected_outputs": {"evaluation_manifest": "object"},
