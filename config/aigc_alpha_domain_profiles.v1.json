          "expected_outputs": {"contract_review_manifest": "object"},
          "depends_on": ["ALPHA-OP-NEGOTIATE001"],
          "priority": 40
        },
        {
          "operation_id": "ALPHA-OP-FULFILL001",
          "function_name": "aigc.blueprint.procurement.fulfillment",
