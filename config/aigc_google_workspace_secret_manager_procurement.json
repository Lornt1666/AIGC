{
  "phase": "google_workspace_secret_manager_procurement",
  "display_name": "Google Workspace Secret Manager Procurement",
  "purpose": "Procure a Google Workspace and Google Secret Manager reference-only credential control plane for AIGC automation without storing raw secrets in the repository or workflow logs.",
  "trigger": {
    "phrase": "AIGC",
    "human_in_loop_required": true
  },
  "google_workspace_identity": {
    "operator_email_secret_ref": "gcp_secret://AIGC_OPERATOR_GOOGLE_WORKSPACE_EMAIL/latest",
    "gmail_oauth_client_id_secret_ref": "gcp_secret://AIGC_GMAIL_OAUTH_CLIENT_ID/latest",
    "gmail_oauth_client_secret_ref": "gcp_secret://AIGC_GMAIL_OAUTH_CLIENT_SECRET/latest",
    "gmail_refresh_token_secret_ref": "gcp_secret://AIGC_GMAIL_REFRESH_TOKEN/latest",
    "workspace_domain_secret_ref": "gcp_secret://AIGC_GOOGLE_WORKSPACE_DOMAIN/latest",
    "raw_values_in_repo_allowed": false
  },
  "secret_manager_project": {
    "project_id_secret_ref": "gcp_secret://AIGC_GCP_PROJECT_ID/latest",
    "secret_manager_api_required": true,
    "parameter_manager_optional": true,
    "audit_logging_required": true,
    "iam_least_privilege_required": true,
    "secret_level_iam_preferred": true,
    "rotation_required": true
  },
  "gmail_api_scopes": {
    "minimum_initial_scopes": [
      "https://www.googleapis.com/auth/gmail.send"
    ],
    "restricted_or_sensitive_scope_review_required": true,
    "broader_scopes_require_separate_review": [
      "https://www.googleapis.com/auth/gmail.modify",
      "https://www.googleapis.com/auth/gmail.compose",
      "https://mail.google.com/"
    ]
  },
  "secret_references": [
    {
      "name": "AIGC_OPERATOR_GOOGLE_WORKSPACE_EMAIL",
      "purpose": "Operator identity reference for review and audit display.",
      "raw_value_logging_allowed": false
    },
    {
      "name": "AIGC_GCP_PROJECT_ID",
      "purpose": "Google Cloud project reference used for Secret Manager operations.",
      "raw_value_logging_allowed": false
    },
    {
      "name": "AIGC_GMAIL_OAUTH_CLIENT_ID",
      "purpose": "OAuth client ID reference for Gmail sending connector.",
      "raw_value_logging_allowed": false
    },
    {
      "name": "AIGC_GMAIL_OAUTH_CLIENT_SECRET",
      "purpose": "OAuth client secret reference for Gmail sending connector.",
      "raw_value_logging_allowed": false
    },
    {
      "name": "AIGC_GMAIL_REFRESH_TOKEN",
      "purpose": "Refresh token reference for approved Gmail connector, if operator grants it.",
      "raw_value_logging_allowed": false
    },
    {
      "name": "AIGC_WORK_SOURCE_CONNECTOR_ALLOWLIST",
      "purpose": "JSON allowlist of source connectors approved for discovery, drafting, handoff, or submission.",
      "raw_value_logging_allowed": false
    }
  ],
  "command_plan": [
    "gcloud services enable secretmanager.googleapis.com",
    "gcloud secrets create AIGC_OPERATOR_GOOGLE_WORKSPACE_EMAIL --replication-policy=automatic",
    "gcloud secrets create AIGC_GCP_PROJECT_ID --replication-policy=automatic",
    "gcloud secrets create AIGC_GMAIL_OAUTH_CLIENT_ID --replication-policy=automatic",
    "gcloud secrets create AIGC_GMAIL_OAUTH_CLIENT_SECRET --replication-policy=automatic",
    "gcloud secrets create AIGC_GMAIL_REFRESH_TOKEN --replication-policy=automatic",
    "gcloud secrets create AIGC_WORK_SOURCE_CONNECTOR_ALLOWLIST --replication-policy=automatic"
  ],
  "safety_doctrine": {
    "raw_secret_values_in_repo_allowed": false,
    "raw_secret_values_in_logs_allowed": false,
    "credential_use_allowed": "conditional_secret_broker_reference_only_after_operator_approval",
    "external_action_allowed": "conditional_submission_cockpit_proceed_and_connector_allowlist",
    "human_review_required_before_submission": true,
    "proceed_records_handoff_only": true
  },
  "outputs": {
    "packet": "data/google_workspace_secret_manager/aigc_google_workspace_secret_manager_procurement_packet.json",
    "report": "reports/google_workspace_secret_manager_procurement_report.md",
    "audit": "data/audit/aigc_google_workspace_secret_manager_procurement_audit.jsonl"
  }
}
