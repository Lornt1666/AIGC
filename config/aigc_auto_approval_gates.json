{
  "phase": "auto_approval_gate_procurement",
  "display_name": "Auto-Approval Gate Procurement",
  "purpose": "Procure a governed auto-approval gate layer for the AIGC pipeline that can auto-pass low-risk internal artifact stages, require human review for elevated-risk actions, and auto-deny forbidden actions.",
  "inputs": {
    "phase1_plan": "data/phase1_cognitive_router/aigc_phase1_cognitive_plan.json",
    "phase2_24_continuity": "data/phase2_24_continuity/aigc_phase2_24_continuity_plan.json",
    "phase_interleave_schedule": "data/phase_interleaves/aigc_phase_interleave_schedule.json",
    "mvp_plus_plus_plus_packet": "data/mvp_plus_plus_plus/aigc_mvp_plus_plus_plus_procurement_packet.json",
    "access_automation_packet": "data/access_automation/aigc_access_automation_procurement_packet.json",
    "employer_deliverable_packet": "data/employer_deliverables/aigc_employer_deliverable_procurement_packet.json",
    "submission_approval_decision": "data/submission_approval/aigc_submission_approval_decision.json"
  },
  "outputs": {
    "packet": "data/auto_approval_gates/aigc_auto_approval_gate_packet.json",
    "report": "reports/auto_approval_gate_procurement_report.md",
    "audit": "data/audit/aigc_auto_approval_gate_audit.jsonl"
  },
  "policy": {
    "default_decision": "human_review_required",
    "auto_pass_allowed_for": [
      "internal_metadata_classification",
      "internal_artifact_generation",
      "internal_report_generation",
      "schema_validation",
      "read_only_repository_cartography",
      "proposal_only_refactor_planning",
      "continuity_ledger_generation",
      "interleave_schedule_generation",
      "procurement_intent_recording",
      "access_automation_procurement_plan_generation",
      "employer_deliverable_packet_generation",
      "submission_audit_view_generation"
    ],
    "human_review_required_for": [
      "external_action_request",
      "physical_file_move_request",
      "source_rewrite_request",
      "workflow_rewrite_request",
      "credential_access_request",
      "secret_reference_use_request",
      "approval_gate_state_change",
      "behavior_change_patch",
      "connector_write_enablement",
      "live_access_automation_activation",
      "employer_submission_handoff"
    ],
    "auto_deny_for": [
      "raw_secret_value_logging",
      "credential_exfiltration",
      "unscoped_external_action",
      "unapproved_identity_use",
      "bypass_human_approval",
      "delete_without_review",
      "payment_or_spend_without_approval",
      "live_message_send_without_approval"
    ]
  },
  "stage_requests": [
    {
      "stage_id": "phase1_cognitive_router",
      "request_type": "internal_artifact_generation",
      "risk_level": "low",
      "description": "Generate cognitive phase plan."
    },
    {
      "stage_id": "phase2_24_continuity_bridge",
      "request_type": "continuity_ledger_generation",
      "risk_level": "low",
      "description": "Generate visibility ledger for phases 2 through 24."
    },
    {
      "stage_id": "phase_interleave_scheduler",
      "request_type": "interleave_schedule_generation",
      "risk_level": "low",
      "description": "Generate repeated phase occurrence schedule showing guard loops between phases."
    },
    {
      "stage_id": "mvp_plus_plus_plus_procurement",
      "request_type": "procurement_intent_recording",
      "risk_level": "medium",
      "description": "Record requested capability flags as procurement intent while keeping effective authority blocked."
    },
    {
      "stage_id": "access_automation_procurement",
      "request_type": "access_automation_procurement_plan_generation",
      "risk_level": "medium",
      "description": "Record human-in-loop automation access request flags as true and map hiring/work source domains to safety parameters without live connector activation."
    },
    {
      "stage_id": "phase25_constellation_fabric",
      "request_type": "read_only_repository_cartography",
      "risk_level": "low",
      "description": "Classify repository files without moving them."
    },
    {
      "stage_id": "phase26_constellation_refactor",
      "request_type": "proposal_only_refactor_planning",
      "risk_level": "medium",
      "description": "Plan possible future file moves without performing them."
    },
    {
      "stage_id": "employer_deliverable_procurement",
      "request_type": "employer_deliverable_packet_generation",
      "risk_level": "medium",
      "description": "Generate reviewable employer-facing deliverable packet without submitting externally."
    },
    {
      "stage_id": "submission_approval_cockpit_review",
      "request_type": "submission_audit_view_generation",
      "risk_level": "low",
      "description": "Generate audit-view cockpit with proceed or deny decision controls."
    },
    {
      "stage_id": "submission_approval_cockpit_proceed",
      "request_type": "employer_submission_handoff",
      "risk_level": "high",
      "description": "Proceed decision requires exact phrase and human review, and still records handoff only unless future approved connector exists."
    },
    {
      "stage_id": "future_live_access_automation_activation",
      "request_type": "live_access_automation_activation",
      "risk_level": "high",
      "description": "Future live connector automation requires separate reviewed activation, connector allowlist, secret broker, redaction, rate limits, idempotency, and audit receipt."
    }
  ],
  "effective_runtime_authority": {
    "external_action_allowed": false,
    "physical_file_moves_allowed": false,
    "source_rewrite_allowed": false,
    "workflow_rewrite_allowed": false,
    "credential_use_allowed": false,
    "secret_value_logging_allowed": false,
    "approval_required_for_future_write_back": true
  },
  "gate_invariants": [
    "Auto-approval can only approve internal artifact generation and metadata classification.",
    "Auto-approval cannot approve external action, credential use, raw secret logging, physical file movement, source rewrite, or workflow rewrite.",
    "Medium-risk internal stages can auto-pass only when effective runtime authority remains false for dangerous capabilities.",
    "Access automation procurement can record requested human-in-loop capabilities as true, but live connector activation requires separate review.",
    "Employer deliverable packets can be auto-generated, but employer submission handoff requires human review.",
    "Repeated phase occurrences are schedule artifacts only until a reviewed executor maps them to safe static steps.",
    "Every gate decision must be written to packet, report, and audit ledger."
  ]
}
