{
  "architect_id": "AIGC-RECURSIVE-PRODUCTION-ARCHITECT-001",
  "version": "2026-07-12",
  "mode": "single_snapshot_review_only",
  "maximum_cycles_per_run": 1,
  "production_readiness_target": 90,
  "mandatory_gate": "Security & Privacy Wiring Gate",
  "paradigms": ["omni", "meta", "trans", "neo", "para"],
  "ontology_domains": ["code", "infrastructure", "devops", "data", "risk"],
  "taxonomy_dimensions": ["layer", "function", "lifecycle", "ownership"],
  "methodology_stack": [
    "domain_driven_design",
    "clean_architecture",
    "separation_of_concerns",
    "test_driven_development",
    "secure_coding",
    "performance_optimization",
    "gitops",
    "continuous_integration",
    "observability_first",
    "compliance_by_design",
    "auditability",
    "traceability"
  ],
  "required_outputs": [
    "ontology_baseline",
    "taxonomy_baseline",
    "methodology_notes",
    "architecture_assessment",
    "transformation_backlog",
    "governance_summary",
    "cycle_receipt"
  ],
  "preservation_controls": {
    "preserve_critical_files": true,
    "no_deletion_without_operator_approval": true,
    "no_source_rewrite_without_diff_review": true,
    "no_workflow_rewrite_without_ci_validation": true,
    "rollback_plan_required": true,
    "git_branch_required": true
  },
  "hard_blocks": [
    "self_approval",
    "unbounded_recursion",
    "direct_main_write",
    "destructive_change_without_review",
    "live_deployment_without_approved_connector",
    "credential_use_without_reviewed_integration",
    "raw_secret_logging",
    "platform_rule_bypass",
    "fabricated_completion_state"
  ],
  "stop_conditions": [
    "single_snapshot_complete",
    "operator_review_required",
    "hard_block_detected",
    "critical_file_change_proposed",
    "production_readiness_target_reached",
    "no_material_improvement_available"
  ],
  "operator_review_required": true,
  "external_action_performed": false
}
