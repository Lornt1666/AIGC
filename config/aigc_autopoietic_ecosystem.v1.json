    {
      "template_id": "ECO-TEMPLATE-RELIABILITY-RECONCILIATION",
      "deficit_class": "RELIABILITY",
      "priority": 10,
      "description": "Install a deterministic retry and reconciliation profile that forbids blind replay after indeterminate effects.",
      "effect_class": "WRITE_REVERSIBLE",
      "operations": [
        {
          "operation_id": "ECO-OP-RELIABILITY-POLICY",
