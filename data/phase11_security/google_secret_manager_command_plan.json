{
  "project_id": "YOUR_PROJECT_ID",
  "member": "user:YOUR_EMAIL@example.com",
  "commands": [
    "gcloud config set project YOUR_PROJECT_ID",
    "gcloud services enable secretmanager.googleapis.com",
    "gcloud secrets create aigc-openai-api-key --replication-policy=\"automatic\"",
    "gcloud secrets versions add aigc-openai-api-key --data-file=-",
    "gcloud secrets add-iam-policy-binding aigc-openai-api-key --member=\"user:YOUR_EMAIL@example.com\" --role=\"roles/secretmanager.secretAccessor\"",
    "gcloud secrets create aigc-github-token --replication-policy=\"automatic\"",
    "gcloud secrets versions add aigc-github-token --data-file=-",
    "gcloud secrets add-iam-policy-binding aigc-github-token --member=\"user:YOUR_EMAIL@example.com\" --role=\"roles/secretmanager.secretAccessor\"",
    "gcloud secrets create aigc-adzuna-api-key --replication-policy=\"automatic\"",
    "gcloud secrets versions add aigc-adzuna-api-key --data-file=-",
    "gcloud secrets add-iam-policy-binding aigc-adzuna-api-key --member=\"user:YOUR_EMAIL@example.com\" --role=\"roles/secretmanager.secretAccessor\""
  ],
  "warnings": [
    "This plan does not execute commands.",
    "Do not paste real secret values into chat, prompts, source files, audit logs, or manifests.",
    "Avoid long-lived downloaded service account key JSON files when possible.",
    "Use Google Cloud KMS for cryptographic encryption keys, not for general API-key/password storage."
  ],
  "external_action_performed": false
}