  "scope": "END_TO_END_CANONICAL_JOB_LIFECYCLE",
  "states": [
    {"state_id": "DISCOVERED", "label": "Discovered", "meaning": "A potential work opportunity has been identified but not qualified.", "lifecycle_scope": "ACQUISITION", "initial": true, "terminal": false},
    {"state_id": "QUALIFIED", "label": "Qualified", "meaning": "The opportunity passed bounded fit, legality, feasibility, and platform checks.", "lifecycle_scope": "ACQUISITION", "initial": false, "terminal": false},
    {"state_id": "PROPOSED", "label": "Proposed", "meaning": "A reviewable work proposal exists and no commitment has yet been authorized.", "lifecycle_scope": "ACQUISITION", "initial": false, "terminal": false},
    {"state_id": "APPROVAL_REQUIRED", "label": "Approval Required", "meaning": "The proposal is complete enough for an attributable operator commitment decision.", "lifecycle_scope": "ACQUISITION", "initial": false, "terminal": false},
    {"state_id": "WORK_ACCEPTED", "label": "Work Accepted", "meaning": "The operator has authorized AIGC to undertake the internal work under the recorded scope.", "lifecycle_scope": "ACQUISITION", "initial": false, "terminal": false},
    {"state_id": "RESEARCHING", "label": "Researching", "meaning": "AIGC is gathering and validating information inside the approved internal boundary.", "lifecycle_scope": "EXECUTION", "initial": false, "terminal": false},
    {"state_id": "PLANNING", "label": "Planning", "meaning": "A testable execution plan, evidence plan, and rollback boundary are being prepared.", "lifecycle_scope": "EXECUTION", "initial": false, "terminal": false},
    {"state_id": "EXECUTING_LOCALLY", "label": "Executing Locally", "meaning": "Approved internal work is being performed without external consequential action.", "lifecycle_scope": "EXECUTION", "initial": false, "terminal": false},
    {"state_id": "REVIEW_REQUIRED", "label": "Review Required", "meaning": "Internal work is complete enough for operator review and acceptance testing.", "lifecycle_scope": "EXECUTION", "initial": false, "terminal": false},
    {"state_id": "REWORK_REQUIRED", "label": "Rework Required", "meaning": "Review found correctable deficiencies and the work must return to an explicit execution stage.", "lifecycle_scope": "EXCEPTION", "initial": false, "terminal": false},
    {"state_id": "ACCEPTED_FOR_DELIVERY", "label": "Accepted for Delivery", "meaning": "The operator accepted the reviewed work product and authorized preparation for a separate delivery action.", "lifecycle_scope": "DELIVERY", "initial": false, "terminal": false},
    {"state_id": "DELIVERED", "label": "Delivered", "meaning": "A separate normalized delivery receipt proves the externally visible delivery outcome; this state transition does not itself execute delivery.", "lifecycle_scope": "DELIVERY", "initial": false, "terminal": false},
    {"state_id": "CLOSED", "label": "Closed", "meaning": "The job is administratively complete with required delivery and counterparty-status evidence recorded.", "lifecycle_scope": "DELIVERY", "initial": false, "terminal": true},
    {"state_id": "REJECTED", "label": "Rejected", "meaning": "The opportunity or reviewed work was rejected with an attributable reason.", "lifecycle_scope": "EXCEPTION", "initial": false, "terminal": true},
    {"state_id": "CANCELLED", "label": "Cancelled", "meaning": "The job was intentionally stopped with a reason and any required compensation recorded.", "lifecycle_scope": "EXCEPTION", "initial": false, "terminal": true}
