{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aigc.local/schemas/identity_scope_authorization_kernel.schema.json",
  "title": "AIGC Identity Scope Authorization Kernel v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["request", "policy"],
  "properties": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision_id", "revision", "actor_reference", "tenant_id", "project_id", "session", "action", "scopes", "assurance_level", "resource", "evidence_ids"],
      "properties": {
        "decision_id": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 7},
        "actor_reference": {"$ref": "eiap_shared_contracts.schema.json#/$defs/actorReferencePayload"},
        "approval_reference": {"$ref": "eiap_shared_contracts.schema.json#/$defs/approvalReferencePayload"},
        "tenant_id": {"type": "string", "minLength": 1},
        "project_id": {"type": "string", "minLength": 1},
        "revocation_id": {"type": ["string", "null"]},
        "session": {
          "type": "object",
          "additionalProperties": false,
          "required": ["session_id", "expires_at", "revoked"],
          "properties": {
            "session_id": {"type": "string", "minLength": 1},
            "expires_at": {"type": "string", "format": "date-time"},
            "revoked": {"type": "boolean"}
          }
        },
        "action": {"type": "string", "minLength": 1},
        "scopes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "assurance_level": {"type": "integer", "minimum": 0, "maximum": 4},
        "resource": {
          "type": "object",
          "additionalProperties": false,
          "required": ["resource_id", "tenant_id", "project_id", "sensitivity"],
          "properties": {
            "resource_id": {"type": "string", "minLength": 1},
            "tenant_id": {"type": "string", "minLength": 1},
            "project_id": {"type": "string", "minLength": 1},
            "sensitivity": {"enum": ["public", "internal", "confidential", "restricted"]}
          }
        },
        "evidence_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_id", "allowed_actions", "granted_scopes", "minimum_assurance_level", "permitted_sensitivity", "revoked_ids", "human_approval_required"],
      "properties": {
        "policy_id": {"type": "string", "minLength": 1},
        "allowed_actions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "granted_scopes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "minimum_assurance_level": {"type": "integer", "minimum": 0, "maximum": 4},
        "permitted_sensitivity": {"type": "array", "uniqueItems": true, "items": {"enum": ["public", "internal", "confidential", "restricted"]}},
        "revoked_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "human_approval_required": {"type": "boolean"}
      }
    }
  }
}
