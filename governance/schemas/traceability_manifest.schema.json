{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aigc.local/schemas/traceability_manifest.schema.json",
  "title": "AIGC Constitutional Traceability Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_id",
    "revision",
    "affected_articles",
    "contracts_changed",
    "risks",
    "expected_measurable_delta",
    "test_plan",
    "evidence_plan",
    "rollback_boundary",
    "data_classification",
    "jurisdiction_classification",
    "human_approval_requirements",
    "exceptions_or_waivers"
  ],
  "properties": {
    "manifest_id": {"type": "string", "pattern": "^AIGC-TRACE-[A-Z0-9-]+$"},
    "revision": {"type": "string", "minLength": 7},
    "affected_articles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["article_id", "compliance_state", "rationale"],
        "properties": {
          "article_id": {"type": "string", "pattern": "^AEC-[IVXLCDM]+$"},
          "compliance_state": {
            "enum": ["conformant", "not_applicable", "exception_requested", "nonconformant_blocking"]
          },
          "rationale": {"type": "string", "minLength": 1}
        }
      }
    },
    "contracts_changed": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "risks": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "expected_measurable_delta": {"type": "object"},
    "test_plan": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "evidence_plan": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "rollback_boundary": {"type": "string", "minLength": 1},
    "data_classification": {"enum": ["public", "internal", "confidential", "restricted", "critical"]},
    "jurisdiction_classification": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "human_approval_requirements": {"type": "array", "items": {"type": "string"}},
    "exceptions_or_waivers": {"type": "array", "items": {"type": "string"}},
    "external_action_performed": {"const": false}
  }
}
