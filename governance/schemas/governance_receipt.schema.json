{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://aigc.local/schemas/governance_receipt.schema.json",
  "type":"object",
  "additionalProperties":false,
  "required":["receipt_id","receipt_type","constitution_id","constitution_version","revision","result","reason_codes","evidence_references","review_path","operator_ratification","generated_at","external_action_performed"],
  "properties":{
    "receipt_id":{"type":"string","pattern":"^AIGC-GOV-RECEIPT-[A-Za-z0-9_-]+$"},
    "receipt_type":{"enum":["constitution_gate","amendment_decision","waiver_decision","ratification","post_merge_verification"]},
    "constitution_id":{"const":"AEC-001"},
    "constitution_version":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "revision":{"type":"string","minLength":7},
    "result":{"enum":["pass","pass_with_observations","fail","insufficient_evidence"]},
    "reason_codes":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},
    "evidence_references":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "review_path":{"enum":["automated_verification","solo_operator_alternative_assurance","independent_human_review","constitutional_council_review"]},
    "operator_ratification":{"type":"boolean"},
    "generated_at":{"type":"string","format":"date-time"},
    "external_action_performed":{"const":false}
  }
}
