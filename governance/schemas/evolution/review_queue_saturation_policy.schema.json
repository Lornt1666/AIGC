    "automatic_mutation_allowed": {
      "const": false
    },
    "diagnostic_correction_allowed_when_saturated": {
      "const": true
    },
    "evidence_refresh_allowed_when_saturated": {
      "const": true
    },
    "existing_critical_train_correction_allowed_when_saturated": {
      "const": true
    },
    "external_action_performed": {
      "const": false
    },
    "maximum_open_critical_path_items": {
      "minimum": 1,
      "type": "integer"
    },
    "maximum_open_review_trains": {
      "minimum": 1,
      "type": "integer"
    },
    "new_independent_implementation_train_allowed_when_saturated": {
      "const": false
