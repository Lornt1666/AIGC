{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aigc.local/governance/schemas/ci/ci_dependency_review_receipt.schema.json",
  "title": "AIGC CI Dependency Review Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "created_at",
    "source_revision",
    "evidence_class",
    "manifest_id",
    "manifest_version",
    "manifest_path",
    "manifest_sha256",
    "workflow_root",
    "workflow_files",
    "observed_actions",
    "observed_reference_count",
    "mismatches",
    "validation_conclusion",
    "operator_review_required",
    "automatic_merge_allowed",
    "external_action_performed"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "receipt_id": {
      "type": "string",
      "pattern": "^AIGC-CI-DEPENDENCY-REVIEW-[0-9A-F]{16}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "evidence_class": {
      "const": "ci_dependency_topology_review"
    },
    "manifest_id": {
      "const": "AIGC-CI-ACTION-DEPENDENCIES-001"
    },
    "manifest_version": {
      "const": "1.0.0"
    },
    "manifest_path": {
      "const": "governance/ci/ci_action_dependency_manifest_v1.json"
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "workflow_root": {
      "const": ".github/workflows"
    },
    "workflow_files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^\\.github/workflows/.+\\.ya?ml$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "observed_actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action_repository",
          "approved_revision",
          "observed_revisions",
          "observed_occurrences",
          "workflow_paths"
        ],
        "properties": {
          "action_repository": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+(?:/.+)?$"
          },
          "approved_revision": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{40}$"
          },
          "observed_revisions": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "observed_occurrences": {
            "type": "integer",
            "minimum": 1
          },
          "workflow_paths": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^\\.github/workflows/.+\\.ya?ml$"
            }
          }
        }
      }
    },
    "observed_reference_count": {
      "type": "integer",
      "minimum": 1
    },
    "mismatches": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "validation_conclusion": {
      "enum": [
        "PASS",
        "FAIL"
      ]
    },
    "operator_review_required": {
      "const": true
    },
    "automatic_merge_allowed": {
      "const": false
    },
    "external_action_performed": {
      "const": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "validation_conclusion": {
            "const": "PASS"
          }
        }
      },
      "then": {
        "properties": {
          "mismatches": {
            "maxItems": 0
          }
        }
      },
      "else": {
        "properties": {
          "mismatches": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
