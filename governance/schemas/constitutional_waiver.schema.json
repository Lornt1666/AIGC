{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://aigc.local/schemas/constitutional_waiver.schema.json",
  "type":"object",
  "additionalProperties":false,
  "required":["waiver_id","article_ids","scope","owner","risk_statement","mitigations","issued_at","expires_at","revocable","status","approval_reference","exact_revision"],
  "properties":{
    "waiver_id":{"type":"string","pattern":"^AEC-WAIVER-[0-9]{4,}$"},
    "article_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^AEC-[IVXLCDM]+$"}},
    "scope":{"type":"string","minLength":10},
    "owner":{"type":"string","minLength":1},
    "risk_statement":{"type":"string","minLength":20},
    "mitigations":{"type":"array","minItems":1,"items":{"type":"string","minLength":5}},
    "issued_at":{"type":"string","format":"date-time"},
    "expires_at":{"type":"string","format":"date-time"},
    "revocable":{"const":true},
    "status":{"enum":["proposed","active","revoked","expired","rejected"]},
    "approval_reference":{"type":"string","minLength":1},
    "exact_revision":{"type":"string","minLength":7}
  }
}
