{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://aigc.local/schemas/constitutional_amendment.schema.json",
  "type":"object",
  "additionalProperties":false,
  "required":["amendment_id","constitution_id","from_version","to_version","affected_articles","rationale","risk_analysis","compatibility_assessment","migration_plan","rollback_plan","review_path","operator_ratification","exact_revision","status"],
  "properties":{
    "amendment_id":{"type":"string","pattern":"^AEC-AMEND-[0-9]{4,}$"},
    "constitution_id":{"const":"AEC-001"},
    "from_version":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "to_version":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "affected_articles":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^AEC-[IVXLCDM]+$"}},
    "rationale":{"type":"string","minLength":20},
    "risk_analysis":{"type":"array","minItems":1,"items":{"type":"string","minLength":5}},
    "compatibility_assessment":{"type":"string","minLength":10},
    "migration_plan":{"type":"string","minLength":10},
    "rollback_plan":{"type":"string","minLength":10},
    "review_path":{"enum":["independent_human_review","constitutional_council_review"]},
    "operator_ratification":{"type":"boolean"},
    "exact_revision":{"type":"string","minLength":7},
    "status":{"enum":["proposed","approved","rejected","withdrawn","superseded"]}
  }
}
