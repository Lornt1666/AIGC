{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aigc.local/schemas/identity/access_policy.schema.json",
  "title": "AIGC Subject-Bound Access Policy v1.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["policy_id", "policy_revision", "subject_selectors", "tenant_id", "project_selectors", "allowed_roles", "allowed_actions", "granted_scopes", "permitted_purposes", "minimum_assurance", "permitted_sensitivity", "approval_rules", "obligations", "revoked"],
  "properties": {
    "policy_id": {"type": "string", "minLength": 1},
    "policy_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "subject_selectors": {
      "type": "object",
      "additionalProperties": false,
      "required": ["principal_ids", "role_ids"],
      "properties": {
        "principal_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "role_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "tenant_id": {"type": "string", "minLength": 1},
    "project_selectors": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "allowed_roles": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "allowed_actions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "granted_scopes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "permitted_purposes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "minimum_assurance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ial", "aal", "fal", "evidence_maturity"],
      "properties": {
        "ial": {"enum": ["IAL0", "IAL1", "IAL2", "IAL3"]},
        "aal": {"enum": ["AAL0", "AAL1", "AAL2", "AAL3"]},
        "fal": {"enum": ["FAL0", "FAL1", "FAL2", "FAL3"]},
        "evidence_maturity": {"enum": ["EA0_CLAIMED", "EA1_SCHEMA_VALID", "EA2_SEMANTICALLY_TESTED", "EA3_CI_EXECUTED", "EA4_STAGING_OBSERVED", "EA5_PRODUCTION_OBSERVED"]}
      }
    },
    "permitted_sensitivity": {"type": "array", "uniqueItems": true, "items": {"enum": ["public", "internal", "confidential", "restricted", "critical"]}},
    "approval_rules": {"type": "array", "items": {"type": "object"}},
    "obligations": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "revoked": {"type": "boolean"}
  }
}