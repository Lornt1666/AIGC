{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aigc.local/governance/schemas/jobs/job_state_compatibility_map.schema.json",
  "title": "AIGC Job State Compatibility Map",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "map_id",
    "version",
    "canonical_contract_id",
    "canonical_contract_version",
    "source_contracts",
    "unresolved_conflicts",
    "operator_review_required",
    "external_action_performed"
  ],
  "properties": {
    "map_id": {"type": "string", "pattern": "^[A-Z0-9-]+$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "canonical_contract_id": {"type": "string", "pattern": "^[A-Z0-9-]+$"},
    "canonical_contract_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "source_contracts": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/sourceContract"}
    },
    "unresolved_conflicts": {
      "type": "array",
      "items": {"$ref": "#/$defs/conflict"}
    },
    "operator_review_required": {"const": true},
    "external_action_performed": {"const": false}
  },
  "$defs": {
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_state",
        "target_state",
        "status",
        "rationale",
        "operator_decision_required"
      ],
      "properties": {
        "source_state": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
        "target_state": {"type": ["string", "null"], "pattern": "^[A-Z][A-Z0-9_]*$"},
        "status": {"enum": ["EXACT", "SEMANTIC_RENAME", "TRANSITION_EXPANSION_REQUIRED", "CONFLICTING", "UNSUPPORTED"]},
        "rationale": {"type": "string", "minLength": 1},
        "operator_decision_required": {"type": "boolean"}
      }
    },
    "sourceContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_contract_id", "source_version", "mappings"],
      "properties": {
        "source_contract_id": {"type": "string", "pattern": "^[A-Z0-9-]+$"},
        "source_version": {"type": "string", "minLength": 1},
        "mappings": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/mapping"}
        }
      }
    },
    "conflict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["conflict_id", "severity", "summary", "required_resolution"],
      "properties": {
        "conflict_id": {"type": "string", "pattern": "^[A-Z0-9_]+$"},
        "severity": {"enum": ["ADVISORY", "MATERIAL", "BLOCKING"]},
        "summary": {"type": "string", "minLength": 1},
        "required_resolution": {"type": "string", "minLength": 1}
      }
    }
  }
}
